# Endpoint that receives inquiry form POST submissions.
# Set to /api/inquire once RESEND_API_KEY is configured and the domain is verified in Resend.
# When unset, the form falls back to phone-only mode and shows a call prompt.
PUBLIC_INQUIRY_ENDPOINT=

# Resend API key for outbound email delivery via src/pages/api/inquire.ts.
# Create at resend.com → API Keys after verifying sagetherapycenter.com as a sending domain.
RESEND_API_KEY=

# Google Places API key used by scripts/fetch-reviews.ts to refresh google-reviews.json.
# Not required for the site to build or run — only needed when refreshing review data.
GOOGLE_PLACES_API_KEY=
