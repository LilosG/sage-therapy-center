---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import CTASection from '../components/sections/CTASection.astro';
import { site } from '../data/site';
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'city-services'>;
}

const { entry } = Astro.props;
const city = await getEntry(entry.data.city);
const service = await getEntry(entry.data.service);
const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: city.data.name, url: `/${city.data.slug}/` },
  { name: service.data.title, url: `/${city.data.slug}/${service.data.slug}/` },
];
---

<BaseLayout title={`${service.data.title} in ${city.data.name}`} description={service.data.description}>
  <PageHero eyebrow={city.data.name} title={`${service.data.title} in ${city.data.name}, CA`} breadcrumbItems={breadcrumbItems} />
  <slot />
  {entry.data.faq && entry.data.faq.length > 0 && (
    <FAQAccordion heading={`${service.data.title} in ${city.data.name}: FAQs`} items={entry.data.faq} />
  )}
  <!-- Every city/service page is a money page per Build Spec link quotas —
       structural here (guaranteed by the layout), same fix pattern as
       CityLayout/Footer. -->
  <CTASection
    heading={`Ready to schedule ${service.data.title.toLowerCase()} in ${city.data.name}?`}
    subhead="Request a session to discuss fit and availability."
    ctaLabel="Schedule a Session"
    ctaHref="/schedule-a-session/"
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
  />
</BaseLayout>
