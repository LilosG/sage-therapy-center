---
import InteriorPageLayout from './InteriorPageLayout.astro';
import ReassuranceGrid from '../components/sections/ReassuranceGrid.astro';
import MeetKristin from '../components/sections/MeetKristin.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import ReviewsSection from '../components/sections/ReviewsSection.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import ModalityBadges from '../components/sections/ModalityBadges.astro';
import LocationContext from '../components/sections/LocationContext.astro';
import { cityServiceBreadcrumbs } from '../lib/breadcrumbs';
import { withFallbackFaqs } from '../lib/faq';
import { practitioner } from '../data/practitioner';
import { getEntry } from 'astro:content';
import kristinPhoto from '../assets/images/kristin-moorehead-malley.webp';
import googleReviews from '../data/google-reviews.json';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'city-services'>;
}

const { entry } = Astro.props;
const city = await getEntry(entry.data.city);
const service = await getEntry(entry.data.service);
const routeSlug = entry.data.slugOverride ?? service.data.slug;
const breadcrumbItems = cityServiceBreadcrumbs(city.data.name, city.data.slug, service.data.title, routeSlug);
const faqItems = await withFallbackFaqs(entry.data.faq);

const reassuranceItems = [
  {
    title: 'You can begin without a diagnosis',
    body: `You do not need a formal diagnosis or a perfectly defined goal before starting ${service.data.title.toLowerCase()}.`,
    icon: 'lucide:check-circle',
  },
  {
    title: city.data.hasOffice ? `In-person in ${city.data.name}` : `Serving ${city.data.name}`,
    body: city.data.hasOffice
      ? `Sessions are available at the Carlsbad office, with telehealth available across California.`
      : `Work with Kristin from the Carlsbad office or by telehealth anywhere in California.`,
    icon: 'lucide:map-pin',
  },
  {
    title: 'Therapy tailored to the person',
    body: 'Kristin may draw from several therapeutic approaches depending on what is most relevant to the work.',
    icon: 'lucide:layers-3',
  },
];
---

<InteriorPageLayout
  title={`${service.data.title} in ${city.data.name}`}
  description={service.data.description}
  eyebrow={`${city.data.name} Therapy`}
  heroTitle={`${service.data.title} in ${city.data.name}, CA`}
  heroDescription={service.data.description}
  breadcrumbItems={breadcrumbItems}
  ctaHeading={`Ready to explore ${service.data.title.toLowerCase()} in ${city.data.name}?`}
>
  <ReassuranceGrid heading="A clear, supportive place to start" items={reassuranceItems} columns={3} />

  <!-- Unique service + city editorial content and related local links come from the route. -->
  <slot />

  <MeetKristin
    name={practitioner.name}
    credential={practitioner.credential}
    bio={practitioner.bio}
    modalities={[]}
    ctaLabel={practitioner.ctaLabel}
    ctaHref={practitioner.ctaHref}
    image={kristinPhoto}
  />

  <ModalityBadges modalities={practitioner.modalities} heading="Approaches Kristin may draw on" />

  <ProcessSteps
    eyebrow="What To Expect"
    heading={`What ${service.data.title.toLowerCase()} may look like`}
    steps={[
      { title: 'Reach out', body: 'Request a session to discuss fit, availability, and what is bringing you in.' },
      {
        title: 'First session',
        body: 'Begin exploring the concerns, patterns, or questions that feel most important right now.',
      },
      { title: 'Ongoing work', body: 'Continue at a pace and with an approach shaped around your needs and goals.' },
    ]}
  />

  <LocationContext cityName={city.data.name} hasOffice={city.data.hasOffice} neighborhoods={city.data.neighborhoods} />

  <ReviewsSection
    rating={googleReviews.rating}
    reviewCount={googleReviews.userRatingCount}
    reviews={googleReviews.reviews}
    placeUrl={`https://www.google.com/maps/place/?q=place_id:${googleReviews.placeId}`}
    lastUpdated={googleReviews.fetchedAt}
  />

  {faqItems.length > 0 && <FAQAccordion heading={`${service.data.title} in ${city.data.name}: common questions`} items={faqItems} background="surface" />}
</InteriorPageLayout>
