---
import BaseLayout from './BaseLayout.astro';
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'city-services'>;
}

const { entry } = Astro.props;
const city = await getEntry(entry.data.city);
const service = await getEntry(entry.data.service);
---

<BaseLayout title={`${service.data.title} in ${city.data.name}`} description={service.data.description}>
  <nav aria-label="breadcrumb">
    <!-- CONFIRM: breadcrumbs stub. Full trail (Home / {city.data.name} / {service.data.title})
         is a Wave 1 concern per the SEO doc's internal link plan, not built here. -->
  </nav>
  <slot />
</BaseLayout>
