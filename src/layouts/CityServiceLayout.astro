---
import InteriorPageLayout from './InteriorPageLayout.astro';
import ReassuranceGrid from '../components/sections/ReassuranceGrid.astro';
import RecognitionBand from '../components/sections/RecognitionBand.astro';
import OverviewFeature from '../components/sections/OverviewFeature.astro';
import TopicMatrix from '../components/sections/TopicMatrix.astro';
import TherapistApproachSection from '../components/sections/TherapistApproachSection.astro';
import DecisionSection from '../components/sections/DecisionSection.astro';
import RelatedSupportStrip from '../components/sections/RelatedSupportStrip.astro';
import MeetKristin from '../components/sections/MeetKristin.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import ReviewsSection from '../components/sections/ReviewsSection.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import LocationContext from '../components/sections/LocationContext.astro';
import InquiryFormSection from '../components/sections/InquiryFormSection.astro';
import SchemaOrg from '../components/seo/SchemaOrg.astro';
import { absoluteBreadcrumbs, cityServiceBreadcrumbs } from '../lib/breadcrumbs';
import { withFallbackFaqs } from '../lib/faq';
import { canonicalUrl, cityServiceUrl } from '../lib/routes';
import { practitioner } from '../data/practitioner';
import { getCityServiceHero, getHeroImageAlt } from '../data/pageImages';
import { getEntry } from 'astro:content';
import kristinPhoto from '../assets/images/kristin-moorehead-malley.webp';
import googleReviews from '../data/google-reviews.json';
import type { CollectionEntry } from 'astro:content';

interface RelatedLink {
  title: string;
  href: string;
}

interface Props {
  entry: CollectionEntry<'city-services'>;
  relatedLinks?: RelatedLink[];
}

const { entry, relatedLinks = [] } = Astro.props;
const city = await getEntry(entry.data.city);
const service = await getEntry(entry.data.service);
const routeSlug = entry.data.slugOverride ?? service.data.slug;
const breadcrumbItems = cityServiceBreadcrumbs(city.data.name, city.data.slug, service.data.title, routeSlug);
const schemaBreadcrumbs = absoluteBreadcrumbs(breadcrumbItems);
const pageUrl = canonicalUrl(cityServiceUrl(city.data.slug, routeSlug));
const faqItems = await withFallbackFaqs(entry.data.faq);
const heroImage = getCityServiceHero(city.data.slug, service.data.slug);
const heroTitle = city.data.hasOffice
  ? `${service.data.title} in ${city.data.name}, CA`
  : `${service.data.title} for ${city.data.name}, CA`;
const metaTitle = `${heroTitle} | S.A.G.E. Therapy Center`;
const metaDescription = city.data.hasOffice
  ? `${service.data.title} in ${city.data.name}, CA with Kristin Moorehead-Malley, LMFT, at S.A.G.E. Therapy Center. Request a session to discuss fit and availability.`
  : `${service.data.title} for ${city.data.name}, CA clients with Kristin Moorehead-Malley, LMFT, from the Carlsbad office or by telehealth across California.`;
const heroDescription = city.data.hasOffice
  ? `${service.data.title} with Kristin Moorehead-Malley, LMFT, with in-person sessions at S.A.G.E.'s Carlsbad office and telehealth across California.`
  : `${service.data.title} for ${city.data.name} clients with Kristin Moorehead-Malley, LMFT, from the Carlsbad office or by telehealth across California.`;
const inquiryHeading = city.data.hasOffice
  ? `Ready to explore ${service.data.title.toLowerCase()} in ${city.data.name}?`
  : `Ready to explore ${service.data.title.toLowerCase()} as a ${city.data.name} client?`;
const faqHeading = city.data.hasOffice
  ? `${service.data.title} in ${city.data.name}: common questions`
  : `${service.data.title} for ${city.data.name} clients: common questions`;

const entryHasStructuredContent = Boolean(entry.data.recognition?.length && entry.data.overview && entry.data.topics);
const recognition = entry.data.recognition ?? service.data.recognition;
const topics = entry.data.topics ?? service.data.topics;
const approach = entry.data.approach ?? service.data.approach;
const decisionItems = entry.data.decisionItems ?? service.data.decisionItems;
const hasStructuredShell = Boolean(recognition?.length && topics);
const localServicePhrase = city.data.hasOffice
  ? `${service.data.title.toLowerCase()} in ${city.data.name}`
  : `${service.data.title.toLowerCase()} for ${city.data.name} clients`;
const recognitionHeading = city.data.hasOffice
  ? `${service.data.title} in ${city.data.name} may be worth exploring if...`
  : `${service.data.title} for ${city.data.name} clients may be worth exploring if...`;
const inheritedTopicsHeading = city.data.hasOffice
  ? `Concerns people bring to ${service.data.title.toLowerCase()} in ${city.data.name}`
  : `Common reasons ${city.data.name} clients seek ${service.data.title.toLowerCase()}`;
const topicsHeading = entry.data.topics?.heading ?? inheritedTopicsHeading;
const approachHeading = entry.data.approach?.heading ?? `How Kristin approaches ${localServicePhrase}`;
const approachEyebrow = entry.data.approach?.eyebrow ?? (city.data.hasOffice ? `${service.data.title} in ${city.data.name}` : `${service.data.title} for ${city.data.name}`);
const processHeading = `What to expect from ${localServicePhrase}`;

const reassuranceItems = [
  {
    title: 'You can begin without a diagnosis',
    body: `You do not need a formal diagnosis or a perfectly defined goal before starting ${service.data.title.toLowerCase()}.`,
    icon: 'lucide:check-circle',
  },
  {
    title: city.data.hasOffice ? `In-person in ${city.data.name}` : `Serving ${city.data.name}`,
    body: city.data.hasOffice
      ? 'Sessions are available at the Carlsbad office, with telehealth available across California.'
      : 'Work with Kristin from the Carlsbad office or by telehealth anywhere in California.',
    icon: 'lucide:map-pin',
  },
  {
    title: 'Therapy tailored to the person',
    body: 'Kristin may draw from several therapeutic approaches depending on what is most relevant to the work.',
    icon: 'lucide:layers-3',
  },
];
---

<InteriorPageLayout
  title={metaTitle}
  description={metaDescription}
  eyebrow={city.data.hasOffice ? `${city.data.name} Therapy` : `Serving ${city.data.name}`}
  heroTitle={heroTitle}
  heroDescription={heroDescription}
  heroImage={heroImage}
  heroImageAlt={getHeroImageAlt(heroImage)}
  heroCtaHref="#request-session"
  breadcrumbItems={breadcrumbItems}
  ctaHeading={inquiryHeading}
  showFinalCta={false}
>
  {
    entryHasStructuredContent ? (
      <Fragment>
        <RecognitionBand
          eyebrow={city.data.hasOffice ? `${service.data.title} in ${city.data.name}` : `${service.data.title} for ${city.data.name}`}
          heading={recognitionHeading}
          items={recognition!}
        />
        <OverviewFeature
          eyebrow={entry.data.overview!.eyebrow}
          heading={entry.data.overview!.heading}
          paragraphs={entry.data.overview!.paragraphs}
          detailEyebrow={city.data.hasOffice ? 'Local Practice' : 'Session Access'}
          detailTitle={city.data.hasOffice ? `Based here in ${city.data.name}` : `Serving ${city.data.name} from Carlsbad`}
          detailItems={
            city.data.hasOffice
              ? ['In-person sessions at the Avenida Encinas office', 'Telehealth available across California', 'Request a session to discuss fit and availability']
              : ['In-person sessions at the Carlsbad office', `Serving clients from ${city.data.name}`, 'Telehealth available across California']
          }
        />
        <TopicMatrix
          eyebrow={topics!.eyebrow}
          heading={topicsHeading}
          intro={topics!.intro}
          items={topics!.items}
        />
      </Fragment>
    ) : hasStructuredShell ? (
      <Fragment>
        <RecognitionBand
          eyebrow={city.data.hasOffice ? `${service.data.title} in ${city.data.name}` : `${service.data.title} for ${city.data.name}`}
          heading={recognitionHeading}
          items={recognition!}
        />
        <slot />
        <TopicMatrix
          eyebrow={topics!.eyebrow}
          heading={topicsHeading}
          intro={topics!.intro}
          items={topics!.items}
        />
      </Fragment>
    ) : (
      <Fragment>
        <ReassuranceGrid heading={`${heroTitle}: a clear place to start`} items={reassuranceItems} columns={3} />
        <slot />
      </Fragment>
    )
  }

  {
    approach ? (
      <TherapistApproachSection
        name={practitioner.name}
        credential={practitioner.credential}
        bio={practitioner.bio}
        ctaLabel={practitioner.ctaLabel}
        ctaHref={practitioner.ctaHref}
        image={kristinPhoto}
        approachEyebrow={approachEyebrow}
        approachHeading={approachHeading}
        approachBody={approach.body}
        modalities={approach.modalities}
      />
    ) : (
      <MeetKristin
        name={practitioner.name}
        credential={practitioner.credential}
        bio={practitioner.bio}
        modalities={[]}
        ctaLabel={practitioner.ctaLabel}
        ctaHref={practitioner.ctaHref}
        image={kristinPhoto}
      />
    )
  }

  <ProcessSteps
    eyebrow={city.data.hasOffice ? `${service.data.title} in ${city.data.name}` : `${service.data.title} for ${city.data.name}`}
    heading={processHeading}
    steps={[
      { title: 'Reach out', body: 'Request a session to discuss fit, availability, and what is bringing you in.' },
      {
        title: 'First session',
        body: 'Begin exploring the concerns, patterns, or questions that feel most important right now.',
      },
      { title: 'Ongoing work', body: 'Continue at a pace and with an approach shaped around your needs and goals.' },
    ]}
  />

  <LocationContext cityName={city.data.name} hasOffice={city.data.hasOffice} neighborhoods={city.data.neighborhoods} />

  {
    decisionItems?.length && (
      <DecisionSection
        eyebrow={city.data.hasOffice ? `${service.data.title} in ${city.data.name}` : `${service.data.title} for ${city.data.name}`}
        heading={
          city.data.hasOffice
            ? `Starting ${service.data.title.toLowerCase()} in ${city.data.name}: what to know`
            : `Starting ${service.data.title.toLowerCase()} as a ${city.data.name} client: what to know`
        }
        items={decisionItems}
      />
    )
  }

  {
    relatedLinks.length > 0 && (
      <RelatedSupportStrip
        eyebrow={city.data.hasOffice ? `${city.data.name} Therapy Services` : `Therapy Services for ${city.data.name}`}
        heading={city.data.hasOffice ? `Related therapy services in ${city.data.name}` : `Other therapy services for ${city.data.name} clients`}
        links={relatedLinks}
      />
    )
  }

  <ReviewsSection
    rating={googleReviews.rating}
    reviewCount={googleReviews.userRatingCount}
    reviews={googleReviews.reviews}
    placeUrl={`https://www.google.com/maps/place/?q=place_id:${googleReviews.placeId}`}
    lastUpdated={googleReviews.fetchedAt}
  />

  {faqItems.length > 0 && <FAQAccordion heading={faqHeading} items={faqItems} background="surface" />}

  <InquiryFormSection
    context={`${service.data.title} — ${city.data.name}`}
    selectedService={service.data.title}
    heading={inquiryHeading}
    subhead={`Request a follow-up about fit, availability, and session options for ${city.data.name} clients without having to share your full story in a web form.`}
  />

  <SchemaOrg
    type="service"
    breadcrumb={schemaBreadcrumbs}
    service={{
      name: heroTitle,
      description: metaDescription,
      serviceType: service.data.primaryTarget,
      url: pageUrl,
      areaServed: city.data.name,
    }}
  />
  {faqItems.length > 0 && <SchemaOrg type="faqPage" faqItems={faqItems} />}
</InteriorPageLayout>
