---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/sections/Breadcrumbs.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'cities'>;
}

const { entry } = Astro.props;
const { name, primaryTarget, slug } = entry.data;
const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Areas We Serve', url: '/areas-we-serve/' },
  { name, url: `/${slug}/` },
];
---

<BaseLayout title={name} description={primaryTarget}>
  <Breadcrumbs items={breadcrumbItems} />
  <slot />
</BaseLayout>
