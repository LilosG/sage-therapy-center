---
import InteriorPageLayout from './InteriorPageLayout.astro';
import MeetKristin from '../components/sections/MeetKristin.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import ReviewsSection from '../components/sections/ReviewsSection.astro';
import PageFaqs from '../components/sections/PageFaqs.astro';
import VisitUs from '../components/sections/VisitUs.astro';
import AreasServed from '../components/sections/AreasServed.astro';
import InquiryFormSection from '../components/sections/InquiryFormSection.astro';
import SchemaOrg from '../components/seo/SchemaOrg.astro';
import { absoluteBreadcrumbs, cityBreadcrumbs } from '../lib/breadcrumbs';
import { buildCityFaqs } from '../lib/pageFaqs';
import { canonicalUrl, cityUrl } from '../lib/routes';
import { AREAS_WE_SERVE_URL } from '../data/nav';
import { practitioner } from '../data/practitioner';
import { getCityHero, getHeroImageAlt } from '../data/pageImages';
import { sortCoreServices } from '../data/serviceOrder';
import { getCollection } from 'astro:content';
import kristinPhoto from '../assets/images/kristin-moorehead-malley.webp';
import type { CollectionEntry } from 'astro:content';

interface Review {
  authorName: string;
  authorPhotoUrl: string | null;
  authorProfileUrl: string | null;
  rating: number | null;
  text: string;
  relativeTime: string;
  googleMapsUri: string | null;
}

interface NearbyCity {
  name: string;
  href: string;
}

interface Props {
  entry: CollectionEntry<'cities'>;
  showReviews?: boolean;
  rating?: number | null;
  reviewCount?: number | null;
  reviews?: Review[];
  placeUrl?: string;
  lastUpdated?: string | null;
  nearbyCities?: NearbyCity[];
}

const {
  entry,
  showReviews,
  rating,
  reviewCount,
  reviews,
  placeUrl,
  lastUpdated,
  nearbyCities = [],
} = Astro.props;
const { name, hasOffice, slug, faq, neighborhoods } = entry.data;
const breadcrumbItems = cityBreadcrumbs(name, slug);
const schemaBreadcrumbs = absoluteBreadcrumbs(breadcrumbItems);
const pageUrl = canonicalUrl(cityUrl(slug));
const allServices = await getCollection('services');
const coreServices = sortCoreServices(allServices.filter((service) => service.data.category === 'core'));
const faqItems = buildCityFaqs({
  cityName: name,
  hasOffice,
  existing: faq,
  serviceTitles: coreServices.map((service) => service.data.title),
});
const heroImage = getCityHero(slug);
const heroTitle = hasOffice ? `Therapist in ${name}, CA` : `Therapist serving ${name}, CA`;
const heroDescription = hasOffice
  ? `Individualized therapy with Kristin Moorehead-Malley, LMFT, with in-person sessions at the ${name} office and telehealth across California.`
  : `Individualized therapy for ${name} residents with Kristin Moorehead-Malley, LMFT, from the Carlsbad office or by telehealth across California.`;
const metaTitle = hasOffice
  ? `Therapist in ${name}, CA | S.A.G.E. Therapy Center`
  : `Therapist Serving ${name}, CA | S.A.G.E. Therapy Center`;
const metaDescription = hasOffice
  ? `Therapy in ${name}, CA with Kristin Moorehead-Malley, LMFT. In-person sessions at S.A.G.E. Therapy Center plus telehealth across California.`
  : `Therapy for ${name}, CA residents with Kristin Moorehead-Malley, LMFT, from the Carlsbad office or by telehealth across California.`;
const processHeading = hasOffice ? `What to expect from therapy in ${name}` : `What therapy looks like for ${name} clients`;
---

<InteriorPageLayout
  title={metaTitle}
  description={metaDescription}
  eyebrow={hasOffice ? 'Carlsbad Therapy Practice' : `Serving ${name}`}
  heroTitle={heroTitle}
  heroDescription={heroDescription}
  heroImage={heroImage}
  heroImageAlt={getHeroImageAlt(heroImage)}
  heroCtaHref="#request-session"
  breadcrumbItems={breadcrumbItems}
  ctaHeading={`Ready to explore therapy as a ${name} client?`}
  showFinalCta={false}
>
  <slot name="overview" />

  <!-- The route supplies the city's complete core-service directory here. -->
  <slot />

  {hasOffice && <VisitUs cityName={name} neighborhoods={neighborhoods} />}

  <MeetKristin
    name={practitioner.name}
    credential={practitioner.credential}
    bio={practitioner.bio}
    modalities={[]}
    ctaLabel={practitioner.ctaLabel}
    ctaHref={practitioner.ctaHref}
    image={kristinPhoto}
  />

  <ProcessSteps
    eyebrow={hasOffice ? `Therapy in ${name}` : `Therapy for ${name}`}
    heading={processHeading}
    steps={[
      { title: 'Reach out', body: 'Request a session to discuss fit, availability, and the kind of support you are looking for.' },
      {
        title: 'First session',
        body: 'Meet with Kristin and begin with what is bringing you in, without needing to have everything figured out first.',
      },
      { title: 'Ongoing sessions', body: 'Continue with an approach and pace that can evolve with your needs and goals.' },
    ]}
  />

  {
    showReviews && (
      <ReviewsSection
        rating={rating}
        reviewCount={reviewCount}
        reviews={reviews}
        placeUrl={placeUrl}
        lastUpdated={lastUpdated}
      />
    )
  }

  <PageFaqs heading={`${name} therapy: common questions`} items={faqItems} background="surface" />

  <InquiryFormSection
    context={`Therapy in ${name}`}
    heading={`Looking for therapy in ${name}? Start with a simple request.`}
    subhead="Share how you would like Kristin to reach you about fit, availability, and whether in-person or telehealth sessions make sense."
  />

  {
    nearbyCities.length > 0 && (
      <AreasServed
        eyebrow="Nearby Communities"
        heading={`Also serving communities near ${name}`}
        cities={nearbyCities}
        viewAllHref={AREAS_WE_SERVE_URL}
        variant="compact"
      />
    )
  }

  <SchemaOrg
    type="city"
    city={{ name, pageName: heroTitle, url: pageUrl, areaServed: name }}
    breadcrumb={schemaBreadcrumbs}
  />
</InteriorPageLayout>
