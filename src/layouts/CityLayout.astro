---
import InteriorPageLayout from './InteriorPageLayout.astro';
import VisitUs from '../components/sections/VisitUs.astro';
import AreasServed from '../components/sections/AreasServed.astro';
import { cityBreadcrumbs } from '../lib/breadcrumbs';
import { withFallbackFaqs } from '../lib/faq';
import { AREAS_WE_SERVE_URL } from '../data/nav';
import type { CollectionEntry } from 'astro:content';

interface Review {
  authorName: string;
  authorPhotoUrl: string | null;
  authorProfileUrl: string | null;
  rating: number | null;
  text: string;
  relativeTime: string;
  googleMapsUri: string | null;
}

interface NearbyCity {
  name: string;
  href: string;
}

interface Props {
  entry: CollectionEntry<'cities'>;
  showReviews?: boolean;
  rating?: number | null;
  reviewCount?: number | null;
  reviews?: Review[];
  placeUrl?: string;
  lastUpdated?: string | null;
  // Resolved by the page ([city]/index.astro) since resolving
  // nearbyCities references requires an async getEntries() call this
  // layout shouldn't own.
  nearbyCities?: NearbyCity[];
}

const {
  entry,
  showReviews,
  rating,
  reviewCount,
  reviews,
  placeUrl,
  lastUpdated,
  nearbyCities = [],
} = Astro.props;
const { name, hasOffice, primaryTarget, slug, faq, neighborhoods } = entry.data;
const breadcrumbItems = cityBreadcrumbs(name, slug);
const faqItems = await withFallbackFaqs(faq);

// primaryTarget (e.g. "therapist Carlsbad") is a raw SEO target phrase for
// the <meta description> — description prop below — never a
// human-readable sentence. The visible hero subtitle needs its own
// polished copy instead of leaking that keyword string onto the page.
const heroDescription = `Compassionate, evidence-based therapy tailored to your goals${hasOffice ? `, with in-person sessions in ${name}` : ` for ${name} residents`} and telehealth across California.`;

const reassuranceItems = [
  {
    title: 'A space without judgment',
    body: `Sessions meet you where you are, at a pace that fits your goals as a ${name} client.`,
    icon: 'lucide:check-circle',
  },
  {
    title: 'In-person and telehealth',
    body: hasOffice
      ? `In-person sessions at our Carlsbad office, convenient to ${name}, or telehealth statewide.`
      : `Telehealth sessions available to ${name} residents anywhere in California.`,
    icon: 'lucide:check-circle',
  },
  {
    title: 'An approach tailored to you',
    body: 'CBT, EMDR, psychodynamic, and attachment-based work, drawn on depending on what fits.',
    icon: 'lucide:check-circle',
  },
  {
    title: 'No pressure to have it figured out',
    body: 'There’s no requirement to have a diagnosis or a clear goal before reaching out.',
    icon: 'lucide:check-circle',
  },
];
---

<InteriorPageLayout
  title={name}
  description={primaryTarget}
  eyebrow={hasOffice ? 'Our Office' : 'Areas We Serve'}
  heroTitle={`Therapist in ${name}, CA`}
  heroDescription={heroDescription}
  breadcrumbItems={breadcrumbItems}
  reassuranceHeading={`Therapy tailored for ${name} residents`}
  reassuranceItems={reassuranceItems}
  faqHeading={`${name} FAQs`}
  faqItems={faqItems}
  showReviews={showReviews}
  rating={rating}
  reviewCount={reviewCount}
  reviews={reviews}
  placeUrl={placeUrl}
  lastUpdated={lastUpdated}
  ctaHeading={`Ready to schedule as a ${name} client?`}
>
  <slot />
  {
    hasOffice && (
      <Fragment slot="visit-us">
        <VisitUs cityName={name} neighborhoods={neighborhoods} />
      </Fragment>
    )
  }
  {
    nearbyCities.length > 0 && (
      <Fragment slot="areas-served">
        <AreasServed heading={`Other areas near ${name}`} cities={nearbyCities} viewAllHref={AREAS_WE_SERVE_URL} />
      </Fragment>
    )
  }
</InteriorPageLayout>
