---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import CTASection from '../components/sections/CTASection.astro';
import { site } from '../data/site';
import { SCHEDULE_URL } from '../data/nav';
import { cityBreadcrumbs } from '../lib/breadcrumbs';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'cities'>;
}

const { entry } = Astro.props;
const { name, hasOffice, primaryTarget, slug, faq, approvedCityServices } = entry.data;
// Section-rhythm (Wave 6, item 7): the page slot renders a ServiceGrid
// (background="secondary") only when this city has approved services.
// When it does, FAQ should sit on "background" to alternate against it;
// when it doesn't, FAQ directly follows the slot's plain background
// content, so it needs "secondary" itself.
const faqBackground = approvedCityServices.length > 0 ? 'background' : 'secondary';
const breadcrumbItems = cityBreadcrumbs(name, slug);
---

<BaseLayout title={name} description={primaryTarget}>
  <PageHero
    eyebrow={hasOffice ? 'Our Office' : 'Areas We Serve'}
    title={`Therapist in ${name}, CA`}
    breadcrumbItems={breadcrumbItems}
  />
  <slot />
  {faq && faq.length > 0 && <FAQAccordion heading={`${name} FAQs`} items={faq} background={faqBackground} />}
  <!-- Every city hub is a money page per Build Spec link quotas — the CTA
       is structural here (guaranteed by the layout) rather than left to
       each page to remember, same fix as the Wave 1 Footer bug. -->
  <CTASection
    heading={`Ready to schedule as a ${name} client?`}
    subhead="Request a session to discuss fit and availability."
    ctaLabel="Schedule a Session"
    ctaHref={SCHEDULE_URL}
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
  />
</BaseLayout>
