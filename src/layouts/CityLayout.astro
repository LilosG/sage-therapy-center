---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'cities'>;
}

const { entry } = Astro.props;
const { name, primaryTarget } = entry.data;
---

<BaseLayout title={name} description={primaryTarget}>
  <nav aria-label="breadcrumb">
    <!-- CONFIRM: breadcrumbs stub. Full trail (Home / Areas We Serve / {name})
         is a Wave 1 concern per the SEO doc's internal link plan, not built here. -->
  </nav>
  <slot />
</BaseLayout>
