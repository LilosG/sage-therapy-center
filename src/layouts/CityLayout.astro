---
import InteriorPageLayout from './InteriorPageLayout.astro';
import { cityBreadcrumbs } from '../lib/breadcrumbs';
import type { CollectionEntry } from 'astro:content';

interface Review {
  authorName: string;
  authorPhotoUrl: string | null;
  authorProfileUrl: string | null;
  rating: number | null;
  text: string;
  relativeTime: string;
  googleMapsUri: string | null;
}

interface Props {
  entry: CollectionEntry<'cities'>;
  showReviews?: boolean;
  rating?: number | null;
  reviewCount?: number | null;
  reviews?: Review[];
  placeUrl?: string;
  lastUpdated?: string | null;
}

const { entry, showReviews, rating, reviewCount, reviews, placeUrl, lastUpdated } = Astro.props;
const { name, hasOffice, primaryTarget, slug, faq, approvedCityServices } = entry.data;
// Section-rhythm (Wave 6, item 7): the page slot renders a ServiceGrid
// (background="secondary") only when this city has approved services.
// When it does, FAQ should sit on "background" to alternate against it;
// when it doesn't, FAQ directly follows the slot's plain background
// content, so it needs "secondary" itself.
const faqBackground = approvedCityServices.length > 0 ? 'background' : 'secondary';
const breadcrumbItems = cityBreadcrumbs(name, slug);
---

<InteriorPageLayout
  title={name}
  description={primaryTarget}
  eyebrow={hasOffice ? 'Our Office' : 'Areas We Serve'}
  heroTitle={`Therapist in ${name}, CA`}
  breadcrumbItems={breadcrumbItems}
  faqHeading={`${name} FAQs`}
  faqItems={faq}
  faqBackground={faqBackground}
  showReviews={showReviews}
  rating={rating}
  reviewCount={reviewCount}
  reviews={reviews}
  placeUrl={placeUrl}
  lastUpdated={lastUpdated}
  ctaHeading={`Ready to schedule as a ${name} client?`}
>
  <slot />
</InteriorPageLayout>
