---
import InteriorPageLayout from './InteriorPageLayout.astro';
import { cityBreadcrumbs } from '../lib/breadcrumbs';
import type { CollectionEntry } from 'astro:content';

interface Review {
  authorName: string;
  authorPhotoUrl: string | null;
  authorProfileUrl: string | null;
  rating: number | null;
  text: string;
  relativeTime: string;
  googleMapsUri: string | null;
}

interface Props {
  entry: CollectionEntry<'cities'>;
  showReviews?: boolean;
  rating?: number | null;
  reviewCount?: number | null;
  reviews?: Review[];
  placeUrl?: string;
  lastUpdated?: string | null;
}

const { entry, showReviews, rating, reviewCount, reviews, placeUrl, lastUpdated } = Astro.props;
const { name, hasOffice, primaryTarget, slug, faq, approvedCityServices } = entry.data;
// FAQ always directly follows ReviewsSection now (InteriorPageLayout
// renders Reviews immediately before FAQ), and ReviewsSection is always
// bg-secondary — so FAQ always needs 'background' to alternate against
// it. Previously this alternated against ServiceGrid instead (before the
// Reviews/FAQ reorder), which is no longer what's adjacent to FAQ.
const faqBackground = 'background';
const breadcrumbItems = cityBreadcrumbs(name, slug);
---

<InteriorPageLayout
  title={name}
  description={primaryTarget}
  eyebrow={hasOffice ? 'Our Office' : 'Areas We Serve'}
  heroTitle={`Therapist in ${name}, CA`}
  breadcrumbItems={breadcrumbItems}
  faqHeading={`${name} FAQs`}
  faqItems={faq}
  faqBackground={faqBackground}
  showReviews={showReviews}
  rating={rating}
  reviewCount={reviewCount}
  reviews={reviews}
  placeUrl={placeUrl}
  lastUpdated={lastUpdated}
  ctaHeading={`Ready to schedule as a ${name} client?`}
  showReassurance={true}
  showMeetKristin={true}
  showProcessSteps={true}
>
  <slot />
</InteriorPageLayout>
