---
import InteriorPageLayout from './InteriorPageLayout.astro';
import ReassuranceGrid from '../components/sections/ReassuranceGrid.astro';
import RecognitionBand from '../components/sections/RecognitionBand.astro';
import OverviewFeature from '../components/sections/OverviewFeature.astro';
import TopicMatrix from '../components/sections/TopicMatrix.astro';
import TherapistApproachSection from '../components/sections/TherapistApproachSection.astro';
import DecisionSection from '../components/sections/DecisionSection.astro';
import RelatedSupportStrip from '../components/sections/RelatedSupportStrip.astro';
import MeetKristin from '../components/sections/MeetKristin.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import ReviewsSection from '../components/sections/ReviewsSection.astro';
import PageFaqs from '../components/sections/PageFaqs.astro';
import AreasServed from '../components/sections/AreasServed.astro';
import InquiryFormSection from '../components/sections/InquiryFormSection.astro';
import SchemaOrg from '../components/seo/SchemaOrg.astro';
import { absoluteBreadcrumbs, serviceBreadcrumbs } from '../lib/breadcrumbs';
import { buildServiceFaqs } from '../lib/pageFaqs';
import { getCollection } from 'astro:content';
import { canonicalUrl, cityUrl, serviceUrl } from '../lib/routes';
import { AREAS_WE_SERVE_URL } from '../data/nav';
import { practitioner } from '../data/practitioner';
import { getServiceHero, getHeroImageAlt } from '../data/pageImages';
import { site } from '../data/site';
import kristinPhoto from '../assets/images/kristin-moorehead-malley.webp';
import googleReviews from '../data/google-reviews.json';
import type { CollectionEntry } from 'astro:content';

interface RelatedLink {
  title: string;
  href: string;
}

interface Props {
  entry: CollectionEntry<'services'>;
  relatedLinks?: RelatedLink[];
}

const { entry, relatedLinks = [] } = Astro.props;
const {
  title,
  description,
  slug,
  category,
  pageKind,
  primaryTarget,
  faq,
  recognition,
  overview,
  topics,
  approach,
  decisionItems,
} = entry.data;
const breadcrumbItems = serviceBreadcrumbs(title, slug);
const schemaBreadcrumbs = absoluteBreadcrumbs(breadcrumbItems);
const pageUrl = canonicalUrl(serviceUrl(slug));
const faqItems = buildServiceFaqs({ title, existing: faq, topics, approach });
const cities = await getCollection('cities');
const cityLinks = cities.map((c) => ({ name: c.data.name, href: cityUrl(c.data.slug) }));
const heroImage = getServiceHero(slug);
const localServiceTitle = `${title} in ${site.address.city}, ${site.address.region}`;
const metaTitle = `${localServiceTitle} | S.A.G.E. Therapy Center`;
const rawMetaDescription = `${description} Work with Kristin Moorehead-Malley, LMFT, in ${site.address.city} or by telehealth across California.`;
const metaDescription = rawMetaDescription.length > 155 ? rawMetaDescription.slice(0, 152) + '...' : rawMetaDescription;
const hasStructuredContent = Boolean(recognition?.length && overview && topics);

const heroEyebrow =
  pageKind === 'modality'
    ? `${site.address.city} Therapeutic Approach`
    : pageKind === 'relationship'
      ? `${site.address.city} Relationship Therapy`
      : pageKind === 'family'
        ? `${site.address.city} Family Therapy`
        : pageKind === 'adolescent'
          ? `${site.address.city} Teen Therapy`
          : category === 'concern-led'
            ? `${site.address.city} Therapy Support`
            : `${site.address.city} Therapy Service`;

const recognitionHeading =
  pageKind === 'modality'
    ? `${title} in ${site.address.city} may be worth exploring if...`
    : pageKind === 'relationship'
      ? `Couples consider ${title.toLowerCase()} in ${site.address.city} for different reasons`
      : pageKind === 'family'
        ? `Families in ${site.address.city} may look for ${title.toLowerCase()} when...`
        : pageKind === 'adolescent'
          ? `Teen counseling in ${site.address.city} may be helpful when...`
          : category === 'concern-led'
            ? `You may be looking for ${title.toLowerCase()} in ${site.address.city} if...`
            : `Adults consider ${title.toLowerCase()} in ${site.address.city} for different reasons`;

const overviewHeading =
  pageKind === 'relationship'
    ? `${title} in ${site.address.city} for communication, connection, and relationship concerns`
    : pageKind === 'family'
      ? `${title} in ${site.address.city} for families navigating conflict, change, and connection`
      : pageKind === 'adolescent'
        ? `${title} in ${site.address.city} for teens navigating stress, change, and emotional challenges`
        : pageKind === 'modality'
          ? `${title} in ${site.address.city} as part of an individualized therapy plan`
          : category === 'concern-led'
            ? `${title} in ${site.address.city} with individualized support from Kristin Moorehead-Malley, LMFT`
            : `${title} in ${site.address.city} for stress, change, relationships, and personal growth`;

const topicsHeading =
  pageKind === 'modality'
    ? `When ${title} may be relevant in therapy in ${site.address.city}`
    : `Concerns people bring to ${title.toLowerCase()} in ${site.address.city}`;
const approachHeading = `How Kristin approaches ${title.toLowerCase()} at S.A.G.E. Therapy Center in ${site.address.city}`;
const processHeading = `What to expect from ${title.toLowerCase()} in ${site.address.city}`;
const decisionHeading = `Starting ${title.toLowerCase()} in ${site.address.city}: what to know`;
const relatedHeading = `Related therapy services in ${site.address.city}`;
const faqHeading = `${title} in ${site.address.city}: common questions`;
const inquiryHeading = `Interested in ${title.toLowerCase()} in ${site.address.city}? Start with a simple request.`;
const areasHeading = `${title} for ${site.address.city} and nearby North County communities`;

const reassuranceItems = [
  {
    title: 'No diagnosis required',
    body: 'You do not need a formal diagnosis or a fully worked-out problem before reaching out.',
    icon: 'lucide:check-circle',
  },
  {
    title: 'A collaborative process',
    body: 'Sessions can begin with what feels most relevant now, rather than following a fixed script.',
    icon: 'lucide:message-circle',
  },
  {
    title: 'In person or telehealth',
    body: 'Meet at the Carlsbad office or by telehealth anywhere in California.',
    icon: 'lucide:map-pin',
  },
];
---

<InteriorPageLayout
  title={metaTitle}
  description={metaDescription}
  eyebrow={heroEyebrow}
  heroTitle={localServiceTitle}
  heroDescription={description}
  heroImage={heroImage}
  heroImageAlt={getHeroImageAlt(heroImage)}
  heroCtaHref="#request-session"
  breadcrumbItems={breadcrumbItems}
  ctaHeading={`Ready to talk about ${title.toLowerCase()} in ${site.address.city}?`}
  showFinalCta={false}
>
  {
    hasStructuredContent ? (
      <Fragment>
        <RecognitionBand
          eyebrow={`${title} in ${site.address.city}`}
          heading={recognitionHeading}
          items={recognition!}
        />
        <OverviewFeature
          eyebrow={overview!.eyebrow}
          heading={overviewHeading}
          paragraphs={overview!.paragraphs}
          detailEyebrow="Session Options"
          detailTitle={`${site.address.city} office + telehealth`}
          detailItems={[
            `In-person sessions in ${site.address.city}, California`,
            'Telehealth available across California',
            'Start with a conversation about fit and availability',
          ]}
        />
        <TopicMatrix
          eyebrow={topics!.eyebrow}
          heading={topicsHeading}
          intro={topics!.intro}
          items={topics!.items}
        />
      </Fragment>
    ) : (
      <Fragment>
        <ReassuranceGrid heading={`${title} in ${site.address.city}: a supportive place to begin`} items={reassuranceItems} columns={3} />
        <slot />
      </Fragment>
    )
  }

  {
    approach ? (
      <TherapistApproachSection
        name={practitioner.name}
        credential={practitioner.credential}
        bio={practitioner.bio}
        ctaLabel={practitioner.ctaLabel}
        ctaHref={practitioner.ctaHref}
        image={kristinPhoto}
        approachEyebrow={approach.eyebrow}
        approachHeading={approachHeading}
        approachBody={approach.body}
        modalities={approach.modalities}
      />
    ) : (
      <MeetKristin
        name={practitioner.name}
        credential={practitioner.credential}
        bio={practitioner.bio}
        modalities={[]}
        ctaLabel={practitioner.ctaLabel}
        ctaHref={practitioner.ctaHref}
        image={kristinPhoto}
      />
    )
  }

  <ProcessSteps
    eyebrow={`${title} in ${site.address.city}`}
    heading={processHeading}
    steps={[
      { title: 'Reach out', body: 'Request a session to discuss fit, availability, and what is bringing you in.' },
      { title: 'First session', body: 'Begin with the concerns, questions, or patterns that feel most important to understand.' },
      { title: 'Ongoing work', body: 'Continue with an approach and pace shaped around your needs and goals.' },
    ]}
  />

  {
    hasStructuredContent && decisionItems?.length && (
      <DecisionSection
        eyebrow={`${title} in ${site.address.city}`}
        heading={decisionHeading}
        items={decisionItems}
      />
    )
  }

  {
    hasStructuredContent && relatedLinks.length > 0 && (
      <RelatedSupportStrip eyebrow={`${site.address.city} Therapy Services`} heading={relatedHeading} links={relatedLinks} />
    )
  }

  <ReviewsSection
    rating={googleReviews.rating}
    reviewCount={googleReviews.userRatingCount}
    reviews={googleReviews.reviews}
    placeUrl={`https://www.google.com/maps/place/?q=place_id:${googleReviews.placeId}`}
    lastUpdated={googleReviews.fetchedAt}
  />

  <PageFaqs heading={faqHeading} items={faqItems} background="surface" />

  <InquiryFormSection
    context={`${title} in ${site.address.city}`}
    selectedService={title}
    heading={inquiryHeading}
    subhead={`Share how you would like Kristin to reach you about fit, availability, and session options at the ${site.address.city} office or by telehealth.`}
  />

  <AreasServed
    eyebrow={`${title} Service Area`}
    heading={areasHeading}
    cities={cityLinks}
    viewAllHref={AREAS_WE_SERVE_URL}
    variant="compact"
  />

  <SchemaOrg
    type="service"
    breadcrumb={schemaBreadcrumbs}
    service={{
      name: localServiceTitle,
      description: metaDescription,
      serviceType: primaryTarget,
      url: pageUrl,
      areaServed: site.address.city,
    }}
  />
  <SchemaOrg type="faqPage" faqItems={faqItems} />
</InteriorPageLayout>
