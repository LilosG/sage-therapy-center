---
import InteriorPageLayout from './InteriorPageLayout.astro';
import { serviceBreadcrumbs } from '../lib/breadcrumbs';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'services'>;
}

const { entry } = Astro.props;
const { title, description, slug, category, faq } = entry.data;
const breadcrumbItems = serviceBreadcrumbs(title, slug);
---

<InteriorPageLayout
  title={title}
  description={description}
  eyebrow={category === 'core' ? 'Core Service' : 'Concern-Led Service'}
  heroTitle={title}
  breadcrumbItems={breadcrumbItems}
  faqHeading="Frequently asked questions"
  faqItems={faq}
  faqBackground="secondary"
  ctaHeading={`Ready to talk about ${title.toLowerCase()}?`}
>
  <slot />
</InteriorPageLayout>
