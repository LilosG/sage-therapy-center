---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/sections/Breadcrumbs.astro';
import CTASection from '../components/sections/CTASection.astro';
import { site } from '../data/site';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'services'>;
}

const { entry } = Astro.props;
const { title, description, slug } = entry.data;
const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services/' },
  { name: title, url: `/services/${slug}/` },
];
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs items={breadcrumbItems} />
  <slot />
  <!-- Every service pillar is a money page per Build Spec link quotas —
       structural here (guaranteed by the layout), matching the
       CityLayout/CityServiceLayout/Footer fix pattern from prior waves. -->
  <CTASection
    heading={`Ready to talk about ${title.toLowerCase()}?`}
    subhead="Request a session to discuss fit and availability."
    ctaLabel="Schedule a Session"
    ctaHref="/schedule-a-session/"
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
  />
</BaseLayout>
