---
import InteriorPageLayout from './InteriorPageLayout.astro';
import AreasServed from '../components/sections/AreasServed.astro';
import ModalityBadges from '../components/sections/ModalityBadges.astro';
import { serviceBreadcrumbs } from '../lib/breadcrumbs';
import { withFallbackFaqs } from '../lib/faq';
import { getCollection } from 'astro:content';
import { cityUrl } from '../lib/routes';
import { AREAS_WE_SERVE_URL } from '../data/nav';
import { practitioner } from '../data/practitioner';
import googleReviews from '../data/google-reviews.json';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'services'>;
}

const { entry } = Astro.props;
const { title, description, slug, category, faq } = entry.data;
const breadcrumbItems = serviceBreadcrumbs(title, slug);
const faqItems = await withFallbackFaqs(faq);

// Service pages aren't scoped to one city, so "areas served" here is the
// full city roster rather than a nearby-cities subset (that's the city
// hub page's job).
const cities = await getCollection('cities');
const cityLinks = cities.map((c) => ({ name: c.data.name, href: cityUrl(c.data.slug) }));

const reassuranceItems = [
  {
    title: 'No diagnosis required',
    body: 'You don’t need a formal diagnosis or a fully worked-out problem to reach out.',
    icon: 'lucide:check-circle',
  },
  {
    title: 'A space without judgment',
    body: 'Sessions explore what you’re experiencing at a pace that fits you, not a script.',
    icon: 'lucide:check-circle',
  },
  {
    title: 'In-person or telehealth',
    body: 'Meet in person at the Carlsbad office, or by telehealth anywhere in California.',
    icon: 'lucide:check-circle',
  },
];
---

<InteriorPageLayout
  title={title}
  description={description}
  eyebrow={category === 'core' ? 'Core Service' : 'Concern-Led Service'}
  heroTitle={title}
  heroDescription={description}
  breadcrumbItems={breadcrumbItems}
  reassuranceHeading="You're in the right place if..."
  reassuranceItems={reassuranceItems}
  reassuranceColumns={3}
  faqHeading="Frequently asked questions"
  faqItems={faqItems}
  showReviews={true}
  rating={googleReviews.rating}
  reviewCount={googleReviews.userRatingCount}
  reviews={googleReviews.reviews}
  placeUrl={`https://www.google.com/maps/place/?q=place_id:${googleReviews.placeId}`}
  lastUpdated={googleReviews.fetchedAt}
  ctaHeading={`Ready to talk about ${title.toLowerCase()}?`}
>
  <slot />
  <ModalityBadges modalities={practitioner.modalities} />
  <Fragment slot="areas-served">
    <AreasServed heading="Areas we serve" cities={cityLinks} viewAllHref={AREAS_WE_SERVE_URL} />
  </Fragment>
</InteriorPageLayout>
