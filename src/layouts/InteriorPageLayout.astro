---
// Shared structural shell for interior pages. This component deliberately
// owns only the elements that are truly universal: metadata/base layout,
// page hero, trust strip, final conversion CTA, and the shared business
// schema node. Service, city, and city/service layouts own their own
// narrative section order so search intent can drive the funnel instead of
// forcing every page type through one generic sequence.
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import TrustStrip from '../components/sections/TrustStrip.astro';
import CTASection from '../components/sections/CTASection.astro';
import SchemaOrg from '../components/seo/SchemaOrg.astro';
import { site } from '../data/site';
import { SCHEDULE_URL } from '../data/nav';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  heroTitle: string;
  heroDescription?: string;
  heroTrustBadges?: string[];
  breadcrumbItems: BreadcrumbItem[];
  ctaHeading: string;
  ctaSubhead?: string;
}

const {
  title,
  description,
  eyebrow,
  heroTitle,
  heroDescription,
  heroTrustBadges,
  breadcrumbItems,
  ctaHeading,
  ctaSubhead = 'Request a session to discuss fit and availability.',
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <PageHero
    eyebrow={eyebrow}
    title={heroTitle}
    description={heroDescription}
    breadcrumbItems={breadcrumbItems}
    ctaLabel="Schedule a Session"
    ctaHref={SCHEDULE_URL}
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
    trustBadges={heroTrustBadges}
  />

  <TrustStrip />

  <slot />

  <CTASection
    heading={ctaHeading}
    subhead={ctaSubhead}
    ctaLabel="Schedule a Session"
    ctaHref={SCHEDULE_URL}
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
  />
</BaseLayout>

<SchemaOrg type="localBusiness" />
