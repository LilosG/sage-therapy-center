---
// Shared structural shell for interior pages. This component owns only
// universal concerns: metadata/base layout, the image-capable page hero,
// trust strip, and optional final CTA. Service/city layouts own their own
// page-specific schema so the business is not emitted as duplicate stub data.
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import TrustStrip from '../components/sections/TrustStrip.astro';
import CTASection from '../components/sections/CTASection.astro';
import { site } from '../data/site';
import { SCHEDULE_URL } from '../data/nav';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  heroTitle: string;
  heroDescription?: string;
  heroTrustBadges?: string[];
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  heroImagePosition?: string;
  heroCtaHref?: string;
  breadcrumbItems: BreadcrumbItem[];
  ctaHeading: string;
  ctaSubhead?: string;
  showFinalCta?: boolean;
}

const {
  title,
  description,
  eyebrow,
  heroTitle,
  heroDescription,
  heroTrustBadges,
  heroImage,
  heroImageAlt,
  heroImagePosition,
  heroCtaHref = '#request-session',
  breadcrumbItems,
  ctaHeading,
  ctaSubhead = 'Request a session to discuss fit and availability.',
  showFinalCta = true,
} = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage}>
  <PageHero
    eyebrow={eyebrow}
    title={heroTitle}
    description={heroDescription}
    breadcrumbItems={breadcrumbItems}
    ctaLabel="Schedule a Session"
    ctaHref={heroCtaHref}
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
    trustBadges={heroTrustBadges}
    image={heroImage}
    imageAlt={heroImageAlt}
    imagePosition={heroImagePosition}
  />

  <TrustStrip />

  <slot />

  {
    showFinalCta && (
      <CTASection
        heading={ctaHeading}
        subhead={ctaSubhead}
        ctaLabel="Schedule a Session"
        ctaHref={SCHEDULE_URL}
        phoneDisplay={site.phone.display}
        phoneHref={`tel:${site.phone.tel}`}
      />
    )
  }
</BaseLayout>
