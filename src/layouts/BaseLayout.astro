---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import '@fontsource-variable/fraunces';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import { site } from '../data/site';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import MobileConversionBar from '../components/sections/MobileConversionBar.astro';
import defaultOgImageSource from '../assets/images/kristin-moorehead-malley.webp';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  ogType?: string;
  noindex?: boolean;
}

const { title, description, image, imageAlt, ogType = 'website', noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, site.canonicalOrigin);
// The legacy resources section still contains unrecovered source material and
// must stay out of search until real content replaces the temporary archive.
const routeNoindex = noindex || Astro.url.pathname.startsWith('/resources/');

const OG_ASPECT_RATIO = 1200 / 630;
const ogSource = image ?? defaultOgImageSource;
const ogWidth = Math.min(1200, ogSource.width);
const ogHeight = Math.round(ogWidth / OG_ASPECT_RATIO);
const ogImage = await getImage({ src: ogSource, width: ogWidth, height: ogHeight, format: 'webp' });
const ogImageURL = new URL(ogImage.src, site.canonicalOrigin).toString();
const robotsContent = routeNoindex
  ? 'noindex,follow'
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content={ogWidth.toString()} />
    <meta property="og:image:height" content={ogHeight.toString()} />
    <meta property="og:image:alt" content={imageAlt ?? site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body class="bg-background font-sans text-foreground">
    <a
      href="#main-content"
      class="fixed left-4 top-3 z-[70] -translate-y-24 rounded-full bg-primary px-5 py-3 font-sans text-sm font-semibold text-primary-foreground shadow-lg transition-transform focus:translate-y-0"
    >
      Skip to content
    </a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileConversionBar />
  </body>
</html>
