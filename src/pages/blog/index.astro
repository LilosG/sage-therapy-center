---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/sections/Breadcrumbs.astro';
import Card from '../../components/ui/Card.astro';
import SchemaOrg from '../../components/seo/SchemaOrg.astro';
import { BLOG_URL } from '../../data/nav';
import { blogUrl } from '../../lib/routes';
import { staticBreadcrumbs } from '../../lib/breadcrumbs';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
  title="Therapy Blog | S.A.G.E. Therapy Center, Carlsbad CA"
  description="Therapy articles and practice insights from S.A.G.E. Therapy Center in Carlsbad, CA, with Kristin Moorehead-Malley, LMFT."
>
  <Breadcrumbs items={staticBreadcrumbs('Blog', BLOG_URL)} />

  <div class="bg-secondary px-6 pb-10 pt-10 text-center sm:pb-12 sm:pt-12">
    <p class="eyebrow-label">S.A.G.E. Therapy Center Blog</p>
    <h1 class="mt-4 font-serif text-4xl text-ink sm:text-5xl">Therapy insights from our Carlsbad practice</h1>
    <p class="mx-auto mt-4 max-w-2xl font-sans text-base leading-7 text-muted-foreground">
      Articles related to therapy, relationships, emotional health, and the areas of support offered through S.A.G.E. Therapy Center.
    </p>
  </div>

  <section class="bg-background">
    <div class="mx-auto max-w-3xl px-6 py-10 sm:py-14">
      <div class="space-y-6">
        {
          posts.map((post) => (
            <Card>
              <a href={blogUrl(post.data.slug)} class="font-serif text-xl text-ink hover:text-sage-deep">
                {post.data.title}
              </a>
              <p class="mt-2 font-sans text-sm text-muted-foreground">
                {post.data.publishDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <SchemaOrg type="localBusiness" />
</BaseLayout>
