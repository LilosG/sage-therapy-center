---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import TrustStrip from '../../components/sections/TrustStrip.astro';
import Card from '../../components/ui/Card.astro';
import InquiryFormSection from '../../components/sections/InquiryFormSection.astro';
import SchemaOrg from '../../components/seo/SchemaOrg.astro';
import { editorialImages, getHeroImageAlt } from '../../data/pageImages';
import { BLOG_URL, SCHEDULE_URL } from '../../data/nav';
import { blogUrl } from '../../lib/routes';
import { staticBreadcrumbs } from '../../lib/breadcrumbs';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const heroImage = editorialImages.coastalPath;
---

<BaseLayout
  title="Therapy Blog | S.A.G.E. Therapy Center, Carlsbad CA"
  description="Therapy articles and practice insights from S.A.G.E. Therapy Center in Carlsbad, CA, with Kristin Moorehead-Malley, LMFT."
>
  <PageHero
    eyebrow="S.A.G.E. Therapy Center"
    title="Therapy insights and resources"
    description="Articles on anxiety, relationships, trauma, and the therapy process — written from clinical experience at the Carlsbad practice."
    breadcrumbItems={staticBreadcrumbs('Blog', BLOG_URL)}
    ctaLabel="Schedule a Session"
    ctaHref={SCHEDULE_URL}
    image={heroImage}
    imageAlt={getHeroImageAlt(heroImage)}
  />

  <TrustStrip />

  <section class="bg-background">
    <div class="mx-auto max-w-3xl px-6 py-10 sm:py-14">
      <div class="space-y-6">
        {
          posts.map((post) => (
            <Card>
              <a href={blogUrl(post.data.slug)} class="font-serif text-xl text-ink hover:text-sage-deep">
                {post.data.title}
              </a>
              <p class="mt-2 font-sans text-sm text-muted-foreground">
                {post.data.publishDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <InquiryFormSection
    context="Blog Index"
    heading="Ready to start therapy? Begin with a simple request."
    subhead="Request a follow-up about fit and availability at the Carlsbad office or by telehealth across California."
  />

  <SchemaOrg type="localBusiness" />
</BaseLayout>
