---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import MeetKristin from '../../components/sections/MeetKristin.astro';
import InquiryFormSection from '../../components/sections/InquiryFormSection.astro';
import SchemaOrg from '../../components/seo/SchemaOrg.astro';
import { practitioner } from '../../data/practitioner';
import { getServiceHero, getHeroImageAlt } from '../../data/pageImages';
import { canonicalUrl, blogUrl, serviceUrl } from '../../lib/routes';
import { absoluteBreadcrumbs, blogPostBreadcrumbs } from '../../lib/breadcrumbs';
import kristinPhoto from '../../assets/images/kristin-moorehead-malley.webp';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const primaryService = await getEntry(entry.data.primaryService);
const breadcrumbItems = blogPostBreadcrumbs(entry.data.title, entry.data.slug);
const schemaBreadcrumbs = absoluteBreadcrumbs(breadcrumbItems);
const pageUrl = canonicalUrl(blogUrl(entry.data.slug));
const description = `Therapy insights from S.A.G.E. Therapy Center in Carlsbad, CA related to ${primaryService.data.title.toLowerCase()}.`;
const publishedISO = entry.data.publishDate.toISOString();
const heroImage = getServiceHero(primaryService.data.slug);
const publishLabel = entry.data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${entry.data.title} | S.A.G.E. Therapy Center`}
  description={description}
  ogType="article"
  image={heroImage}
>
  <PageHero
    eyebrow={`S.A.G.E. Therapy Center · ${publishLabel}`}
    title={entry.data.title}
    breadcrumbItems={breadcrumbItems}
    image={heroImage}
    imageAlt={getHeroImageAlt(heroImage)}
  />

  <article class="mx-auto max-w-3xl px-6 pb-10 pt-8 sm:pb-14 sm:pt-10">
    <div class="prose mt-0 max-w-none font-sans text-foreground">
      <Content />
    </div>

    <div class="mt-10 flex flex-wrap gap-3 border-t border-border pt-6 font-sans text-sm">
      <a
        href={serviceUrl(primaryService.data.slug)}
        class="rounded-full border border-border bg-surface px-4 py-2 text-foreground hover:border-sage-deep hover:text-sage-deep"
      >
        {primaryService.data.title} in Carlsbad
      </a>
      <a
        href={entry.data.primaryLocalPage}
        class="rounded-full border border-border bg-surface px-4 py-2 text-foreground hover:border-sage-deep hover:text-sage-deep"
      >
        Local therapy information
      </a>
    </div>
  </article>

  <MeetKristin
    name={practitioner.name}
    credential={practitioner.credential}
    bio={practitioner.bio}
    modalities={[]}
    ctaLabel="Request a Session"
    ctaHref="#request-session"
    image={kristinPhoto}
  />

  <InquiryFormSection
    context={`Blog — ${entry.data.title}`}
    heading="Ready to take the next step with S.A.G.E.?"
    subhead="Request a session to discuss fit and availability in Carlsbad or by telehealth."
  />

  <SchemaOrg
    type="article"
    breadcrumb={schemaBreadcrumbs}
    article={{
      headline: entry.data.title,
      description,
      url: pageUrl,
      datePublished: publishedISO,
    }}
  />
</BaseLayout>
