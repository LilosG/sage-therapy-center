---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/sections/Breadcrumbs.astro';
import CTASection from '../../../components/sections/CTASection.astro';
import { site } from '../../../data/site';
import { SCHEDULE_URL, SELF_LOVE_RESOURCE_URL } from '../../../data/nav';
import { resourceBreadcrumbs } from '../../../lib/breadcrumbs';
---

<BaseLayout
  title="Archived Practice Resource | S.A.G.E. Therapy Center"
  description="An archived S.A.G.E. Therapy Center resource that is being restored from the practice's previous website."
  noindex={true}
>
  <Breadcrumbs items={resourceBreadcrumbs('Archived Resource', SELF_LOVE_RESOURCE_URL)} />

  <section class="bg-background">
    <div class="mx-auto max-w-3xl px-6 py-14 sm:py-20">
      <p class="eyebrow-label">Archived Practice Resource</p>
      <h1 class="mt-4 font-serif text-4xl leading-tight text-ink sm:text-5xl">Original resource content is being restored</h1>
      <p class="mt-6 max-w-2xl font-sans text-base leading-7 text-foreground">
        This URL is being preserved from S.A.G.E. Therapy Center's previous website. The original material will be republished here once it is recovered, rather than replacing it with invented content.
      </p>
    </div>
  </section>

  <CTASection
    heading="Looking for therapy support now?"
    subhead="Request a session to discuss fit and availability in Carlsbad or by telehealth across California."
    ctaLabel="Schedule a Session"
    ctaHref={SCHEDULE_URL}
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
  />
</BaseLayout>
