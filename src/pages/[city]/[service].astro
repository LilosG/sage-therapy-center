---
// Critical guardrail: generate only city/service combinations that have an
// explicit content entry. Never create a Cartesian city x service grid.
import { getCollection, getEntries, getEntry, render } from 'astro:content';
import CityServiceLayout from '../../layouts/CityServiceLayout.astro';
import ServiceEditorialSection from '../../components/sections/ServiceEditorialSection.astro';
import StructuredProse from '../../components/sections/StructuredProse.astro';
import SchemaOrg from '../../components/seo/SchemaOrg.astro';
import { absoluteBreadcrumbs, cityServiceBreadcrumbs } from '../../lib/breadcrumbs';
import { canonicalUrl, cityServiceUrl, serviceUrl } from '../../lib/routes';

export async function getStaticPaths() {
  const entries = await getCollection('city-services');
  return Promise.all(
    entries.map(async (entry) => {
      const city = await getEntry(entry.data.city);
      const service = await getEntry(entry.data.service);
      return {
        params: { city: city.data.slug, service: entry.data.slugOverride ?? service.data.slug },
        props: { entry },
      };
    })
  );
}

const { entry } = Astro.props;
const city = await getEntry(entry.data.city);
const service = await getEntry(entry.data.service);
const { Content } = await render(entry);
const routeSlug = entry.data.slugOverride ?? service.data.slug;
const pageUrl = canonicalUrl(cityServiceUrl(city.data.slug, routeSlug));
const schemaBreadcrumbs = absoluteBreadcrumbs(
  cityServiceBreadcrumbs(city.data.name, city.data.slug, service.data.title, routeSlug)
);

const cityServiceEntries = await getCollection('city-services');
const localCombosForCity = new Map(
  cityServiceEntries.filter((cs) => cs.data.city.id === city.id).map((cs) => [cs.data.service.id, cs])
);

const otherApprovedServices = entry.data.lateralLinks?.length
  ? await getEntries(entry.data.lateralLinks)
  : (city.data.approvedCityServices.length ? await getEntries(city.data.approvedCityServices) : [])
      .filter((s) => s.id !== service.id)
      .slice(0, 3);

const relatedLinks = otherApprovedServices.map((s) => {
  const localEntry = localCombosForCity.get(s.id);
  return {
    title: s.data.title,
    href: localEntry
      ? cityServiceUrl(city.data.slug, localEntry.data.slugOverride ?? s.data.slug)
      : serviceUrl(s.data.slug),
  };
});
const hasStructuredContent = Boolean(entry.data.recognition?.length && entry.data.overview && entry.data.topics);
---

<CityServiceLayout entry={entry} relatedLinks={relatedLinks}>
  {
    !hasStructuredContent && (
      <ServiceEditorialSection
        cityName={city.data.name}
        hasOffice={city.data.hasOffice}
        detailsEyebrow={`${service.data.title} in ${city.data.name}`}
        related={relatedLinks}
      >
        <StructuredProse class="max-w-2xl prose-p:leading-7 prose-li:leading-7">
          <Content />
        </StructuredProse>

        <div class="mt-10 border-t border-border pt-6">
          <a href={serviceUrl(service.data.slug)} class="font-sans text-sm font-medium text-sage-deep hover:text-primary">
            &larr; {service.data.title} overview
          </a>
        </div>
      </ServiceEditorialSection>
    )
  }
</CityServiceLayout>

<SchemaOrg
  type="service"
  breadcrumb={schemaBreadcrumbs}
  service={{
    name: `${service.data.title} in ${city.data.name}`,
    description: service.data.description,
    serviceType: service.data.primaryTarget,
    url: pageUrl,
    areaServed: city.data.name,
  }}
/>
