---
// Critical guardrail: generate only approved secondary-city/service combinations
// that have an explicit content entry. The physical-office city uses the
// canonical /services/{service}/ pages so we do not create two pages targeting
// the same service + Carlsbad search intent.
import { getCollection, getEntries, getEntry, render } from 'astro:content';
import CityServiceLayout from '../../layouts/CityServiceLayout.astro';
import ServiceEditorialSection from '../../components/sections/ServiceEditorialSection.astro';
import StructuredProse from '../../components/sections/StructuredProse.astro';
import { site } from '../../data/site';
import { cityServiceUrl, serviceUrl } from '../../lib/routes';

export async function getStaticPaths() {
  const entries = await getCollection('city-services');
  const paths = [];

  for (const entry of entries) {
    const city = await getEntry(entry.data.city);
    if (city.data.hasOffice) continue;

    const service = await getEntry(entry.data.service);
    paths.push({
      params: { city: city.data.slug, service: entry.data.slugOverride ?? service.data.slug },
      props: { entry },
    });
  }

  return paths;
}

const { entry } = Astro.props;
const city = await getEntry(entry.data.city);
const service = await getEntry(entry.data.service);
const { Content } = await render(entry);

const cityServiceEntries = await getCollection('city-services');
const localCombosForCity = new Map(
  cityServiceEntries.filter((cs) => cs.data.city.id === city.id).map((cs) => [cs.data.service.id, cs])
);

// Build related links: lateralLinks are prioritized first, then fill remaining
// slots from approvedCityServices so the strip always shows a meaningful set.
const MAX_RELATED = 6;
const allApproved = city.data.approvedCityServices.length
  ? await getEntries(city.data.approvedCityServices)
  : [];
const otherApproved = allApproved.filter((s) => s.id !== service.id);
const lateralEntries = entry.data.lateralLinks?.length ? await getEntries(entry.data.lateralLinks) : [];
const lateralIds = new Set(lateralEntries.map((s) => s.id));
const supplemental = otherApproved.filter((s) => !lateralIds.has(s.id));
const otherApprovedServices = [...lateralEntries, ...supplemental].slice(0, MAX_RELATED);

const relatedLinks = otherApprovedServices.map((s) => {
  const localEntry = localCombosForCity.get(s.id);
  return {
    title: localEntry ? `${s.data.title} for ${city.data.name}` : `${s.data.title} in ${site.address.city}`,
    href: localEntry
      ? cityServiceUrl(city.data.slug, localEntry.data.slugOverride ?? s.data.slug)
      : serviceUrl(s.data.slug),
  };
});
const hasStructuredContent = Boolean(entry.data.recognition?.length && entry.data.overview && entry.data.topics);
const hasStructuredServiceShell = Boolean(service.data.recognition?.length && service.data.topics);
---

<CityServiceLayout entry={entry} relatedLinks={relatedLinks}>
  {
    !hasStructuredContent && (
      <ServiceEditorialSection
        cityName={city.data.name}
        hasOffice={city.data.hasOffice}
        detailsEyebrow={`${service.data.title} for ${city.data.name}`}
        related={hasStructuredServiceShell ? [] : relatedLinks}
      >
        <StructuredProse class="max-w-2xl prose-p:leading-7 prose-li:leading-7">
          <Content />
        </StructuredProse>

        <div class="mt-10 border-t border-border pt-6">
          <a href={serviceUrl(service.data.slug)} class="font-sans text-sm font-medium text-sage-deep hover:text-primary">
            &larr; {service.data.title} in {site.address.city}
          </a>
        </div>
      </ServiceEditorialSection>
    )
  }
</CityServiceLayout>
