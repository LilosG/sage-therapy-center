---
// Critical guardrail (Build Spec Section 5): getStaticPaths() sources
// ONLY from existing `city-services` content entries, never from a
// cross-product of all cities x all services. A research-gated
// city/service combination gets a live route only when someone adds a
// content entry for it — never by editing this file.
import { getCollection, getEntry, render } from 'astro:content';
import CityServiceLayout from '../../layouts/CityServiceLayout.astro';
import SchemaOrg from '../../components/seo/SchemaOrg.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const entries = await getCollection('city-services');
  return Promise.all(
    entries.map(async (entry) => {
      const city = await getEntry(entry.data.city);
      const service = await getEntry(entry.data.service);
      return {
        params: { city: city.data.slug, service: service.data.slug },
        props: { entry },
      };
    })
  );
}

const { entry } = Astro.props;
const city = await getEntry(entry.data.city);
const service = await getEntry(entry.data.service);
const { Content } = await render(entry);
const pageUrl = `${site.canonicalOrigin}/${city.data.slug}/${service.data.slug}/`;
---

<CityServiceLayout entry={entry}>
  <div class="mx-auto max-w-3xl px-6 pb-4 pt-8">
    <p class="eyebrow-label">{city.data.name}</p>
    <h1 class="mt-4 font-serif text-4xl text-ink sm:text-5xl">
      {service.data.title} in {city.data.name}, CA
    </h1>
    <div class="prose mt-6 max-w-none font-sans text-foreground">
      <Content />
    </div>
  </div>
</CityServiceLayout>

<SchemaOrg
  type="service"
  service={{
    name: `${service.data.title} in ${city.data.name}`,
    description: service.data.description,
    serviceType: service.data.primaryTarget,
    url: pageUrl,
    areaServed: city.data.name,
  }}
/>
