---
// Minimal route wiring only, to prove the cities collection schema
// validates and getStaticPaths() renders — not a Wave 1 content page.
import { getCollection } from 'astro:content';
import CityLayout from '../../layouts/CityLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('cities');
  return entries.map((entry) => ({
    params: { city: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<CityLayout entry={entry}>
  <h1>{entry.data.name}</h1>
</CityLayout>
