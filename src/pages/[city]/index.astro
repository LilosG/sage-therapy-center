---
import { getCollection, getEntries, render } from 'astro:content';
import CityLayout from '../../layouts/CityLayout.astro';
import ServiceGrid from '../../components/sections/ServiceGrid.astro';
import MapEmbed from '../../components/sections/MapEmbed.astro';
import SchemaOrg from '../../components/seo/SchemaOrg.astro';
import { site } from '../../data/site';
import { serviceIcons, defaultServiceIcon } from '../../data/serviceIcons';
import { canonicalUrl, cityServiceUrl, cityUrl, serviceUrl } from '../../lib/routes';
import { citySchemaBreadcrumbs } from '../../lib/breadcrumbs';
import googleReviews from '../../data/google-reviews.json';

export async function getStaticPaths() {
  const entries = await getCollection('cities');
  return entries.map((entry) => ({
    params: { city: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const approvedServices = entry.data.approvedCityServices.length
  ? await getEntries(entry.data.approvedCityServices)
  : [];
const nearbyCities = entry.data.nearbyCities.length ? await getEntries(entry.data.nearbyCities) : [];

// Prefer a local city/service combo page over the general service pillar
// when one exists for this city — it has real, city-specific content
// (per Wave 2), so it's a better link target than the generic pillar.
const cityServiceEntries = await getCollection('city-services');
// Maps service id -> its local combo entry (for slugOverride), not just a
// membership Set, since a combo's route slug may differ from the
// referenced service's own slug (Wave 11 trauma-therapy case).
const localCombosForCity = new Map(
  cityServiceEntries.filter((cs) => cs.data.city.id === entry.id).map((cs) => [cs.data.service.id, cs])
);

const pageUrl = canonicalUrl(cityUrl(entry.data.slug));
const breadcrumbItems = citySchemaBreadcrumbs(entry.data.name, pageUrl);
---

<CityLayout
  entry={entry}
  showReviews={true}
  rating={googleReviews.rating}
  reviewCount={googleReviews.userRatingCount}
  reviews={googleReviews.reviews}
  placeUrl={`https://www.google.com/maps/place/?q=place_id:${googleReviews.placeId}`}
  lastUpdated={googleReviews.fetchedAt}
>
  <div class="mx-auto max-w-3xl px-6 pb-4 pt-8">
    <div class="prose max-w-none font-sans text-foreground">
      <Content />
    </div>
  </div>

  {
    entry.data.hasOffice && (
      <div class="bg-lavender-soft">
        <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 sm:py-20 lg:grid-cols-2 lg:items-start">
          <div>
            <p class="eyebrow-label">Our Office</p>
            <h2 class="mt-4 font-serif text-3xl text-ink sm:text-4xl">Visit us in {entry.data.name}</h2>
            <address class="mt-4 font-sans not-italic text-foreground">
              {site.address.street}
              <br />
              {site.address.city}, {site.address.region} {site.address.postalCode}
            </address>
            {entry.data.neighborhoods.length > 0 && (
              <>
                <p class="mt-8 font-sans text-sm font-semibold text-ink">Neighborhoods we serve in {entry.data.name}</p>
                <ul class="mt-4 space-y-3">
                  {entry.data.neighborhoods.map((n) => (
                    <li>
                      <span class="font-serif text-base text-ink">{n.name}</span>
                      <span class="ml-2 font-sans text-sm text-muted-foreground">{n.blurb}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>
          <MapEmbed />
        </div>
      </div>
    )
  }

  {
    nearbyCities.length > 0 && (
      <section class="bg-background">
        <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
          <div class="mx-auto max-w-2xl text-center">
            <p class="eyebrow-label">Nearby Areas</p>
            <h2 class="mt-4 font-serif text-3xl text-ink sm:text-4xl">Also serving nearby North County communities</h2>
          </div>
          <ul class="mt-8 flex flex-wrap justify-center gap-3">
            {nearbyCities.map((c) => (
              <li>
                <a
                  href={cityUrl(c.data.slug)}
                  class="rounded-full border border-border bg-surface px-5 py-2 font-sans text-sm text-foreground hover:border-sage-deep hover:text-sage-deep"
                >
                  {c.data.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    approvedServices.length > 0 && (
      <ServiceGrid
        heading={`Services available for ${entry.data.name} clients`}
        services={approvedServices.map((s) => ({
          title: s.data.title,
          description: s.data.description,
          href: localCombosForCity.has(s.id)
            ? cityServiceUrl(entry.data.slug, localCombosForCity.get(s.id).data.slugOverride ?? s.data.slug)
            : serviceUrl(s.data.slug),
          icon: serviceIcons[s.data.slug] ?? defaultServiceIcon,
        }))}
        background="secondary"
      />
    )
  }
</CityLayout>

<SchemaOrg
  type="city"
  city={{ name: entry.data.name, url: pageUrl, areaServed: entry.data.name }}
  breadcrumb={breadcrumbItems}
  reviewsData={{ rating: googleReviews.rating, reviewCount: googleReviews.userRatingCount }}
/>
