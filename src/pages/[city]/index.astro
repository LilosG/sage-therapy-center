---
import { getCollection, getEntries, render } from 'astro:content';
import CityLayout from '../../layouts/CityLayout.astro';
import CityOverviewSection from '../../components/sections/CityOverviewSection.astro';
import ServiceGrid from '../../components/sections/ServiceGrid.astro';
import StructuredProse from '../../components/sections/StructuredProse.astro';
import { serviceIcons, defaultServiceIcon } from '../../data/serviceIcons';
import { cityServiceUrl, cityUrl, serviceUrl } from '../../lib/routes';
import googleReviews from '../../data/google-reviews.json';

export async function getStaticPaths() {
  const entries = await getCollection('cities');
  return entries.map((entry) => ({
    params: { city: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const approvedServices = entry.data.approvedCityServices.length
  ? await getEntries(entry.data.approvedCityServices)
  : [];
const nearbyCities = entry.data.nearbyCities.length ? await getEntries(entry.data.nearbyCities) : [];

const cityServiceEntries = await getCollection('city-services');
const localCombosForCity = new Map(
  cityServiceEntries.filter((cs) => cs.data.city.id === entry.id).map((cs) => [cs.data.service.id, cs])
);

const serviceDirectoryIntro = entry.data.hasOffice
  ? `Explore therapy services available through S.A.G.E.'s physical office in ${entry.data.name}. Each service page is the canonical local page for that therapy focus, with telehealth also available across California.`
  : `Explore therapy options available to ${entry.data.name} clients. When a dedicated ${entry.data.name} service page is available, the link goes directly to that local resource; in-person sessions remain based at the Carlsbad office.`;
---

<CityLayout
  entry={entry}
  showReviews={true}
  rating={googleReviews.rating}
  reviewCount={googleReviews.userRatingCount}
  reviews={googleReviews.reviews}
  placeUrl={`https://www.google.com/maps/place/?q=place_id:${googleReviews.placeId}`}
  lastUpdated={googleReviews.fetchedAt}
  nearbyCities={nearbyCities.map((c) => ({ name: c.data.name, href: cityUrl(c.data.slug) }))}
>
  <Fragment slot="overview">
    <CityOverviewSection cityName={entry.data.name} hasOffice={entry.data.hasOffice}>
      <StructuredProse class="prose-p:my-0 prose-p:leading-7 prose-a:text-sage-deep">
        <Content />
      </StructuredProse>
    </CityOverviewSection>
  </Fragment>

  {
    approvedServices.length > 0 && (
      <ServiceGrid
        eyebrow={entry.data.hasOffice ? `Therapy Services in ${entry.data.name}` : `Therapy Services for ${entry.data.name}`}
        heading={entry.data.hasOffice ? `Therapy services available in ${entry.data.name}, CA` : `Therapy services available to ${entry.data.name} clients`}
        intro={serviceDirectoryIntro}
        services={approvedServices.map((s) => {
          const localEntry = localCombosForCity.get(s.id);
          const hasDedicatedLocalPage = !entry.data.hasOffice && Boolean(localEntry);
          return {
            title: entry.data.hasOffice
              ? `${s.data.title} in ${entry.data.name}`
              : hasDedicatedLocalPage
                ? `${s.data.title} for ${entry.data.name}`
                : s.data.title,
            description: s.data.description,
            // The physical-office city must link straight to the canonical
            // /services/ page. Never send internal authority through a redirect.
            href: entry.data.hasOffice
              ? serviceUrl(s.data.slug)
              : localEntry
                ? cityServiceUrl(entry.data.slug, localEntry.data.slugOverride ?? s.data.slug)
                : serviceUrl(s.data.slug),
            icon: serviceIcons[s.data.slug] ?? defaultServiceIcon,
          };
        })}
        background="secondary"
        variant="directory"
      />
    )
  }
</CityLayout>
