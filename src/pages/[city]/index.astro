---
import { getCollection, getEntries, render } from 'astro:content';
import CityLayout from '../../layouts/CityLayout.astro';
import ServiceGrid from '../../components/sections/ServiceGrid.astro';
import CTASection from '../../components/sections/CTASection.astro';
import SchemaOrg from '../../components/seo/SchemaOrg.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const entries = await getCollection('cities');
  return entries.map((entry) => ({
    params: { city: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const approvedServices = entry.data.approvedCityServices.length
  ? await getEntries(entry.data.approvedCityServices)
  : [];
const pageUrl = `${site.canonicalOrigin}/${entry.data.slug}/`;
const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Areas We Serve', url: '/areas-we-serve/' },
  { name: entry.data.name, url: pageUrl },
];
---

<CityLayout entry={entry}>
  <div class="mx-auto max-w-3xl px-6 pb-4 pt-8">
    <p class="eyebrow-label">
      {entry.data.hasOffice ? 'Our Office' : 'Areas We Serve'}
    </p>
    <h1 class="mt-4 font-serif text-4xl text-ink sm:text-5xl">Therapist in {entry.data.name}, CA</h1>
    <div class="prose mt-6 max-w-none font-sans text-foreground">
      <Content />
    </div>
  </div>

  {
    approvedServices.length > 0 && (
      <ServiceGrid
        heading={`Services available for ${entry.data.name} clients`}
        services={approvedServices.map((s) => ({
          title: s.data.title,
          description: s.data.description,
          href: `/services/${s.data.slug}/`,
        }))}
      />
    )
  }

  <CTASection
    heading={`Ready to schedule as a ${entry.data.name} client?`}
    subhead="Request a session to discuss fit and availability."
    ctaLabel="Schedule a Session"
    ctaHref="/schedule-a-session/"
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
  />
</CityLayout>

<SchemaOrg
  type="city"
  city={{ name: entry.data.name, url: pageUrl, areaServed: entry.data.name }}
  breadcrumb={breadcrumbItems}
/>
