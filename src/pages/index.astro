---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import TrustStrip from '../components/sections/TrustStrip.astro';
import ReassuranceGrid from '../components/sections/ReassuranceGrid.astro';
import MeetKristin from '../components/sections/MeetKristin.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import ServiceGrid from '../components/sections/ServiceGrid.astro';
import QuoteBlock from '../components/sections/QuoteBlock.astro';
import ReviewsSection from '../components/sections/ReviewsSection.astro';
import AreasServed from '../components/sections/AreasServed.astro';
import CTASection from '../components/sections/CTASection.astro';
import SchemaOrg from '../components/seo/SchemaOrg.astro';
import { site } from '../data/site';
import { practitioner } from '../data/practitioner';
import { serviceIcons, defaultServiceIcon } from '../data/serviceIcons';
import { ABOUT_URL, AREAS_WE_SERVE_URL, SCHEDULE_URL, SERVICES_URL } from '../data/nav';
import { cityUrl, serviceUrl } from '../lib/routes';
import kristinPhoto from '../assets/images/kristin-moorehead-malley.webp';
import googleReviews from '../data/google-reviews.json';

// Data-driven rather than a hardcoded 6/8 list: only individual-therapy
// and couples-counseling exist as real content this wave, and only
// Carlsbad/Encinitas/San Marcos have real city entries. Linking to routes
// that don't exist yet would 404; full link-quota coverage (Build Spec
// Section C: 6 core services, 8 cities) arrives naturally as later waves
// add the remaining content entries.
const services = await getCollection('services');
const cities = await getCollection('cities');

const coreServices = services.filter((s) => s.data.category === 'core');

// Insurance against a silent zero-render: a schema/content regression that
// drops every core service or city would otherwise ship an empty homepage
// grid with no build-time signal (see Wave 7 audit).
if (coreServices.length === 0) {
  throw new Error('Homepage core services resolved to zero entries — check category filter/schema.');
}
if (cities.length === 0) {
  throw new Error('Homepage cities resolved to zero entries — check cities collection.');
}
---

<BaseLayout
  title="S.A.G.E. Therapy Center | Therapist in Carlsbad, CA"
  description="Individual and couples therapy in Carlsbad, CA with Kristin Moorehead-Malley, LMFT. Request a session to discuss fit and availability."
>
  <Hero
    badge="Now Accepting New Clients"
    eyebrow="S.A.G.E. Therapy Center"
    headline="Support for whatever you're carrying — anxiety, trauma, or life's harder chapters."
    emphasis="anxiety, trauma"
    subhead="Individual and couples therapy in Carlsbad, CA, drawing on a range of therapeutic approaches to help you feel more like yourself."
    primaryCta={{ label: 'Schedule a Session', href: SCHEDULE_URL }}
    secondaryCta={{ label: 'Meet Kristin', href: ABOUT_URL }}
  />

  <TrustStrip />

  <div class="bg-secondary px-6 py-10 text-center">
    <p class="mx-auto max-w-2xl font-sans text-foreground">
      S.A.G.E. stands for Self-Awareness, Growth, and Enlightenment — a mission to help you discover inner peace,
      heal from past experiences, and cultivate a more joyful life.
    </p>
  </div>

  <ReassuranceGrid
    eyebrow="You're In The Right Place If..."
    heading="You're in the right place if..."
    items={[
      {
        title: 'Feeling anxious or overwhelmed',
        body: 'Sessions may explore what’s driving anxiety and overwhelm, and ways to feel more grounded.',
        icon: 'lucide:wind',
      },
      {
        title: 'Stuck in patterns you want to change',
        body: 'An approach can include exploring patterns in how you think, feel, and relate to others.',
        icon: 'lucide:refresh-cw',
      },
      {
        title: 'Navigating grief or a hard transition',
        body: 'Some people seek therapy when they’re grieving a loss or moving through a major life change.',
        icon: 'lucide:cloud-rain',
      },
      {
        title: 'Working through it with a partner',
        body: 'Couples counseling offers support for communication, connection, and relationship challenges.',
        icon: 'lucide:heart',
      },
    ]}
  />

  <MeetKristin
    name={practitioner.name}
    credential={practitioner.credential}
    bio={practitioner.bio}
    modalities={practitioner.modalities}
    ctaLabel={practitioner.ctaLabel}
    ctaHref={practitioner.ctaHref}
    image={kristinPhoto}
  />

  <ProcessSteps
    eyebrow="How It Works"
    heading="How therapy works"
    steps={[
      { title: 'Reach out', body: 'Request a session to discuss fit and availability, by phone or email.' },
      {
        title: 'First session',
        body: 'Meet with Kristin to talk through what brought you in and what you’re hoping for.',
      },
      { title: 'Ongoing sessions', body: 'Continue at a pace and with an approach that fits your goals.' },
    ]}
  />

  <ServiceGrid
    eyebrow="What We Offer"
    heading="How we can help"
    services={coreServices
      .map((s) => ({
        title: s.data.title,
        description: s.data.description,
        href: serviceUrl(s.data.slug),
        icon: serviceIcons[s.data.slug] ?? defaultServiceIcon,
      }))}
    viewAllHref={SERVICES_URL}
    viewAllLabel="View all services"
    background="secondary"
  />

  <QuoteBlock
    quote="Therapy is a lot like climbing Everest."
    attribution={`${site.practitioner.name}, ${site.practitioner.credential}`}
  />

  <ReviewsSection
    rating={googleReviews.rating}
    reviewCount={googleReviews.userRatingCount}
    reviews={googleReviews.reviews}
    placeUrl={`https://www.google.com/maps/place/?q=place_id:${googleReviews.placeId}`}
    lastUpdated={googleReviews.fetchedAt}
  />

  <AreasServed
    eyebrow="Areas We Serve"
    heading="Serving Carlsbad and North County San Diego"
    cities={cities.map((c) => ({ name: c.data.name, href: cityUrl(c.data.slug) }))}
    viewAllHref={AREAS_WE_SERVE_URL}
  />

  <CTASection
    heading="Ready to take the first step?"
    subhead="Request a session to discuss fit and availability."
    ctaLabel="Schedule a Session"
    ctaHref={SCHEDULE_URL}
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
  />
</BaseLayout>

<SchemaOrg
  type="organization"
  reviewsData={
    typeof googleReviews.rating === 'number' && typeof googleReviews.userRatingCount === 'number'
      ? {
          rating: googleReviews.rating,
          reviewCount: googleReviews.userRatingCount,
          reviews: googleReviews.reviews,
        }
      : undefined
  }
/>
