---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import TrustStrip from '../components/sections/TrustStrip.astro';
import RecognitionBand from '../components/sections/RecognitionBand.astro';
import MeetKristin from '../components/sections/MeetKristin.astro';
import PhilosophySection from '../components/sections/PhilosophySection.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import PracticeSection from '../components/sections/PracticeSection.astro';
import ServiceGrid from '../components/sections/ServiceGrid.astro';
import ReviewsSection from '../components/sections/ReviewsSection.astro';
import AreasServed from '../components/sections/AreasServed.astro';
import PageFaqs from '../components/sections/PageFaqs.astro';
import InquiryFormSection from '../components/sections/InquiryFormSection.astro';
import SchemaOrg from '../components/seo/SchemaOrg.astro';
import { site } from '../data/site';
import { practitioner } from '../data/practitioner';
import { homeImages } from '../data/homeImages';
import { serviceIcons, defaultServiceIcon } from '../data/serviceIcons';
import { sortCoreServices } from '../data/serviceOrder';
import { buildHomeFaqs } from '../lib/pageFaqs';
import { ABOUT_URL, AREAS_WE_SERVE_URL, SERVICES_URL } from '../data/nav';
import { cityUrl, serviceUrl } from '../lib/routes';
import kristinPhoto from '../assets/images/kristin-moorehead-malley.webp';
import googleReviews from '../data/google-reviews.json';

const services = await getCollection('services');
const cities = await getCollection('cities');
const coreServices = sortCoreServices(services.filter((service) => service.data.category === 'core'));
const faqItems = buildHomeFaqs(coreServices.map((service) => service.data.title));

if (coreServices.length === 0) {
  throw new Error('Homepage core services resolved to zero entries — check category filter/schema.');
}
if (cities.length === 0) {
  throw new Error('Homepage cities resolved to zero entries — check cities collection.');
}
---

<BaseLayout
  title="Therapy Center in Carlsbad, CA | S.A.G.E. Therapy Center"
  description="S.A.G.E. Therapy Center provides individual, couples, family, teen, EMDR, anxiety, and trauma-focused therapy in Carlsbad, CA with telehealth across California."
  image={homeImages.hero}
>
  <Hero
    badge="Now Accepting New Clients"
    eyebrow="S.A.G.E. Therapy Center · Carlsbad, CA"
    headline="Therapy in Carlsbad, CA for individuals, couples, families, and teens."
    subhead="Work with Kristin Moorehead-Malley, LMFT, at S.A.G.E.'s Carlsbad office or by telehealth across California. Therapy is individualized around the person, relationship, family, and goals in front of her."
    primaryCta={{ label: 'Schedule a Session', href: '#request-session' }}
    secondaryCta={{ label: 'Meet Kristin', href: ABOUT_URL }}
    image={homeImages.hero}
  />

  <TrustStrip />

  <RecognitionBand
    eyebrow="A Place To Begin"
    heading="Therapy can start with what is happening in your life right now"
    items={[
      {
        title: 'Feeling anxious or overwhelmed',
        body: 'Sessions may explore what is driving anxiety and overwhelm and how it is affecting day-to-day life.',
      },
      {
        title: 'Stuck in patterns you want to change',
        body: 'Therapy can create space to understand recurring patterns in how you think, feel, and relate to others.',
      },
      {
        title: 'Navigating grief or a hard transition',
        body: 'Some people seek therapy while grieving a loss or moving through a major life change.',
      },
      {
        title: 'Working through it with a partner',
        body: 'Couples counseling can support communication, connection, and relationship concerns.',
      },
    ]}
  />

  <ServiceGrid
    eyebrow="Therapy Services in Carlsbad"
    heading="Therapy services available through S.A.G.E. Therapy Center"
    services={coreServices.map((service) => ({
      title: `${service.data.title} in Carlsbad`,
      description: service.data.description,
      href: serviceUrl(service.data.slug),
      icon: serviceIcons[service.data.slug] ?? defaultServiceIcon,
    }))}
    viewAllHref={SERVICES_URL}
    viewAllLabel="View all therapy services"
    background="secondary"
  />

  <MeetKristin
    name={practitioner.name}
    credential={practitioner.credential}
    bio={practitioner.bio}
    modalities={[]}
    ctaLabel={practitioner.ctaLabel}
    ctaHref={practitioner.ctaHref}
    image={kristinPhoto}
  />

  <ReviewsSection
    rating={googleReviews.rating}
    reviewCount={googleReviews.userRatingCount}
    reviews={googleReviews.reviews}
    placeUrl={`https://www.google.com/maps/place/?q=place_id:${googleReviews.placeId}`}
    lastUpdated={googleReviews.fetchedAt}
  />

  <PhilosophySection
    heading="Therapy should fit the person — not force the person into one method."
    body="S.A.G.E. stands for Self-Awareness, Growth, and Enlightenment. Kristin draws from multiple therapeutic approaches so the work can respond to the person, relationship, and circumstances in front of her rather than following one rigid formula."
    quote="If you were climbing Mt. Everest, would you want a guide who had only read about it, or someone who had actually made the journey?"
    attribution={`${site.practitioner.name}, ${site.practitioner.credential}`}
    items={['EMDR', 'CBT', 'IMAGO', 'Attachment-Based', 'Lifespan Integration', 'Psychodynamic']}
    image={homeImages.philosophy}
  />

  <ProcessSteps
    eyebrow="Starting Therapy in Carlsbad"
    heading="What getting started at S.A.G.E. Therapy Center looks like"
    steps={[
      { title: 'Reach out', body: 'Request a session to discuss fit and availability, by phone or online request.' },
      {
        title: 'First session',
        body: 'Meet with Kristin to talk through what brought you in and what you are hoping for.',
      },
      { title: 'Ongoing sessions', body: 'Continue at a pace and with an approach that fits your goals.' },
    ]}
  />

  <PracticeSection />

  <AreasServed
    eyebrow="North County Service Areas"
    heading="Therapy for Carlsbad and nearby North County communities"
    cities={cities.map((city) => ({ name: city.data.name, href: cityUrl(city.data.slug) }))}
    viewAllHref={AREAS_WE_SERVE_URL}
    variant="compact"
  />

  <PageFaqs heading="S.A.G.E. Therapy Center in Carlsbad: common questions" items={faqItems} background="surface" />

  <InquiryFormSection
    context="Homepage — Carlsbad Therapy"
    heading="Ready to get started? Begin with a simple request."
    subhead="Request a follow-up about availability, session options, and what kind of therapy you are looking for."
  />

  <SchemaOrg type="website" />
  <SchemaOrg type="person" />
</BaseLayout>
