---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import TrustStrip from '../../components/sections/TrustStrip.astro';
import TelehealthHighlight from '../../components/sections/TelehealthHighlight.astro';
import ServiceGrid from '../../components/sections/ServiceGrid.astro';
import PageFaqs from '../../components/sections/PageFaqs.astro';
import CTASection from '../../components/sections/CTASection.astro';
import SchemaOrg from '../../components/seo/SchemaOrg.astro';
import { site } from '../../data/site';
import { hubHeroImages, getHeroImageAlt } from '../../data/pageImages';
import { serviceIcons, defaultServiceIcon } from '../../data/serviceIcons';
import { sortCoreServices } from '../../data/serviceOrder';
import { buildServicesHubFaqs } from '../../lib/pageFaqs';
import { SCHEDULE_URL, SERVICES_URL } from '../../data/nav';
import { serviceUrl } from '../../lib/routes';
import { staticBreadcrumbs } from '../../lib/breadcrumbs';

const services = await getCollection('services');
const coreServices = sortCoreServices(services.filter((service) => service.data.category === 'core'));
const concernLedServices = services.filter((service) => service.data.category === 'concern-led');
const breadcrumbItems = staticBreadcrumbs('Services', SERVICES_URL);
const faqItems = buildServicesHubFaqs(coreServices.map((service) => service.data.title));
---

<BaseLayout
  title="Therapy Services in Carlsbad, CA | S.A.G.E. Therapy Center"
  description="Explore individual, couples, family, teen, EMDR, anxiety, trauma-focused, and telehealth therapy options through S.A.G.E. Therapy Center in Carlsbad, CA."
  image={hubHeroImages.services}
>
  <PageHero
    eyebrow="Therapy Services in Carlsbad"
    title="Therapy services in Carlsbad, CA"
    description="Explore individual, relationship, family, teen, and concern-focused therapy options with Kristin Moorehead-Malley, LMFT. Meet in person in Carlsbad or explore telehealth across California."
    breadcrumbItems={breadcrumbItems}
    ctaLabel="Explore Services"
    ctaHref="#services-directory"
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
    image={hubHeroImages.services}
    imageAlt={getHeroImageAlt(hubHeroImages.services)}
  />

  <TrustStrip />

  <TelehealthHighlight />

  <div id="services-directory" class="scroll-mt-24">
    <ServiceGrid
      eyebrow="Carlsbad Therapy Services"
      heading="Therapy services available in Carlsbad, CA"
      intro="Each service below has a dedicated Carlsbad landing page with service-specific information, relevant therapy approaches, practical details, and a direct path to request a session."
      services={coreServices.map((service) => ({
        title: `${service.data.title} in Carlsbad`,
        description: service.data.description,
        href: serviceUrl(service.data.slug),
        icon: serviceIcons[service.data.slug] ?? defaultServiceIcon,
      }))}
      variant="directory"
      background="background"
    />
  </div>

  {
    concernLedServices.length > 0 && (
      <ServiceGrid
        eyebrow="Concern-Focused Therapy"
        heading="Concern-focused therapy in Carlsbad, CA"
        intro="If you are starting with a specific concern rather than a therapy format, these pages explain how S.A.G.E. may approach that area of support."
        services={concernLedServices.map((service) => ({
          title: `${service.data.title} in Carlsbad`,
          description: service.data.description,
          href: serviceUrl(service.data.slug),
          icon: serviceIcons[service.data.slug] ?? defaultServiceIcon,
        }))}
        variant="directory"
        background="secondary"
      />
    )
  }

  <PageFaqs heading="Therapy services in Carlsbad: common questions" items={faqItems} background="surface" />

  <CTASection
    heading="Not sure which therapy service fits?"
    subhead="You do not need to choose the perfect page before reaching out. Start with a conversation about what is bringing you in, fit, current availability, and whether you prefer in-person or telehealth sessions."
    ctaLabel="Schedule a Session"
    ctaHref={SCHEDULE_URL}
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
  />

  <SchemaOrg type="localBusiness" />
</BaseLayout>
