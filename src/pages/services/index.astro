---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/sections/Breadcrumbs.astro';
import ServiceGrid from '../../components/sections/ServiceGrid.astro';
import CTASection from '../../components/sections/CTASection.astro';
import SchemaOrg from '../../components/seo/SchemaOrg.astro';
import { site } from '../../data/site';
import { serviceIcons, defaultServiceIcon } from '../../data/serviceIcons';
import { SCHEDULE_URL, SERVICES_URL } from '../../data/nav';
import { serviceUrl } from '../../lib/routes';
import { staticBreadcrumbs } from '../../lib/breadcrumbs';

// Data-driven: only shows services that exist as real content entries.
const services = await getCollection('services');
const coreServices = services.filter((s) => s.data.category === 'core');
const concernLedServices = services.filter((s) => s.data.category === 'concern-led');
---

<BaseLayout
  title="Our Services | S.A.G.E. Therapy Center"
  description="Individual and couples therapy services offered at S.A.G.E. Therapy Center in Carlsbad, CA."
>
  <Breadcrumbs items={staticBreadcrumbs('Services', SERVICES_URL)} />

  <div class="mx-auto max-w-3xl px-6 pb-4 pt-8 text-center">
    <p class="eyebrow-label">Services</p>
    <h1 class="mt-4 font-serif text-4xl text-ink sm:text-5xl">How we can help</h1>
    <p class="mx-auto mt-4 max-w-2xl font-sans text-lg text-foreground">
      S.A.G.E. Therapy Center offers individual and couples therapy at the Carlsbad office, drawing on a range of
      approaches matched to what fits each person or couple.
    </p>
  </div>

  <ServiceGrid
    eyebrow="Core Services"
    heading="Where most people start"
    services={coreServices.map((s) => ({
      title: s.data.title,
      description: s.data.description,
      href: serviceUrl(s.data.slug),
      icon: serviceIcons[s.data.slug] ?? defaultServiceIcon,
    }))}
  />

  <section class="bg-secondary">
    <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow-label">Areas of Focus</p>
        <h2 class="mt-4 font-serif text-3xl text-ink sm:text-4xl">More ways we can help</h2>
        <p class="mt-4 font-sans text-foreground">
          Beyond the core services above, sessions can also focus on any of the following.
        </p>
      </div>
      <ul class="mt-10 flex flex-wrap justify-center gap-3">
        {
          concernLedServices.map((s) => (
            <li>
              <a
                href={serviceUrl(s.data.slug)}
                class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-2 font-sans text-sm text-foreground hover:border-sage-deep hover:text-sage-deep"
              >
                <Icon name={serviceIcons[s.data.slug] ?? defaultServiceIcon} width={16} height={16} class="text-sage-deep" />
                {s.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTASection
    heading="Not sure which service fits?"
    subhead="Request a session to discuss fit and availability."
    ctaLabel="Schedule a Session"
    ctaHref={SCHEDULE_URL}
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
  />
</BaseLayout>

<SchemaOrg type="localBusiness" />
