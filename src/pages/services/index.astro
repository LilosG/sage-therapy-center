---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import TrustStrip from '../../components/sections/TrustStrip.astro';
import TelehealthHighlight from '../../components/sections/TelehealthHighlight.astro';
import ServiceGrid from '../../components/sections/ServiceGrid.astro';
import CTASection from '../../components/sections/CTASection.astro';
import SchemaOrg from '../../components/seo/SchemaOrg.astro';
import { site } from '../../data/site';
import { hubHeroImages } from '../../data/pageImages';
import { serviceIcons, defaultServiceIcon } from '../../data/serviceIcons';
import { SCHEDULE_URL, SERVICES_URL } from '../../data/nav';
import { serviceUrl } from '../../lib/routes';
import { staticBreadcrumbs } from '../../lib/breadcrumbs';

const services = await getCollection('services');
const coreServices = services.filter((s) => s.data.category === 'core');
const concernLedServices = services.filter((s) => s.data.category === 'concern-led');
const breadcrumbItems = staticBreadcrumbs('Services', SERVICES_URL);
---

<BaseLayout
  title="Therapy Services in Carlsbad, CA | S.A.G.E. Therapy Center"
  description="Explore individual, couples, family, teen, EMDR, anxiety, trauma-focused, and telehealth therapy options through S.A.G.E. Therapy Center in Carlsbad, CA."
  image={hubHeroImages.services}
>
  <PageHero
    eyebrow="Therapy Services"
    title="Therapy services in Carlsbad, CA"
    description="Explore individual, relationship, family, teen, and concern-focused therapy options with Kristin Moorehead-Malley, LMFT. Meet in person in Carlsbad or explore telehealth across California."
    breadcrumbItems={breadcrumbItems}
    ctaLabel="Explore Services"
    ctaHref="#services-directory"
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
    image={hubHeroImages.services}
    imageAlt="Quiet, refined courtyard setting representing the calm and private atmosphere of therapy at S.A.G.E. Therapy Center"
  />

  <TrustStrip />

  <TelehealthHighlight />

  <div id="services-directory" class="scroll-mt-24">
    <ServiceGrid
      eyebrow="Core Services"
      heading="Choose the kind of support that best matches what you are looking for"
      services={coreServices.map((s) => ({
        title: s.data.title,
        description: s.data.description,
        href: serviceUrl(s.data.slug),
        icon: serviceIcons[s.data.slug] ?? defaultServiceIcon,
      }))}
      variant="directory"
      background="background"
    />
  </div>

  {
    concernLedServices.length > 0 && (
      <ServiceGrid
        eyebrow="Areas of Support"
        heading="Therapy can also begin with a specific concern"
        services={concernLedServices.map((s) => ({
          title: s.data.title,
          description: s.data.description,
          href: serviceUrl(s.data.slug),
          icon: serviceIcons[s.data.slug] ?? defaultServiceIcon,
        }))}
        variant="directory"
        background="secondary"
      />
    )
  }

  <CTASection
    heading="Not sure which service fits?"
    subhead="You do not need to choose the perfect page before reaching out. Start with a conversation about what is bringing you in, fit, current availability, and whether you prefer in-person or telehealth sessions."
    ctaLabel="Schedule a Session"
    ctaHref={SCHEDULE_URL}
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
  />

  <SchemaOrg type="localBusiness" />
</BaseLayout>
