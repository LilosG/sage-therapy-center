---
import { getCollection, getEntries, render } from 'astro:content';
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import StructuredProse from '../../components/sections/StructuredProse.astro';
import SchemaOrg from '../../components/seo/SchemaOrg.astro';
import { site } from '../../data/site';
import { canonicalUrl, serviceUrl } from '../../lib/routes';

export async function getStaticPaths() {
  const entries = await getCollection('services');
  return entries.map((entry) => ({
    params: { service: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const related = entry.data.relatedServices.length ? await getEntries(entry.data.relatedServices) : [];
const pageUrl = canonicalUrl(serviceUrl(entry.data.slug));
---

<ServiceLayout entry={entry}>
  <div class="mx-auto max-w-3xl px-6 pb-4 pt-8">
    <StructuredProse class="mt-6">
      <Content />
    </StructuredProse>

    {
      related.length > 0 && (
        <div class="mt-10 border-t border-border pt-6">
          <p class="font-sans text-sm font-semibold text-ink">Related services</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {related.map((r) => (
              <li>
                <a
                  href={serviceUrl(r.data.slug)}
                  class="rounded-full border border-border bg-surface px-4 py-2 font-sans text-sm text-foreground hover:border-sage-deep hover:text-sage-deep"
                >
                  {r.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</ServiceLayout>

<SchemaOrg
  type="service"
  service={{
    name: entry.data.title,
    description: entry.data.description,
    serviceType: entry.data.primaryTarget,
    url: pageUrl,
    areaServed: site.address.city,
  }}
/>
