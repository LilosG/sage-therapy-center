---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import TrustStrip from '../../components/sections/TrustStrip.astro';
import AreasServed from '../../components/sections/AreasServed.astro';
import PracticeSection from '../../components/sections/PracticeSection.astro';
import CTASection from '../../components/sections/CTASection.astro';
import SchemaOrg from '../../components/seo/SchemaOrg.astro';
import { site } from '../../data/site';
import { hubHeroImages } from '../../data/pageImages';
import { AREAS_WE_SERVE_URL, SCHEDULE_URL } from '../../data/nav';
import { cityUrl } from '../../lib/routes';
import { staticBreadcrumbs } from '../../lib/breadcrumbs';

const cities = await getCollection('cities');
const breadcrumbItems = staticBreadcrumbs('Areas We Serve', AREAS_WE_SERVE_URL);
---

<BaseLayout
  title="Therapy in Carlsbad & North County San Diego | S.A.G.E. Therapy Center"
  description="S.A.G.E. Therapy Center is based in Carlsbad, CA and serves clients from North County San Diego, with telehealth available across California."
  image={hubHeroImages.areas}
>
  <PageHero
    eyebrow="Areas We Serve"
    title="Therapy for Carlsbad and North County San Diego"
    description="S.A.G.E.'s only physical office is in Carlsbad. Clients from nearby North County communities can meet there in person, while telehealth is available across California."
    breadcrumbItems={breadcrumbItems}
    ctaLabel="Explore Areas"
    ctaHref="#service-areas"
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
    image={hubHeroImages.areas}
    imageAlt="Soft Southern California eucalyptus landscape representing the North County communities served by S.A.G.E. Therapy Center"
  />

  <TrustStrip />

  <div id="service-areas" class="scroll-mt-24">
    <AreasServed
      eyebrow="North County Communities"
      heading="Choose your community"
      cities={cities.map((c) => ({ name: c.data.name, href: cityUrl(c.data.slug) }))}
      variant="compact"
    />
  </div>

  <PracticeSection />

  <CTASection
    heading="Not sure whether your location works?"
    subhead="Reach out to discuss in-person availability at the Carlsbad office or telehealth anywhere in California."
    ctaLabel="Schedule a Session"
    ctaHref={SCHEDULE_URL}
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
  />

  <SchemaOrg type="localBusiness" />
</BaseLayout>
