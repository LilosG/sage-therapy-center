---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import FAQAccordion from '../../components/sections/FAQAccordion.astro';
import CTASection from '../../components/sections/CTASection.astro';
import { site } from '../../data/site';

// Fee/insurance questions are intentionally not included: the SEO doc's
// Wave 0 blockers say payment/insurance policy must be confirmed before
// any fee-related FAQ content is published.
const faqs = await getCollection('faq');
---

<BaseLayout
  title="FAQ | S.A.G.E. Therapy Center"
  description="Answers to common questions about starting therapy with S.A.G.E. Therapy Center in Carlsbad, CA."
>
  <PageHero
    eyebrow="FAQ"
    title="Frequently asked questions"
    breadcrumbItems={[{ name: 'Home', url: '/' }, { name: 'FAQ', url: '/faq/' }]}
  />

  <FAQAccordion heading="Common questions" items={faqs.map((f) => ({ q: f.data.q, a: f.data.a }))} />

  <CTASection
    heading="Still have questions?"
    subhead="Reach out — we're happy to help."
    ctaLabel="Contact Us"
    ctaHref="/contact/"
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
  />
</BaseLayout>
