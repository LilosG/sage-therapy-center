---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import TrustStrip from '../../components/sections/TrustStrip.astro';
import PageFaqs from '../../components/sections/PageFaqs.astro';
import CTASection from '../../components/sections/CTASection.astro';
import { site } from '../../data/site';
import { faqHubSupplemental } from '../../data/faqHubSupplemental';
import { editorialImages, getHeroImageAlt } from '../../data/pageImages';
import { CONTACT_URL, FAQ_URL } from '../../data/nav';
import { staticBreadcrumbs } from '../../lib/breadcrumbs';

const faqs = await getCollection('faq');
const authoredFaqs = faqs.map((faq) => ({ q: faq.data.q, a: faq.data.a }));
const seenQuestions = new Set<string>();
const faqItems = [...authoredFaqs, ...faqHubSupplemental].filter((item) => {
  const key = item.q.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
  if (seenQuestions.has(key)) return false;
  seenQuestions.add(key);
  return true;
});
const heroImage = editorialImages.meadowTree;
---

<BaseLayout
  title="Therapy FAQ | S.A.G.E. Therapy Center, Carlsbad CA"
  description="Answers to common questions about starting therapy with S.A.G.E. Therapy Center in Carlsbad, CA, including session options, fit, and getting started."
  image={heroImage}
>
  <PageHero
    eyebrow="Carlsbad Therapy FAQ"
    title="Questions about starting therapy with S.A.G.E."
    description="Find practical information about therapy at the Carlsbad office, telehealth across California, and getting started with Kristin Moorehead-Malley, LMFT."
    breadcrumbItems={staticBreadcrumbs('FAQ', FAQ_URL)}
    ctaLabel="Ask a Question"
    ctaHref={CONTACT_URL}
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
    image={heroImage}
    imageAlt={getHeroImageAlt(heroImage)}
  />

  <TrustStrip />

  <PageFaqs heading="Common questions about therapy at S.A.G.E. Therapy Center" items={faqItems} background="background" />

  <CTASection
    heading="Still have a question about therapy in Carlsbad or telehealth?"
    subhead="Reach out about fit, availability, or session options without needing to share sensitive clinical details."
    ctaLabel="Contact S.A.G.E."
    ctaHref={CONTACT_URL}
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
  />
</BaseLayout>
