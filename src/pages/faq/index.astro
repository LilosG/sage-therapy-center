---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import FAQAccordion from '../../components/sections/FAQAccordion.astro';
import CTASection from '../../components/sections/CTASection.astro';
import { site } from '../../data/site';

// Fee/insurance questions are intentionally not included: the SEO doc's
// Wave 0 blockers say payment/insurance policy must be confirmed before
// any fee-related FAQ content is published.
const faqs = await getCollection('faq');

// The telehealth question's answer must stay in sync with TrustStrip's
// telehealth stat — both read site.telehealth.confirmRequired rather than
// asserting a coverage claim independently (see src/data/site.ts).
const faqItems = faqs.map((f) =>
  f.id === 'session-format'
    ? {
        q: f.data.q,
        a: site.telehealth.confirmRequired
          ? f.data.a
          : `Yes — telehealth is available across ${site.telehealth.coverageArea}, alongside in-person sessions.`,
      }
    : { q: f.data.q, a: f.data.a }
);
---

<BaseLayout
  title="FAQ | S.A.G.E. Therapy Center"
  description="Answers to common questions about starting therapy with S.A.G.E. Therapy Center in Carlsbad, CA."
>
  <PageHero
    eyebrow="FAQ"
    title="Frequently asked questions"
    breadcrumbItems={[{ name: 'Home', url: '/' }, { name: 'FAQ', url: '/faq/' }]}
  />

  <FAQAccordion heading="Common questions" items={faqItems} />

  <CTASection
    heading="Still have questions?"
    subhead="Reach out — we're happy to help."
    ctaLabel="Contact Us"
    ctaHref="/contact/"
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
  />
</BaseLayout>
