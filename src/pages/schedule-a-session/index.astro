---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import TrustStrip from '../../components/sections/TrustStrip.astro';
import DecisionSection from '../../components/sections/DecisionSection.astro';
import InquiryFormSection from '../../components/sections/InquiryFormSection.astro';
import SchemaOrg from '../../components/seo/SchemaOrg.astro';
import { site } from '../../data/site';
import { editorialImages } from '../../data/pageImages';
import { SCHEDULE_URL } from '../../data/nav';
import { staticBreadcrumbs } from '../../lib/breadcrumbs';

const decisionItems = [
  {
    q: 'What happens after I reach out?',
    a: 'Your request is used to discuss fit, current availability, and the session option that makes the most sense before anything is scheduled.',
  },
  {
    q: 'Where are sessions available?',
    a: 'In-person sessions are based at the Carlsbad office, with telehealth available to clients across California.',
  },
  {
    q: 'How much do I need to explain in the form?',
    a: 'Only enough for scheduling and fit. The form is intentionally brief and asks you not to include sensitive clinical or medical details.',
  },
  {
    q: 'Can I call instead?',
    a: `Yes. You can call S.A.G.E. directly at ${site.phone.display} if you would rather start by phone.`,
  },
];
---

<BaseLayout
  title="Schedule a Session | S.A.G.E. Therapy Center"
  description="Request a therapy session with S.A.G.E. Therapy Center in Carlsbad, CA. Discuss fit, availability, in-person sessions, or telehealth across California."
  image={editorialImages.windowNook}
>
  <PageHero
    eyebrow="Schedule a Session"
    title="Start with a simple request"
    description={`Reach out to discuss fit and availability with ${site.practitioner.name}, ${site.practitioner.credential}. You do not need to explain your full story before getting started.`}
    breadcrumbItems={staticBreadcrumbs('Schedule a Session', SCHEDULE_URL)}
    ctaLabel="Go to Request Form"
    ctaHref="#request-session"
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
    image={editorialImages.windowNook}
    imageAlt="Quiet sunlit interior reflecting the private, supportive setting of S.A.G.E. Therapy Center"
  />

  <TrustStrip />

  <DecisionSection
    eyebrow="Before You Reach Out"
    heading="A few things to know about getting started"
    items={decisionItems}
  />

  <InquiryFormSection
    context="Schedule a Session"
    heading="Request a follow-up about fit and availability"
    subhead="Choose the best way to reach you, the kind of support you are looking for, and whether you prefer in-person or telehealth sessions."
  />

  <SchemaOrg type="localBusiness" />
</BaseLayout>
