---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import TrustStrip from '../../components/sections/TrustStrip.astro';
import PageFaqs from '../../components/sections/PageFaqs.astro';
import InquiryFormSection from '../../components/sections/InquiryFormSection.astro';
import SchemaOrg from '../../components/seo/SchemaOrg.astro';
import { site } from '../../data/site';
import { hubHeroImages, getHeroImageAlt } from '../../data/pageImages';
import { schedulePageFaqs } from '../../lib/pageFaqs';
import { SCHEDULE_URL } from '../../data/nav';
import { staticBreadcrumbs } from '../../lib/breadcrumbs';
---

<BaseLayout
  title="Schedule a Therapy Session | S.A.G.E. Therapy Center, Carlsbad CA"
  description="Request a therapy session with S.A.G.E. Therapy Center in Carlsbad, CA. Discuss fit, availability, in-person sessions, or telehealth across California."
  image={hubHeroImages.schedule}
>
  <PageHero
    eyebrow="Schedule Therapy in Carlsbad"
    title="Request a therapy session with S.A.G.E."
    description={`Reach out to discuss fit and availability with ${site.practitioner.name}, ${site.practitioner.credential}. Choose in-person sessions in Carlsbad or ask about telehealth across California.`}
    breadcrumbItems={staticBreadcrumbs('Schedule a Session', SCHEDULE_URL)}
    ctaLabel="Go to Request Form"
    ctaHref="#request-session"
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
    image={hubHeroImages.schedule}
    imageAlt={getHeroImageAlt(hubHeroImages.schedule)}
  />

  <TrustStrip />

  <PageFaqs heading="Scheduling therapy with S.A.G.E.: common questions" items={schedulePageFaqs} background="surface" />

  <InquiryFormSection
    context="Schedule a Session — Carlsbad Therapy"
    heading="Request a follow-up about fit and availability"
    subhead="Choose the best way to reach you, the kind of support you are looking for, and whether you prefer in-person or telehealth sessions."
  />

  <SchemaOrg type="localBusiness" />
</BaseLayout>
