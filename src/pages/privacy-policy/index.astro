---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import { site } from '../../data/site';
import { editorialImages, getHeroImageAlt } from '../../data/pageImages';
import { staticBreadcrumbs } from '../../lib/breadcrumbs';

const heroImage = editorialImages.coastalPath;
const lastUpdated = 'August 2026';
---

<BaseLayout
  title="Privacy Policy | S.A.G.E. Therapy Center"
  description="Privacy policy for S.A.G.E. Therapy Center — how we collect, use, and protect information submitted through this website."
>
  <PageHero
    eyebrow="S.A.G.E. Therapy Center"
    title="Privacy Policy"
    breadcrumbItems={staticBreadcrumbs('Privacy Policy', '/privacy-policy/')}
    image={heroImage}
    imageAlt={getHeroImageAlt(heroImage)}
  />

  <article class="mx-auto max-w-3xl px-6 pb-14 pt-10">
    <div class="prose max-w-none font-sans text-foreground">
      <p class="text-sm text-muted-foreground">Last updated: {lastUpdated}</p>

      <h2>Overview</h2>
      <p>
        This Privacy Policy describes how {site.name} ("we," "us," or "our"), operated by {site.practitioner.name}, {site.practitioner.credential}, collects, uses, and protects information you provide when you visit this website or submit a session request.
      </p>
      <p>
        This website is intended as general information about our therapy practice. It is not a crisis service. If you are in crisis, please contact the 988 Suicide & Crisis Lifeline by calling or texting 988, or go to your nearest emergency room.
      </p>

      <h2>Information We Collect</h2>
      <p>We collect information you voluntarily provide, including:</p>
      <ul>
        <li>Your name, email address, and phone number when you submit a session request</li>
        <li>Any additional details you include in your message (service interest, session preference, questions)</li>
      </ul>
      <p>
        We do not collect sensitive health or clinical information through this website. Any clinical information shared once therapy begins is governed by our practice's Notice of Privacy Practices and applicable state and federal law, not this policy.
      </p>
      <p>
        We may also collect non-personally identifiable usage data through analytics tools (such as Vercel Analytics) to understand how visitors interact with the site. This data does not identify you individually.
      </p>

      <h2>How We Use Your Information</h2>
      <p>Information you submit through the session request form is used solely to:</p>
      <ul>
        <li>Respond to your inquiry about therapy services</li>
        <li>Discuss availability, fit, and next steps for scheduling</li>
      </ul>
      <p>We do not sell, rent, or share your contact information with third parties for marketing purposes.</p>

      <h2>How We Protect Your Information</h2>
      <p>
        Session request submissions are transmitted to our practice email using a third-party email delivery service (Resend). While we take reasonable measures to protect information in transit, no internet transmission is completely secure. Do not submit sensitive clinical or crisis information through this web form.
      </p>

      <h2>Cookies and Tracking</h2>
      <p>
        This website may use cookies or similar technologies for analytics purposes. These tools help us understand general traffic patterns. You may adjust cookie settings in your browser at any time.
      </p>

      <h2>Third-Party Links</h2>
      <p>
        This site may link to external resources (Psychology Today, SimplePractice scheduling, etc.). We are not responsible for the privacy practices of those sites and encourage you to review their policies independently.
      </p>

      <h2>California Residents</h2>
      <p>
        Visitors in California may have additional rights under the California Consumer Privacy Act (CCPA). Because we collect minimal personal data and do not sell it, most CCPA obligations do not apply to our practice. For questions about your data, contact us at <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about this policy can be directed to:<br />
        {site.practitioner.name}, {site.practitioner.credential}<br />
        {site.name}<br />
        <a href={`mailto:${site.email}`}>{site.email}</a><br />
        {site.phone.display}
      </p>
    </div>
  </article>
</BaseLayout>
