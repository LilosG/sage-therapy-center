---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import TrustStrip from '../../components/sections/TrustStrip.astro';
import DirectContactSection from '../../components/sections/DirectContactSection.astro';
import PracticeSection from '../../components/sections/PracticeSection.astro';
import PageFaqs from '../../components/sections/PageFaqs.astro';
import InquiryFormSection from '../../components/sections/InquiryFormSection.astro';
import SchemaOrg from '../../components/seo/SchemaOrg.astro';
import { site } from '../../data/site';
import { editorialImages, getHeroImageAlt } from '../../data/pageImages';
import { contactPageFaqs } from '../../lib/pageFaqs';
import { CONTACT_URL } from '../../data/nav';
import { staticBreadcrumbs } from '../../lib/breadcrumbs';

const heroImage = editorialImages.coastalPath;
---

<BaseLayout
  title="Contact S.A.G.E. Therapy Center | Carlsbad, CA"
  description={`Contact S.A.G.E. Therapy Center in ${site.address.city}, ${site.address.region} by phone, email, or online request form. In-person sessions in Carlsbad and telehealth across California.`}
  image={heroImage}
>
  <PageHero
    eyebrow="Contact S.A.G.E. in Carlsbad"
    title="Contact S.A.G.E. Therapy Center in Carlsbad, CA"
    description="Reach out about fit, current availability, in-person sessions at the Carlsbad office, or telehealth across California."
    breadcrumbItems={staticBreadcrumbs('Contact', CONTACT_URL)}
    ctaLabel="Send a Request"
    ctaHref="#request-session"
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
    image={heroImage}
    imageAlt={getHeroImageAlt(heroImage)}
  />

  <TrustStrip />

  <DirectContactSection />

  <PracticeSection />

  <PageFaqs heading="Contacting S.A.G.E. Therapy Center: common questions" items={contactPageFaqs} background="surface" />

  <InquiryFormSection
    context="Contact Page — Carlsbad"
    heading="Send a simple request to S.A.G.E. Therapy Center"
    subhead="Share the best way to reach you and what kind of support you are looking for. You do not need to include sensitive clinical details."
  />

  <SchemaOrg type="localBusiness" />
</BaseLayout>
