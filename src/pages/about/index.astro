---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import TrustStrip from '../../components/sections/TrustStrip.astro';
import MeetKristin from '../../components/sections/MeetKristin.astro';
import PhilosophySection from '../../components/sections/PhilosophySection.astro';
import ProcessSteps from '../../components/sections/ProcessSteps.astro';
import PageFaqs from '../../components/sections/PageFaqs.astro';
import CTASection from '../../components/sections/CTASection.astro';
import SchemaOrg from '../../components/seo/SchemaOrg.astro';
import { site } from '../../data/site';
import { practitioner } from '../../data/practitioner';
import { editorialImages, getHeroImageAlt } from '../../data/pageImages';
import { aboutPageFaqs } from '../../lib/pageFaqs';
import { ABOUT_URL, SCHEDULE_URL } from '../../data/nav';
import { staticBreadcrumbs } from '../../lib/breadcrumbs';
import kristinPhoto from '../../assets/images/kristin-moorehead-malley.webp';

const heroImage = editorialImages.meadowTree;
---

<BaseLayout
  title={`About ${site.practitioner.name}, ${site.practitioner.credential} | Carlsbad Therapist`}
  description={`Meet ${site.practitioner.name}, ${site.practitioner.credential}, and learn about the individualized therapy approach behind S.A.G.E. Therapy Center in Carlsbad, CA.`}
  image={heroImage}
>
  <PageHero
    eyebrow="Carlsbad Therapist"
    title={`Meet ${site.practitioner.name}, ${site.practitioner.credential}`}
    description="A Carlsbad-based therapist drawing from multiple approaches so therapy can respond to the person, relationship, family, and circumstances in front of her."
    breadcrumbItems={staticBreadcrumbs('About', ABOUT_URL)}
    ctaLabel="Schedule a Session"
    ctaHref={SCHEDULE_URL}
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
    image={heroImage}
    imageAlt={getHeroImageAlt(heroImage)}
  />

  <TrustStrip />

  <MeetKristin
    name={practitioner.name}
    credential={practitioner.credential}
    bio={practitioner.aboutBio}
    modalities={practitioner.modalities}
    ctaLabel="Schedule a Session"
    ctaHref={SCHEDULE_URL}
    image={kristinPhoto}
  />

  <PhilosophySection
    heading="Therapy should fit the person — not force the person into one method."
    body="S.A.G.E. stands for Self-Awareness, Growth, and Enlightenment. Kristin draws from multiple therapeutic approaches so the work can adapt as your needs, relationships, circumstances, and goals become clearer."
    quote="Therapy is a lot like climbing Everest."
    attribution={`${site.practitioner.name}, ${site.practitioner.credential}`}
    items={practitioner.modalities}
  />

  <ProcessSteps
    eyebrow="Working With Kristin in Carlsbad"
    heading="What getting started with S.A.G.E. Therapy Center can look like"
    steps={[
      { title: 'Reach out', body: 'Request a session to discuss what you are looking for, fit, and current availability.' },
      { title: 'First session', body: 'Begin with what is bringing you in and what you would like support understanding or changing.' },
      { title: 'Ongoing work', body: 'Continue with an approach and pace that can evolve as the work becomes clearer.' },
    ]}
  />

  <PageFaqs heading={`About ${site.practitioner.name}: common questions`} items={aboutPageFaqs} background="surface" />

  <CTASection
    heading="Ready to see if working with Kristin may be a fit?"
    subhead="Start with a simple request about availability and session options in Carlsbad or by telehealth."
    ctaLabel="Schedule a Session"
    ctaHref={SCHEDULE_URL}
    phoneDisplay={site.phone.display}
    phoneHref={`tel:${site.phone.tel}`}
  />

  <SchemaOrg type="person" />
</BaseLayout>
