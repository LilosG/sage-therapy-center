---
// JSON-LD emitter per Build Spec Section 7. Every node that represents the
// business reuses the same @id (site.canonicalOrigin + "/#business") —
// never a new node per page — per the SEO doc's schema plan ("Do not
// duplicate competing business nodes with different @id values").
import { site } from '../../data/site';

type SchemaType = 'organization' | 'localBusiness' | 'service' | 'city' | 'faqPage' | 'person';

interface ServiceProps {
  name: string;
  description: string;
  serviceType: string;
  url: string;
  areaServed?: string;
  audience?: string;
  // Only rendered once site.offersConfirmed is true AND an offer is
  // supplied. Do not populate until payment/insurance policy is confirmed
  // (SEO doc Wave 0 blocker) — this keeps `offers` a one-line flip later
  // rather than a re-implementation.
  offer?: { price?: string; priceCurrency?: string };
}

interface CityProps {
  name: string;
  url: string;
  areaServed: string;
}

interface FaqItem {
  q: string;
  a: string;
}

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface ReviewData {
  authorName: string;
  rating: number | null;
  text: string;
  publishTime: string | null;
}

interface ReviewsProps {
  rating: number;
  reviewCount: number;
  // Optional: buildCity()'s LocalBusiness reference node only ever wants
  // aggregateRating (no per-review data on a city page), so this prop is
  // shared between type="organization" (full review array) and
  // type="city" (rating/reviewCount only) rather than duplicating the
  // interface.
  reviews?: ReviewData[];
}

interface Props {
  type: SchemaType;
  service?: ServiceProps;
  city?: CityProps;
  faqItems?: FaqItem[];
  breadcrumb?: BreadcrumbItem[];
  // Populated from the same live Places API data as ReviewsSection (Wave
  // 9 — docs/WAVE_9_LIVE_REVIEWS.md) — only ever passed when every
  // underlying review is genuine and currently live, per the SEO doc's
  // review-schema condition.
  reviewsData?: ReviewsProps;
}

const { type, service, city, faqItems, breadcrumb, reviewsData } = Astro.props;

const businessId = `${site.canonicalOrigin}/#business`;
const personId = `${site.canonicalOrigin}/#kristin`;

function businessRef() {
  return { '@id': businessId };
}

function breadcrumbList(items: BreadcrumbItem[]) {
  return {
    '@type': 'BreadcrumbList',
    itemListElement: items.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: item.name,
      item: item.url,
    })),
  };
}

function buildOrganization() {
  return {
    '@context': 'https://schema.org',
    // CONFIRM: LocalBusiness vs MedicalBusiness (or a more specific medical
    // subtype) needs a legal-appropriateness confirmation per the SEO doc's
    // schema plan before this is treated as final.
    '@type': ['Organization', 'LocalBusiness'],
    '@id': businessId,
    name: site.name,
    url: site.canonicalOrigin,
    telephone: site.phone.tel,
    email: site.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      addressLocality: site.address.city,
      addressRegion: site.address.region,
      postalCode: site.address.postalCode,
      addressCountry: site.address.country,
    },
    sameAs: Object.values(site.social),
    ...(site.hours
      ? {
          openingHoursSpecification: site.hours.map((h) => ({
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: h.day,
            opens: h.open,
            closes: h.close,
          })),
        }
      : {}),
    ...(reviewsData
      ? {
          aggregateRating: {
            '@type': 'AggregateRating',
            ratingValue: reviewsData.rating,
            reviewCount: reviewsData.reviewCount,
          },
          ...(reviewsData.reviews
            ? {
                review: reviewsData.reviews.map((r) => ({
                  '@type': 'Review',
                  author: { '@type': 'Person', name: r.authorName },
                  reviewRating: { '@type': 'Rating', ratingValue: r.rating },
                  reviewBody: r.text,
                  ...(r.publishTime ? { datePublished: r.publishTime } : {}),
                })),
              }
            : {}),
        }
      : {}),
  };
}

function buildLocalBusinessReference() {
  // A reference node only — reuses the business @id, does not redeclare
  // the full Organization/LocalBusiness node. For use on pages other than
  // the homepage (e.g. city pages), per Build Spec Section 7.
  return {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    ...businessRef(),
  };
}

function buildPerson() {
  return {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': personId,
    name: site.practitioner.name,
    honorificSuffix: site.practitioner.credential,
    jobTitle: 'Licensed Marriage and Family Therapist',
    // Gated the same way `offers` is gated behind offersConfirmed: the SEO
    // doc's Wave 0 blocker list says the license number needs Kristin's
    // direct confirmation before it "goes live in schema," despite being
    // sourced from her own existing bio copy. Do not emit it here until
    // site.practitioner.licenseConfirmRequired is flipped to false.
    ...(site.practitioner.licenseConfirmRequired
      ? {}
      : { identifier: `CA LIC# ${site.practitioner.licenseNumber}` }),
    worksFor: businessRef(),
  };
}

function buildService() {
  if (!service) return null;
  return {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${service.url}#service`,
    name: service.name,
    description: service.description,
    serviceType: service.serviceType,
    url: service.url,
    provider: businessRef(),
    ...(service.areaServed ? { areaServed: service.areaServed } : {}),
    ...(service.audience
      ? { audience: { '@type': 'Audience', audienceType: service.audience } }
      : {}),
    ...(site.offersConfirmed && service.offer
      ? {
          offers: {
            '@type': 'Offer',
            price: service.offer.price,
            priceCurrency: service.offer.priceCurrency,
          },
        }
      : {}),
  };
}

function buildCity() {
  if (!city) return null;
  // Doc requirement: never fabricate a branch address for a city without
  // an office — this node intentionally carries no PostalAddress of its
  // own, only a reference to the single business node.
  return {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebPage',
        '@id': `${city.url}#webpage`,
        name: city.name,
        url: city.url,
        about: businessRef(),
        ...(breadcrumb ? { breadcrumb: breadcrumbList(breadcrumb) } : {}),
      },
      ...(breadcrumb ? [{ '@id': `${city.url}#breadcrumb`, ...breadcrumbList(breadcrumb) }] : []),
      {
        '@type': 'LocalBusiness',
        ...businessRef(),
        areaServed: { '@type': 'City', name: city.areaServed },
        ...(reviewsData
          ? {
              aggregateRating: {
                '@type': 'AggregateRating',
                ratingValue: reviewsData.rating,
                reviewCount: reviewsData.reviewCount,
              },
            }
          : {}),
      },
    ],
  };
}

function buildFaqPage() {
  if (!faqItems || faqItems.length === 0) return null;
  return {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  };
}

const schema = {
  organization: buildOrganization,
  localBusiness: buildLocalBusinessReference,
  service: buildService,
  city: buildCity,
  faqPage: buildFaqPage,
  person: buildPerson,
}[type]();
---

{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
