---
// Central JSON-LD emitter. All business/provider references reuse stable @ids
// so page-specific entities resolve to the same S.A.G.E. business and Kristin
// entities instead of inventing separate local businesses for every city page.
import { site } from '../../data/site';
import googleReviews from '../../data/google-reviews.json';

type SchemaType = 'website' | 'organization' | 'localBusiness' | 'service' | 'city' | 'faqPage' | 'person' | 'article';

interface ServiceProps {
  name: string;
  description: string;
  serviceType: string;
  url: string;
  areaServed?: string;
  audience?: string;
  offer?: { price?: string; priceCurrency?: string };
}

interface CityProps {
  name: string;
  pageName?: string;
  url: string;
  areaServed: string;
}

interface ArticleProps {
  headline: string;
  description: string;
  url: string;
  datePublished: string;
  dateModified?: string;
}

interface FaqItem {
  q: string;
  a: string;
}

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  type: SchemaType;
  service?: ServiceProps;
  city?: CityProps;
  article?: ArticleProps;
  faqItems?: FaqItem[];
  breadcrumb?: BreadcrumbItem[];
}

const { type, service, city, article, faqItems, breadcrumb } = Astro.props;

const businessId = `${site.canonicalOrigin}/#business`;
const personId = `${site.canonicalOrigin}/#kristin`;
const websiteId = `${site.canonicalOrigin}/#website`;
const currentPageUrl = new URL(Astro.url.pathname, site.canonicalOrigin).toString();
const currentPageId = `${currentPageUrl}#webpage`;

function businessRef() {
  return { '@id': businessId };
}

function personRef() {
  return { '@id': personId };
}

function businessNode() {
  return {
    '@type': ['ProfessionalService', 'LocalBusiness'],
    '@id': businessId,
    name: site.name,
    url: `${site.canonicalOrigin}/`,
    telephone: site.phone.tel,
    email: site.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      addressLocality: site.address.city,
      addressRegion: site.address.region,
      postalCode: site.address.postalCode,
      addressCountry: site.address.country,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: site.address.geo.latitude,
      longitude: site.address.geo.longitude,
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: googleReviews.rating,
      reviewCount: googleReviews.userRatingCount,
    },
    sameAs: Object.values(site.social),
    ...(site.hours
      ? {
          openingHoursSpecification: site.hours.map((h) => ({
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: h.day,
            opens: h.open,
            closes: h.close,
          })),
        }
      : {}),
  };
}

function personNode() {
  return {
    '@type': 'Person',
    '@id': personId,
    name: site.practitioner.name,
    honorificSuffix: site.practitioner.credential,
    jobTitle: 'Licensed Marriage and Family Therapist',
    url: `${site.canonicalOrigin}/about/`,
    ...(site.practitioner.licenseConfirmRequired
      ? {}
      : { identifier: `CA LIC# ${site.practitioner.licenseNumber}` }),
    worksFor: businessRef(),
  };
}

function breadcrumbList(items: BreadcrumbItem[]) {
  return {
    '@type': 'BreadcrumbList',
    itemListElement: items.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: item.name,
      item: item.url,
    })),
  };
}

function areaEntity(name: string) {
  if (name === site.telehealth.coverageArea) return { '@type': 'State', name };
  return { '@type': 'City', name };
}

function buildWebsite() {
  return {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': websiteId,
    url: `${site.canonicalOrigin}/`,
    name: site.name,
    alternateName: ['S.A.G.E. Therapy Center', 'SAGE Therapy Center'],
    publisher: businessRef(),
  };
}

function buildOrganization() {
  return {
    '@context': 'https://schema.org',
    ...businessNode(),
  };
}

function buildLocalBusiness() {
  return buildOrganization();
}

function buildPerson() {
  return {
    '@context': 'https://schema.org',
    '@graph': [businessNode(), personNode()],
  };
}

function buildService() {
  if (!service) return null;
  const serviceId = `${service.url}#service`;
  const pageId = `${service.url}#webpage`;
  const breadcrumbId = `${service.url}#breadcrumb`;

  return {
    '@context': 'https://schema.org',
    '@graph': [
      businessNode(),
      personNode(),
      {
        '@type': 'Service',
        '@id': serviceId,
        name: service.name,
        description: service.description,
        serviceType: service.serviceType,
        url: service.url,
        provider: businessRef(),
        ...(service.areaServed
        ? {
            areaServed:
              service.areaServed === site.telehealth.coverageArea
                ? areaEntity(service.areaServed)
                : [areaEntity(service.areaServed), areaEntity(site.telehealth.coverageArea)],
          }
        : {}),
        ...(service.audience
          ? { audience: { '@type': 'Audience', audienceType: service.audience } }
          : {}),
        ...(site.offersConfirmed && service.offer
          ? {
              offers: {
                '@type': 'Offer',
                price: service.offer.price,
                priceCurrency: service.offer.priceCurrency,
              },
            }
          : {}),
      },
      {
        '@type': 'WebPage',
        '@id': pageId,
        url: service.url,
        name: service.name,
        description: service.description,
        isPartOf: { '@id': websiteId },
        about: { '@id': serviceId },
        ...(breadcrumb ? { breadcrumb: { '@id': breadcrumbId } } : {}),
      },
      ...(breadcrumb ? [{ '@id': breadcrumbId, ...breadcrumbList(breadcrumb) }] : []),
    ],
  };
}

function buildCity() {
  if (!city) return null;
  const breadcrumbId = `${city.url}#breadcrumb`;
  return {
    '@context': 'https://schema.org',
    '@graph': [
      businessNode(),
      personNode(),
      {
        '@type': 'WebPage',
        '@id': `${city.url}#webpage`,
        name: city.pageName ?? `Therapy serving ${city.name}`,
        url: city.url,
        isPartOf: { '@id': websiteId },
        about: businessRef(),
        spatialCoverage: { '@type': 'City', name: city.areaServed },
        ...(breadcrumb ? { breadcrumb: { '@id': breadcrumbId } } : {}),
      },
      ...(breadcrumb ? [{ '@id': breadcrumbId, ...breadcrumbList(breadcrumb) }] : []),
    ],
  };
}

function buildFaqPage() {
  if (!faqItems || faqItems.length === 0) return null;

  return {
    '@context': 'https://schema.org',
    // Reuse the canonical WebPage @id used by service/city schema. JSON-LD
    // processors can merge these declarations into one page entity instead of
    // treating the FAQ section as a competing standalone page.
    '@type': ['WebPage', 'FAQPage'],
    '@id': currentPageId,
    url: currentPageUrl,
    inLanguage: site.locale,
    isPartOf: { '@id': websiteId },
    publisher: businessRef(),
    mainEntity: faqItems.map((item, index) => ({
      '@type': 'Question',
      '@id': `${currentPageUrl}#faq-question-${index + 1}`,
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        '@id': `${currentPageUrl}#faq-answer-${index + 1}`,
        text: item.a,
      },
    })),
  };
}

function buildArticle() {
  if (!article) return null;
  const breadcrumbId = `${article.url}#breadcrumb`;
  return {
    '@context': 'https://schema.org',
    '@graph': [
      businessNode(),
      personNode(),
      {
        '@type': 'Article',
        '@id': `${article.url}#article`,
        headline: article.headline,
        description: article.description,
        url: article.url,
        mainEntityOfPage: { '@id': `${article.url}#webpage` },
        author: personRef(),
        publisher: businessRef(),
        datePublished: article.datePublished,
        ...(article.dateModified ? { dateModified: article.dateModified } : {}),
      },
      {
        '@type': 'WebPage',
        '@id': `${article.url}#webpage`,
        url: article.url,
        name: article.headline,
        description: article.description,
        isPartOf: { '@id': websiteId },
        about: { '@id': `${article.url}#article` },
        ...(breadcrumb ? { breadcrumb: { '@id': breadcrumbId } } : {}),
      },
      ...(breadcrumb ? [{ '@id': breadcrumbId, ...breadcrumbList(breadcrumb) }] : []),
    ],
  };
}

const schema = {
  website: buildWebsite,
  organization: buildOrganization,
  localBusiness: buildLocalBusiness,
  service: buildService,
  city: buildCity,
  faqPage: buildFaqPage,
  person: buildPerson,
  article: buildArticle,
}[type]();
---

{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
