---
// Central JSON-LD emitter. Business entities always reuse the same @id so
// Organization/LocalBusiness/Person/Service references resolve to one entity
// graph instead of creating competing business nodes on individual pages.
import { site } from '../../data/site';

type SchemaType = 'website' | 'organization' | 'localBusiness' | 'service' | 'city' | 'faqPage' | 'person';

interface ServiceProps {
  name: string;
  description: string;
  serviceType: string;
  url: string;
  areaServed?: string;
  audience?: string;
  offer?: { price?: string; priceCurrency?: string };
}

interface CityProps {
  name: string;
  url: string;
  areaServed: string;
}

interface FaqItem {
  q: string;
  a: string;
}

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  type: SchemaType;
  service?: ServiceProps;
  city?: CityProps;
  faqItems?: FaqItem[];
  breadcrumb?: BreadcrumbItem[];
}

const { type, service, city, faqItems, breadcrumb } = Astro.props;

const businessId = `${site.canonicalOrigin}/#business`;
const personId = `${site.canonicalOrigin}/#kristin`;
const websiteId = `${site.canonicalOrigin}/#website`;

function businessRef() {
  return { '@id': businessId };
}

function breadcrumbList(items: BreadcrumbItem[]) {
  return {
    '@type': 'BreadcrumbList',
    itemListElement: items.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: item.name,
      item: item.url,
    })),
  };
}

function buildWebsite() {
  return {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': websiteId,
    url: `${site.canonicalOrigin}/`,
    name: site.name,
    alternateName: ['S.A.G.E. Therapy Center', 'SAGE Therapy Center'],
    publisher: businessRef(),
  };
}

function buildOrganization() {
  return {
    '@context': 'https://schema.org',
    // Keep the broad LocalBusiness type until a more specific medical
    // subtype has been explicitly validated for this practice. The verified
    // GBP primary category remains centralized in site data but is not forced
    // into JSON-LD as a non-domain `category` property on LocalBusiness.
    '@type': ['Organization', 'LocalBusiness'],
    '@id': businessId,
    name: site.name,
    url: site.canonicalOrigin,
    telephone: site.phone.tel,
    email: site.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      addressLocality: site.address.city,
      addressRegion: site.address.region,
      postalCode: site.address.postalCode,
      addressCountry: site.address.country,
    },
    sameAs: Object.values(site.social),
    ...(site.hours
      ? {
          openingHoursSpecification: site.hours.map((h) => ({
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: h.day,
            opens: h.open,
            closes: h.close,
          })),
        }
      : {}),
  };
}

function buildLocalBusinessReference() {
  return {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    ...businessRef(),
  };
}

function buildPerson() {
  return {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': personId,
    name: site.practitioner.name,
    honorificSuffix: site.practitioner.credential,
    jobTitle: 'Licensed Marriage and Family Therapist',
    ...(site.practitioner.licenseConfirmRequired
      ? {}
      : { identifier: `CA LIC# ${site.practitioner.licenseNumber}` }),
    worksFor: businessRef(),
  };
}

function buildService() {
  if (!service) return null;
  const serviceId = `${service.url}#service`;
  const pageId = `${service.url}#webpage`;
  const breadcrumbId = `${service.url}#breadcrumb`;

  return {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        '@id': serviceId,
        name: service.name,
        description: service.description,
        serviceType: service.serviceType,
        url: service.url,
        provider: businessRef(),
        ...(service.areaServed ? { areaServed: service.areaServed } : {}),
        ...(service.audience
          ? { audience: { '@type': 'Audience', audienceType: service.audience } }
          : {}),
        ...(site.offersConfirmed && service.offer
          ? {
              offers: {
                '@type': 'Offer',
                price: service.offer.price,
                priceCurrency: service.offer.priceCurrency,
              },
            }
          : {}),
      },
      {
        '@type': 'WebPage',
        '@id': pageId,
        url: service.url,
        name: service.name,
        description: service.description,
        isPartOf: { '@id': websiteId },
        about: { '@id': serviceId },
        ...(breadcrumb ? { breadcrumb: { '@id': breadcrumbId } } : {}),
      },
      ...(breadcrumb ? [{ '@id': breadcrumbId, ...breadcrumbList(breadcrumb) }] : []),
    ],
  };
}

function buildCity() {
  if (!city) return null;
  return {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebPage',
        '@id': `${city.url}#webpage`,
        name: city.name,
        url: city.url,
        isPartOf: { '@id': websiteId },
        about: businessRef(),
        ...(breadcrumb ? { breadcrumb: { '@id': `${city.url}#breadcrumb` } } : {}),
      },
      ...(breadcrumb
        ? [
            {
              '@id': `${city.url}#breadcrumb`,
              ...breadcrumbList(breadcrumb),
            },
          ]
        : []),
      {
        '@type': 'LocalBusiness',
        ...businessRef(),
        areaServed: { '@type': 'City', name: city.areaServed },
      },
    ],
  };
}

function buildFaqPage() {
  if (!faqItems || faqItems.length === 0) return null;
  return {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  };
}

const schema = {
  website: buildWebsite,
  organization: buildOrganization,
  localBusiness: buildLocalBusinessReference,
  service: buildService,
  city: buildCity,
  faqPage: buildFaqPage,
  person: buildPerson,
}[type]();
---

{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
