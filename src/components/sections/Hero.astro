---
import Button from '../ui/Button.astro';

interface CTA {
  label: string;
  href: string;
}

interface Props {
  eyebrow: string;
  headline: string;
  // Optional exact substring of `headline` to render in italic, per Build
  // Spec Section 2 ("italic used selectively for emphasis words within
  // headlines").
  emphasis?: string;
  subhead: string;
  primaryCta: CTA;
  secondaryCta?: CTA;
  // Pill badge above the eyebrow label (e.g. "Now Accepting New
  // Clients"). Optional so Hero stays reusable without it.
  badge?: string;
}

const { eyebrow, headline, emphasis, subhead, primaryCta, secondaryCta, badge } = Astro.props;
const parts = emphasis && headline.includes(emphasis) ? headline.split(emphasis) : null;
---

<section class="relative overflow-hidden bg-gradient-to-br from-lavender-soft via-lavender to-sage">
  <!-- PLACEHOLDER: full-bleed hero image, coastal/Carlsbad themed, arriving
       when real photography is confirmed. role="img" keeps this announced
       to screen readers as a described image rather than silent decoration,
       same rationale as ImagePlaceholder. -->
  <div
    role="img"
    aria-label="Photo of the Carlsbad coastline near S.A.G.E. Therapy Center — placeholder, real photography pending"
    class="absolute inset-0 bg-ink/35"
  />

  <div class="relative mx-auto max-w-3xl px-6 py-24 text-center sm:py-32">
    {badge && (
      <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-1.5 font-sans text-xs font-semibold uppercase tracking-wide text-sage-deep shadow-sm">
        <span class="h-2 w-2 rounded-full bg-sage-deep" aria-hidden="true" />
        {badge}
      </span>
    )}
    <p class="eyebrow-label mt-4 text-surface">{eyebrow}</p>
    <h1 class="mt-4 font-serif text-4xl leading-tight text-surface sm:text-5xl">
      {
        parts ? (
          <Fragment>
            {parts[0]}
            <em class="italic text-lavender-soft">{emphasis}</em>
            {parts[1]}
          </Fragment>
        ) : (
          headline
        )
      }
    </h1>
    <p class="mx-auto mt-6 max-w-2xl font-sans text-lg text-surface/90">{subhead}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <Button href={primaryCta.href}>{primaryCta.label}</Button>
      {secondaryCta && (
        <Button href={secondaryCta.href} variant="secondary" class="border-surface text-surface hover:bg-surface/10">
          {secondaryCta.label}
        </Button>
      )}
    </div>
  </div>
</section>
