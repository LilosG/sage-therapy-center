---
import Button from '../ui/Button.astro';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';

interface CTA {
  label: string;
  href: string;
}

interface Props {
  eyebrow: string;
  headline: string;
  // Optional exact substring of `headline` to render in italic, per Build
  // Spec Section 2 ("italic used selectively for emphasis words within
  // headlines").
  emphasis?: string;
  subhead: string;
  primaryCta: CTA;
  secondaryCta?: CTA;
  // Pill badge above the eyebrow label (e.g. "Now Accepting New
  // Clients"). Optional so Hero stays reusable without it.
  badge?: string;
}

const { eyebrow, headline, emphasis, subhead, primaryCta, secondaryCta, badge } = Astro.props;
const parts = emphasis && headline.includes(emphasis) ? headline.split(emphasis) : null;
---

<section class="bg-lavender-soft">
  <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 sm:py-28 lg:grid-cols-2 lg:items-center">
    <div class="text-center lg:text-left">
      {badge && (
        <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-1.5 font-sans text-xs font-semibold uppercase tracking-wide text-sage-deep shadow-sm">
          <span class="h-2 w-2 rounded-full bg-sage-deep" aria-hidden="true" />
          {badge}
        </span>
      )}
      <p class="eyebrow-label mt-4">{eyebrow}</p>
      <h1 class="mt-4 font-serif text-4xl leading-tight text-ink sm:text-5xl">
        {
          parts ? (
            <Fragment>
              {parts[0]}
              <em class="italic text-primary">{emphasis}</em>
              {parts[1]}
            </Fragment>
          ) : (
            headline
          )
        }
      </h1>
      <p class="mx-auto mt-6 max-w-2xl font-sans text-lg text-foreground lg:mx-0">{subhead}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4 lg:justify-start">
        <Button href={primaryCta.href}>{primaryCta.label}</Button>
        {secondaryCta && (
          <Button href={secondaryCta.href} variant="secondary">
            {secondaryCta.label}
          </Button>
        )}
      </div>
    </div>

    <!-- PLACEHOLDER: hero image, coastal/Carlsbad themed, arriving Wave 6 -->
    <ImagePlaceholder
      alt="Photo of the Carlsbad coastline near S.A.G.E. Therapy Center — placeholder, real photography arriving Wave 6"
      icon="lucide:image"
      class="aspect-[4/3] w-full shadow-sm lg:aspect-[4/5]"
    />
  </div>
</section>
