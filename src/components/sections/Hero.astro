---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';

interface CTA {
  label: string;
  href: string;
}

interface Props {
  eyebrow: string;
  headline: string;
  emphasis?: string;
  subhead: string;
  primaryCta: CTA;
  secondaryCta?: CTA;
  badge?: string;
  image?: ImageMetadata;
  imagePosition?: string;
}

const {
  eyebrow,
  headline,
  emphasis,
  subhead,
  primaryCta,
  secondaryCta,
  badge,
  image,
  imagePosition = 'center',
} = Astro.props;
const parts = emphasis && headline.includes(emphasis) ? headline.split(emphasis) : null;
---

<section class="relative isolate overflow-hidden bg-primary">
  {
    image ? (
      <Image
        src={image}
        alt=""
        widths={[768, 1200, 1600]}
        sizes="100vw"
        class="absolute inset-0 h-full w-full object-cover"
        style={`object-position: ${imagePosition};`}
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <div class="absolute inset-0 bg-gradient-to-br from-lavender via-primary to-sage-deep" aria-hidden="true" />
    )
  }

  <!-- Keep the left text field controlled without flattening the editorial
       photography into an almost-solid purple panel. -->
  <div class="absolute inset-0 bg-gradient-to-r from-primary/84 via-primary/58 to-primary/16" aria-hidden="true" />
  <div class="absolute inset-0 bg-gradient-to-t from-primary/28 via-transparent to-primary/8" aria-hidden="true" />

  <div class="relative mx-auto flex min-h-[31rem] max-w-7xl items-center px-6 py-20 sm:min-h-[35rem] sm:py-24 lg:py-28 lg:px-8">
    <div class="max-w-3xl text-left">
      {
        badge && (
          <span class="inline-flex items-center gap-2 rounded-full border border-surface/70 bg-surface/90 px-4 py-1.5 font-sans text-xs font-semibold uppercase tracking-wide text-sage-deep shadow-sm backdrop-blur-sm">
            <span class="h-2 w-2 rounded-full bg-sage-deep" aria-hidden="true" />
            {badge}
          </span>
        )
      }
      <p class="mt-5 font-sans text-xs font-semibold uppercase tracking-label-inverted text-surface/85">{eyebrow}</p>
      <h1 class="mt-4 max-w-3xl font-serif text-4xl leading-tight text-surface drop-shadow-[0_2px_12px_rgba(42,40,51,0.18)] sm:text-5xl lg:text-6xl">
        {
          parts ? (
            <Fragment>
              {parts[0]}
              <em class="italic text-lavender-soft">{emphasis}</em>
              {parts[1]}
            </Fragment>
          ) : (
            headline
          )
        }
      </h1>
      <p class="mt-6 max-w-2xl font-sans text-base leading-7 text-surface/92 sm:text-lg">{subhead}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <Button href={primaryCta.href}>{primaryCta.label}</Button>
        {
          secondaryCta && (
            <Button href={secondaryCta.href} variant="secondary" class="border-surface/80 bg-primary/25 text-surface backdrop-blur-sm hover:bg-surface/10">
              {secondaryCta.label}
            </Button>
          )
        }
      </div>
    </div>
  </div>
</section>
