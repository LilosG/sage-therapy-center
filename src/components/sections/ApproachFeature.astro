---
interface Props {
  eyebrow?: string;
  heading: string;
  body: string;
  modalities?: string[];
}

const { eyebrow = 'Therapeutic Approach', heading, body, modalities = [] } = Astro.props;
---

<section class="bg-primary text-primary-foreground">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 sm:py-20 lg:grid-cols-[0.88fr_1.12fr] lg:items-center lg:gap-16 lg:py-24">
    <div>
      <p class="font-sans text-xs font-semibold uppercase tracking-[0.2em] text-sage">{eyebrow}</p>
      <h2 class="mt-4 max-w-xl font-serif text-3xl leading-tight sm:text-4xl">{heading}</h2>
    </div>

    <div class="border-t border-primary-foreground/15 pt-7 lg:border-l lg:border-t-0 lg:pl-12 lg:pt-0">
      <p class="font-sans text-base leading-8 text-primary-foreground/78">{body}</p>
      {
        modalities.length > 0 && (
          <ul class="mt-7 flex flex-wrap gap-2.5">
            {modalities.map((modality) => (
              <li class="rounded-full border border-primary-foreground/20 bg-primary-foreground/8 px-4 py-2 font-sans text-xs font-semibold tracking-wide text-primary-foreground/90">
                {modality}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>
