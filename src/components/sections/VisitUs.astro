---
import { Icon } from 'astro-icon/components';
import MapEmbed from './MapEmbed.astro';
import { site } from '../../data/site';

interface Neighborhood {
  name: string;
  blurb: string;
}

interface Props {
  cityName: string;
  neighborhoods?: Neighborhood[];
}

const { cityName, neighborhoods = [] } = Astro.props;
const fullAddress = `${site.address.street}, ${site.address.city}, ${site.address.region} ${site.address.postalCode}`;
const directionsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;
---

<section class="bg-secondary">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 sm:py-16 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-16 lg:py-20">
    <div>
      <p class="eyebrow-label">Carlsbad Office</p>
      <h2 class="mt-4 max-w-lg font-serif text-3xl leading-tight text-ink sm:text-4xl">Visit S.A.G.E. for in-person therapy.</h2>
      <p class="mt-5 max-w-lg font-sans text-base leading-7 text-foreground">
        In-person sessions take place at the S.A.G.E. Therapy Center office on Avenida Encinas. Telehealth is also available across {site.telehealth.coverageArea}.
      </p>

      <div class="mt-7 flex items-start gap-3 border-t border-border pt-6">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-surface text-sage-deep" aria-hidden="true">
          <Icon name="lucide:map-pin" width={18} height={18} />
        </span>
        <div>
          <p class="font-sans text-sm font-semibold text-ink">{site.name}</p>
          <p class="mt-1 font-sans text-sm leading-6 text-muted-foreground">{fullAddress}</p>
          <p class="mt-2 max-w-md font-sans text-xs leading-5 text-muted-foreground">{site.office.arrivalNote}</p>
          <a href={directionsHref} class="mt-3 inline-flex font-sans text-sm font-semibold text-sage-deep hover:text-primary">
            Get directions →
          </a>
        </div>
      </div>

      {
        neighborhoods.length > 0 && (
          <div class="mt-7">
            <p class="font-sans text-xs font-semibold uppercase tracking-[0.16em] text-sage-deep">Serving Carlsbad communities including</p>
            <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
              {neighborhoods.map((n) => (
                <li class="font-sans text-sm text-foreground" title={n.blurb}>{n.name}</li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    <MapEmbed height={330} class="shadow-[0_20px_55px_-38px_rgba(42,40,51,0.5)]" />
  </div>
</section>
