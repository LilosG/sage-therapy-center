---
// Renders Kristin's real modalities (src/data/practitioner.ts) as a pill
// card grid within a page's main content area. Pulls from the same
// single source of truth MeetKristin already uses rather than parsing
// mentions out of markdown body text, which would be fragile and easy to
// get wrong against real content.
interface Props {
  modalities: readonly string[];
  heading?: string;
}

const { modalities, heading = 'Approaches Kristin draws on' } = Astro.props;
---

<div class="mx-auto max-w-3xl px-6 py-8">
  <p class="font-sans text-sm font-semibold text-ink">{heading}</p>
  <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
    {
      modalities.map((modality) => (
        <div class="rounded-xl border border-border bg-surface p-4 text-center shadow-sm">
          <p class="font-sans text-sm font-medium text-foreground">{modality}</p>
        </div>
      ))
    }
  </div>
</div>
