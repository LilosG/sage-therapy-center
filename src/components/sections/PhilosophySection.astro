---
import { Image } from 'astro:assets';

interface Props {
  eyebrow?: string;
  heading: string;
  body: string;
  quote?: string;
  attribution?: string;
  items?: string[];
  image?: ImageMetadata;
}

const { eyebrow = 'The S.A.G.E. Approach', heading, body, quote, attribution, items = [], image } = Astro.props;
---

<section class="bg-secondary">
  <div class="mx-auto grid max-w-6xl gap-12 px-6 py-16 sm:py-20 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-16 lg:py-24">
    <div>
      <p class="eyebrow-label">{eyebrow}</p>
      <h2 class="mt-4 max-w-2xl font-serif text-3xl leading-tight text-ink sm:text-4xl lg:text-[2.7rem]">{heading}</h2>
      <p class="mt-6 max-w-xl font-sans text-base leading-7 text-foreground">{body}</p>
      {
        items.length > 0 && (
          <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3 border-t border-border pt-6">
            {items.map((item) => (
              <li class="font-sans text-sm font-medium text-sage-deep">{item}</li>
            ))}
          </ul>
        )
      }
    </div>

    <div>
      {
        image ? (
          <Image
            src={image}
            alt="Soft botanical shadows across a warm neutral wall"
            widths={[600, 900, 1200]}
            sizes="(min-width: 1024px) 52vw, 100vw"
            class="aspect-[4/3] w-full rounded-3xl object-cover shadow-[0_24px_60px_-45px_rgba(42,40,51,0.55)]"
            loading="lazy"
          />
        ) : (
          <div class="aspect-[4/3] rounded-3xl bg-lavender-soft" aria-hidden="true" />
        )
      }
      {
        quote && (
          <figure class="relative mx-5 -mt-10 rounded-2xl bg-primary px-6 py-6 text-primary-foreground shadow-lg sm:mx-8 sm:px-8">
            <blockquote class="font-serif text-xl italic leading-relaxed sm:text-2xl">“{quote}”</blockquote>
            {attribution && <figcaption class="mt-4 font-sans text-xs text-primary-foreground/70">— {attribution}</figcaption>}
          </figure>
        )
      }
    </div>
  </div>
</section>
