---
interface Props {
  eyebrow?: string;
  heading: string;
  body: string;
  quote?: string;
  attribution?: string;
  items?: string[];
}

const { eyebrow = 'The S.A.G.E. Approach', heading, body, quote, attribution, items = [] } = Astro.props;
---

<section class="bg-secondary">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 sm:py-20 lg:grid-cols-[1.05fr_0.95fr] lg:items-stretch lg:gap-16 lg:py-24">
    <div class="flex flex-col justify-center">
      <p class="eyebrow-label">{eyebrow}</p>
      <h2 class="mt-4 max-w-2xl font-serif text-3xl leading-tight text-ink sm:text-4xl lg:text-[2.7rem]">{heading}</h2>
      <p class="mt-6 max-w-xl font-sans text-base leading-7 text-foreground">{body}</p>

      {
        items.length > 0 && (
          <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3 border-t border-border pt-6">
            {items.map((item) => (
              <li class="font-sans text-sm font-medium text-sage-deep">{item}</li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="relative isolate flex min-h-[22rem] overflow-hidden rounded-[2rem] bg-primary px-8 py-9 text-primary-foreground shadow-[0_24px_60px_-48px_rgba(42,40,51,0.65)] sm:min-h-[25rem] sm:px-10 sm:py-10 lg:min-h-full">
      <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full border border-sage/25" aria-hidden="true" />
      <div class="absolute right-12 top-14 h-32 w-32 rounded-full border border-lavender/20" aria-hidden="true" />
      <div class="absolute -bottom-24 -left-12 h-64 w-64 rounded-full bg-lavender/10 blur-2xl" aria-hidden="true" />

      <div class="relative flex w-full flex-col justify-between">
        <p class="font-sans text-xs font-semibold uppercase tracking-[0.2em] text-sage">Self-Awareness · Growth · Enlightenment</p>

        {
          quote && (
            <figure class="max-w-md py-8">
              <blockquote class="font-serif text-3xl italic leading-snug text-primary-foreground sm:text-4xl">“{quote}”</blockquote>
              {attribution && <figcaption class="mt-6 font-sans text-sm text-primary-foreground/65">— {attribution}</figcaption>}
            </figure>
          )
        }

        <p class="max-w-sm font-sans text-xs leading-5 text-primary-foreground/55">
          An individualized approach means the method can change as the work develops rather than forcing every concern into the same framework.
        </p>
      </div>
    </div>
  </div>
</section>
