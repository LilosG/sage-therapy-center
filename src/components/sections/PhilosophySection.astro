---
import { Image } from 'astro:assets';

interface Props {
  eyebrow?: string;
  heading: string;
  body: string;
  quote?: string;
  attribution?: string;
  items?: string[];
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  eyebrow = 'The S.A.G.E. Approach',
  heading,
  body,
  quote,
  attribution,
  items = [],
  image,
  imageAlt = 'Quiet editorial landscape supporting the S.A.G.E. therapy approach',
} = Astro.props;
---

<section class="bg-secondary">
  <div class="mx-auto grid max-w-6xl gap-12 px-6 py-16 sm:py-20 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-16 lg:py-24">
    <div>
      <p class="eyebrow-label">{eyebrow}</p>
      <h2 class="mt-4 max-w-2xl font-serif text-3xl leading-tight text-ink sm:text-4xl lg:text-[2.7rem]">{heading}</h2>
      <p class="mt-6 max-w-xl font-sans text-base leading-7 text-foreground">{body}</p>
      {
        items.length > 0 && (
          <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3 border-t border-border pt-6">
            {items.map((item) => (
              <li class="font-sans text-sm font-medium text-sage-deep">{item}</li>
            ))}
          </ul>
        )
      }
    </div>

    <div>
      {
        image ? (
          <Image
            src={image}
            alt={imageAlt}
            widths={[600, 900, 1200]}
            sizes="(min-width: 1024px) 52vw, 100vw"
            class="aspect-[4/3] w-full rounded-[2rem] object-cover shadow-[0_24px_60px_-45px_rgba(42,40,51,0.55)]"
            loading="lazy"
          />
        ) : (
          <div class="relative isolate min-h-[22rem] overflow-hidden rounded-[2rem] bg-primary px-8 py-9 text-primary-foreground sm:min-h-[25rem] sm:px-10 sm:py-10">
            <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full border border-sage/25" aria-hidden="true" />
            <div class="absolute right-12 top-14 h-32 w-32 rounded-full border border-lavender/20" aria-hidden="true" />
            <div class="absolute -bottom-24 -left-12 h-64 w-64 rounded-full bg-lavender/10 blur-2xl" aria-hidden="true" />
            <div class="relative flex min-h-[18rem] flex-col justify-between sm:min-h-[21rem]">
              <p class="font-sans text-xs font-semibold uppercase tracking-[0.2em] text-sage">Self-Awareness · Growth · Enlightenment</p>
              {
                quote && (
                  <figure class="max-w-md py-8">
                    <blockquote class="font-serif text-3xl italic leading-snug text-primary-foreground sm:text-4xl">“{quote}”</blockquote>
                    {attribution && <figcaption class="mt-6 font-sans text-sm text-primary-foreground/65">— {attribution}</figcaption>}
                  </figure>
                )
              }
            </div>
          </div>
        )
      }

      {
        image && quote && (
          <figure class="relative mx-5 -mt-10 rounded-2xl border border-primary-foreground/10 bg-primary px-6 py-6 text-primary-foreground shadow-lg sm:mx-8 sm:px-8">
            <blockquote class="font-serif text-xl italic leading-relaxed sm:text-2xl">“{quote}”</blockquote>
            {attribution && <figcaption class="mt-4 font-sans text-xs text-primary-foreground/70">— {attribution}</figcaption>}
          </figure>
        )
      }
    </div>
  </div>
</section>
