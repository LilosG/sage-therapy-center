---
interface Props {
  eyebrow?: string;
  heading: string;
  body: string;
  quote?: string;
  attribution?: string;
  items?: string[];
}

const { eyebrow = 'The S.A.G.E. Approach', heading, body, quote, attribution, items = [] } = Astro.props;
---

<section class="bg-secondary">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 sm:py-20 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-16">
    <div>
      <p class="eyebrow-label">{eyebrow}</p>
      <h2 class="mt-4 max-w-2xl font-serif text-3xl leading-tight text-ink sm:text-4xl">{heading}</h2>
      <p class="mt-6 max-w-2xl font-sans text-base leading-7 text-foreground">{body}</p>
      {
        items.length > 0 && (
          <ul class="mt-7 flex flex-wrap gap-x-6 gap-y-3 border-t border-border pt-6">
            {items.map((item) => (
              <li class="font-sans text-sm font-medium text-sage-deep">{item}</li>
            ))}
          </ul>
        )
      }
    </div>

    {
      quote && (
        <figure class="border-l border-sage/50 pl-8 lg:pl-10">
          <blockquote class="font-serif text-2xl italic leading-relaxed text-primary sm:text-3xl">“{quote}”</blockquote>
          {attribution && <figcaption class="mt-5 font-sans text-sm text-muted-foreground">— {attribution}</figcaption>}
        </figure>
      )
    }
  </div>
</section>
