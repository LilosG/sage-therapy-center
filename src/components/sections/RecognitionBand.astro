---
interface RecognitionItem {
  title: string;
  body: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  items: RecognitionItem[];
  tone?: 'background' | 'lavender';
}

const { eyebrow, heading, items, tone = 'background' } = Astro.props;
const backgroundClass = tone === 'lavender' ? 'bg-lavender-soft/55' : 'bg-background';
const isFour = items.length === 4;
---

<section class:list={['border-y border-border/70', backgroundClass]}>
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20 lg:py-24">
    <div class="grid gap-10 lg:grid-cols-[0.68fr_1.32fr] lg:gap-16">
      <div class="max-w-md">
        {eyebrow && <p class="eyebrow-label">{eyebrow}</p>}
        <h2 class="mt-4 font-serif text-3xl leading-tight text-ink sm:text-4xl">{heading}</h2>
        <div class="mt-6 h-px w-20 bg-sage/70" aria-hidden="true" />
      </div>

      <ol class:list={['grid gap-4', isFour ? 'sm:grid-cols-2' : 'md:grid-cols-3']}>
        {
          items.map((item, index) => (
            <li class="rounded-2xl border border-border bg-surface p-6 sm:p-7">
              <p class="font-serif text-3xl text-lavender">{String(index + 1).padStart(2, '0')}</p>
              <h3 class="mt-4 font-serif text-xl leading-snug text-ink">{item.title}</h3>
              <p class="mt-2 font-sans text-sm leading-6 text-muted-foreground">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
