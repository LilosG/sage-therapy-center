---
import { Icon } from 'astro-icon/components';
import Button from '../ui/Button.astro';
import MapEmbed from './MapEmbed.astro';
import { site } from '../../data/site';
import { SCHEDULE_URL } from '../../data/nav';

const fullAddress = `${site.address.street}, ${site.address.city}, ${site.address.region} ${site.address.postalCode}`;
const directionsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;
---

<section class="bg-background">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 sm:py-20 lg:grid-cols-[0.82fr_1.18fr] lg:items-center lg:gap-14 lg:py-24">
    <div>
      <p class="eyebrow-label">Therapy in Carlsbad</p>
      <h2 class="mt-4 max-w-lg font-serif text-3xl leading-tight text-ink sm:text-4xl">A real place to meet, with flexible ways to connect.</h2>
      <p class="mt-5 max-w-lg font-sans text-base leading-7 text-foreground">
        In-person sessions are based at S.A.G.E. Therapy Center's Carlsbad office, with telehealth available to clients across {site.telehealth.coverageArea}.
      </p>

      <div class="mt-8 space-y-5 border-y border-border py-6">
        <div class="flex gap-4">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-sage/15 text-sage-deep" aria-hidden="true">
            <Icon name="lucide:map-pin" width={18} height={18} />
          </span>
          <div>
            <p class="font-sans text-xs font-semibold uppercase tracking-[0.14em] text-sage-deep">Carlsbad Office</p>
            <p class="mt-1 font-serif text-lg text-ink">{fullAddress}</p>
          </div>
        </div>
        <div class="flex gap-4">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-lavender-soft text-sage-deep" aria-hidden="true">
            <Icon name="lucide:monitor" width={18} height={18} />
          </span>
          <div>
            <p class="font-sans text-xs font-semibold uppercase tracking-[0.14em] text-sage-deep">Session Options</p>
            <p class="mt-1 font-serif text-lg text-ink">In person or telehealth across {site.telehealth.coverageArea}</p>
          </div>
        </div>
      </div>

      <div class="mt-7 flex flex-wrap gap-4">
        <Button href={SCHEDULE_URL}>Schedule a Session</Button>
        <a href={directionsUrl} class="inline-flex items-center gap-2 font-sans text-sm font-semibold text-sage-deep hover:text-primary">
          Get directions <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <MapEmbed class="shadow-[0_24px_60px_-42px_rgba(42,40,51,0.5)]" />
  </div>
</section>
