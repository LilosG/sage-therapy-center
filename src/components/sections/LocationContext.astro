---
// Compact "convenience" block for city/service combo pages — every one
// of these pages is about the real Carlsbad office (S.A.G.E.'s only
// physical location), regardless of which city the page targets, so
// this never implies a local office in a city that doesn't have one
// (only Carlsbad's `hasOffice` is true — see src/content/cities/*.md).
// Neighborhoods, when present on the city entry, are shown purely as
// proximity context ("also see clients from"), not as a claim of local
// presence.
import { Icon } from 'astro-icon/components';
import MapEmbed from './MapEmbed.astro';
import { site } from '../../data/site';

interface Neighborhood {
  name: string;
  blurb: string;
}

interface Props {
  cityName: string;
  hasOffice: boolean;
  neighborhoods?: Neighborhood[];
}

const { cityName, hasOffice, neighborhoods = [] } = Astro.props;
const fullAddress = `${site.address.street}, ${site.address.city}, ${site.address.region} ${site.address.postalCode}`;
---

<section class="bg-lavender-soft">
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow-label">Convenient to {cityName}</p>
      <h2 class="mt-4 font-serif text-3xl text-ink sm:text-4xl">
        {hasOffice ? `Visit our ${site.address.city} office` : `Getting here from ${cityName}`}
      </h2>
    </div>
    <div class="mt-10 grid gap-8 rounded-3xl border border-border bg-background p-8 shadow-sm lg:grid-cols-2 lg:items-start lg:p-12">
      <div>
        <div class="inline-flex items-start gap-3 rounded-2xl border border-border bg-surface px-4 py-3">
          <Icon name="lucide:map-pin" width={20} height={20} class="mt-0.5 shrink-0 text-sage-deep" aria-hidden="true" />
          <div>
            <p class="font-sans text-sm font-semibold text-ink">{site.name}</p>
            <p class="mt-0.5 font-sans text-sm text-foreground">{fullAddress}</p>
          </div>
        </div>
        <p class="mt-4 font-sans text-sm text-muted-foreground">
          {
            hasOffice
              ? `In-person sessions at our ${site.address.city} office, plus telehealth available to clients across ${site.telehealth.coverageArea}.`
              : `S.A.G.E. Therapy Center's only office is in ${site.address.city} — a short drive from ${cityName} — with telehealth available to clients across ${site.telehealth.coverageArea}.`
          }
        </p>
        {
          neighborhoods.length > 0 && (
            <div class="mt-6 border-t border-border pt-6">
              <p class="font-sans text-sm font-semibold text-ink">Also seeing clients from</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {neighborhoods.map((n) => (
                  <li
                    class="rounded-full border border-border bg-surface px-4 py-2 font-sans text-sm text-foreground transition-transform duration-150 hover:-translate-y-0.5 hover:border-sage hover:shadow-sm"
                    title={n.blurb}
                  >
                    {n.name}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
      <MapEmbed />
    </div>
  </div>
</section>
