---
import StarRating from '../ui/StarRating.astro';

interface Review {
  authorName: string;
  authorPhotoUrl: string | null;
  authorProfileUrl: string | null;
  rating: number | null;
  text: string;
  relativeTime: string;
  googleMapsUri: string | null;
}

interface Props {
  platformName?: string;
  rating?: number | null;
  reviewCount?: number | null;
  reviews?: Review[];
  placeUrl?: string;
  lastUpdated?: string | null;
}

const {
  platformName = 'Google',
  rating,
  reviewCount,
  reviews = [],
  placeUrl,
  lastUpdated,
} = Astro.props;

const hasRealData = typeof rating === 'number' && typeof reviewCount === 'number' && reviews.length > 0;
const featuredReviews = reviews.slice(0, 3);
const lastUpdatedLabel = lastUpdated
  ? new Date(lastUpdated).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---

<section class="border-y border-border bg-surface">
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20 lg:py-24">
    {
      hasRealData ? (
        <Fragment>
          <div class="grid gap-6 border-b border-border pb-8 sm:grid-cols-[1fr_auto] sm:items-end">
            <div>
              <p class="eyebrow-label">Client Feedback</p>
              <h2 class="mt-3 font-serif text-3xl text-ink sm:text-4xl">What clients have shared</h2>
              <p class="mt-3 max-w-xl font-sans text-sm leading-6 text-muted-foreground">
                Recent public Google feedback about S.A.G.E. Therapy Center and Kristin's approach.
              </p>
            </div>
            <div class="inline-flex items-center gap-4 rounded-2xl bg-lavender-soft/70 px-5 py-4 sm:justify-self-end">
              <span class="font-serif text-3xl text-ink">{rating.toFixed(1)}</span>
              <div>
                <StarRating rating={rating} size={18} />
                <p class="mt-1 font-sans text-xs text-muted-foreground">{reviewCount} {platformName} reviews</p>
              </div>
            </div>
          </div>

          <ul class="-mx-6 mt-9 flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-3 sm:mx-0 sm:px-0 lg:grid lg:grid-cols-3 lg:gap-0 lg:overflow-visible lg:pb-0">
            {featuredReviews.map((review, index) => (
              <li class:list={[
                'min-w-[82%] snap-start py-1 sm:min-w-[48%] lg:min-w-0 lg:px-7',
                index > 0 && 'lg:border-l lg:border-border',
                index === 0 && 'lg:pl-0',
                index === featuredReviews.length - 1 && 'lg:pr-0',
              ]}>
                <div class="flex items-center gap-3">
                  {review.authorPhotoUrl ? (
                    <img
                      src={review.authorPhotoUrl}
                      alt=""
                      width="36"
                      height="36"
                      class="h-9 w-9 rounded-full object-cover"
                      loading="lazy"
                      referrerpolicy="no-referrer"
                    />
                  ) : (
                    <div class="h-9 w-9 rounded-full bg-lavender-soft" aria-hidden="true" />
                  )}
                  <div>
                    <p class="font-sans text-sm font-semibold text-ink">{review.authorName}</p>
                    <StarRating rating={review.rating ?? 0} size={13} />
                  </div>
                </div>
                <p class="mt-4 line-clamp-5 font-sans text-sm leading-6 text-foreground">{review.text}</p>
                <div class="mt-4 flex items-center gap-3 font-sans text-xs text-muted-foreground">
                  <span>{review.relativeTime}</span>
                  {review.googleMapsUri && (
                    <a href={review.googleMapsUri} class="font-medium text-sage-deep hover:text-primary">View on Google &rarr;</a>
                  )}
                </div>
              </li>
            ))}
          </ul>

          <div class="mt-9 flex flex-col gap-2 border-t border-border pt-5 font-sans text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
            {lastUpdatedLabel && <p>Reviews last updated {lastUpdatedLabel}</p>}
            {placeUrl && <a href={placeUrl} class="font-medium hover:text-sage-deep">See all reviews on Google Maps &rarr;</a>}
          </div>
        </Fragment>
      ) : (
        <div class="mx-auto max-w-2xl text-center">
          <p class="eyebrow-label">Client Feedback</p>
          <h2 class="mt-4 font-serif text-3xl text-ink sm:text-4xl">{platformName} reviews coming soon</h2>
          <p class="mt-3 font-sans text-foreground">Reach out directly with any questions about fit or availability.</p>
        </div>
      )
    }
  </div>
</section>
