---
// Purely presentational — the calling page queries the services
// collection and passes plain data, per the "section components don't
// reach into content collections directly" rule (Build Spec Section 6).
import { Icon } from 'astro-icon/components';
import Card from '../ui/Card.astro';
import IconCircle from '../ui/IconCircle.astro';

interface ServiceItem {
  title: string;
  description: string;
  href: string;
  // Lucide icon name (e.g. "lucide:heart") — callers look this up from
  // src/data/serviceIcons.ts by slug, keeping icon choice centralized.
  icon: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  services: ServiceItem[];
}

const { eyebrow, heading, services } = Astro.props;
---

<section class="bg-background">
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="mx-auto max-w-2xl text-center">
      {eyebrow && <p class="eyebrow-label">{eyebrow}</p>}
      <h2 class="mt-4 font-serif text-3xl text-ink sm:text-4xl">{heading}</h2>
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <Card class="flex flex-col">
            <IconCircle>
              <Icon name={service.icon} width={22} height={22} />
            </IconCircle>
            <p class="mt-4 font-serif text-lg text-ink">{service.title}</p>
            <p class="mt-2 flex-1 font-sans text-sm text-muted-foreground">{service.description}</p>
            <a href={service.href} class="mt-4 font-sans text-sm font-medium text-sage-deep hover:text-primary">
              Learn more &rarr;
            </a>
          </Card>
        ))
      }
    </div>
  </div>
</section>
