---
interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
  // "light" is for use over a dark scrim (PageHero's gradient+overlay);
  // default "muted" is for plain white/cream backgrounds.
  variant?: 'muted' | 'light';
}

const { items, variant = 'muted' } = Astro.props;
const trail = variant === 'light' ? 'text-surface/80' : 'text-muted-foreground';
const current = variant === 'light' ? 'text-surface' : 'text-ink';
const link = variant === 'light' ? 'hover:text-surface' : 'hover:text-sage-deep';
---

<nav aria-label="Breadcrumb" class="mx-auto max-w-6xl px-6 py-4">
  <ol class={`flex flex-wrap items-center gap-2 font-sans text-sm ${trail}`}>
    {
      items.map((item, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true">/</span>}
          {i === items.length - 1 ? (
            <span class={current} aria-current="page">
              {item.name}
            </span>
          ) : (
            <a href={item.url} class={link}>
              {item.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
