---
interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mx-auto max-w-6xl px-6 py-4">
  <ol class="flex flex-wrap items-center gap-2 font-sans text-sm text-muted-foreground">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true">/</span>}
          {i === items.length - 1 ? (
            <span class="text-ink" aria-current="page">
              {item.name}
            </span>
          ) : (
            <a href={item.url} class="hover:text-sage-deep">
              {item.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
