---
interface Step {
  title: string;
  body: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  steps: Step[];
}

const { eyebrow, heading, steps } = Astro.props;
---

<section class="bg-background">
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="mx-auto max-w-2xl text-center">
      {eyebrow && <p class="eyebrow-label">{eyebrow}</p>}
      <h2 class="mt-4 font-serif text-3xl text-ink sm:text-4xl">{heading}</h2>
    </div>
    <ol class="mt-10 grid gap-8 sm:grid-cols-3">
      {
        steps.map((step, i) => (
          <li>
            <span class="font-serif text-4xl text-sage-deep">{String(i + 1).padStart(2, '0')}</span>
            <p class="mt-3 font-serif text-lg text-ink">{step.title}</p>
            <p class="mt-2 font-sans text-sm text-muted-foreground">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
