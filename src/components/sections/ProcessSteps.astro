---
interface Step {
  title: string;
  body: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  steps: Step[];
}

const { eyebrow, heading, steps } = Astro.props;
---

<section class="bg-lavender-soft">
  <div class="mx-auto max-w-6xl px-6 py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-2xl text-center">
      {eyebrow && <p class="eyebrow-label">{eyebrow}</p>}
      <h2 class="mt-4 font-serif text-3xl text-ink sm:text-4xl">{heading}</h2>
    </div>

    <div class="relative mt-12">
      <div class="absolute left-[16.66%] right-[16.66%] top-7 hidden h-px bg-sage/45 md:block" aria-hidden="true" />
      <ol class="relative grid gap-10 md:grid-cols-3 md:gap-8">
        {
          steps.map((step, i) => (
            <li class="relative text-center">
              <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full border border-sage/35 bg-background font-serif text-lg text-sage-deep shadow-sm">
                {String(i + 1).padStart(2, '0')}
              </div>
              <h3 class="mt-5 font-serif text-xl text-ink">{step.title}</h3>
              <p class="mx-auto mt-3 max-w-xs font-sans text-sm leading-6 text-muted-foreground">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
