---
import { Icon } from 'astro-icon/components';
import { site } from '../../data/site';

const stats = [
  {
    label: site.practitioner.licenseConfirmRequired ? 'Credential' : site.practitioner.credential,
    value: site.practitioner.licenseConfirmRequired
      ? site.practitioner.credential
      : `License #${site.practitioner.licenseNumber}`,
    icon: 'lucide:shield-check',
  },
  { label: 'Practicing', value: '15+ years', icon: 'lucide:calendar-check' },
  { label: 'In Person', value: `${site.address.city}, ${site.address.region}`, icon: 'lucide:building-2' },
  { label: 'Telehealth', value: site.telehealth.display, icon: 'lucide:monitor' },
];
---

<section class="relative z-20 -mt-1 w-full border-y border-border bg-surface shadow-[0_14px_34px_-28px_rgba(42,40,51,0.45)] lg:-mt-2">
  <div class="mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4 lg:px-8">
    {
      stats.map((stat, index) => (
        <div
          class:list={[
            'flex min-h-24 items-center gap-3 py-4 sm:gap-4 lg:min-h-28 lg:px-6',
            index % 2 === 0 ? 'pr-4 sm:pr-6' : 'border-l border-border pl-4 sm:pl-6',
            index >= 2 && 'border-t border-border lg:border-t-0',
            index > 0 && 'lg:border-l lg:border-border',
            index === 0 && 'lg:pl-0',
            index === stats.length - 1 && 'lg:pr-0',
          ]}
        >
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-sage/10 text-sage-deep ring-1 ring-sage/15 sm:h-11 sm:w-11">
            <Icon name={stat.icon} width={18} height={18} aria-hidden="true" />
          </span>
          <div class="min-w-0">
            <p class="font-sans text-[0.66rem] font-semibold uppercase tracking-[0.16em] text-sage-deep sm:text-[0.7rem]">{stat.label}</p>
            <p class="mt-1 font-serif text-sm leading-snug text-ink sm:text-[0.98rem]">{stat.value}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
