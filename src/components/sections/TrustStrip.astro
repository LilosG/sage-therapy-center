---
// Correction to Wave 1's original component: that version rendered an
// arbitrary caller-supplied pill list, which was never the intended
// design. The real design is a fixed 4-column label/value stat grid
// (LMFT/license, years practicing, telehealth coverage, insurance
// policy). Self-contained — reads site.ts directly rather than taking
// props — since every value here is a fixed practice fact rather than
// per-page content, and the license stat needs site.ts's own
// licenseConfirmRequired flag to decide what it's allowed to show.
import { Icon } from 'astro-icon/components';
import { site } from '../../data/site';

const stats = [
  {
    label: site.practitioner.licenseConfirmRequired ? 'Credential' : site.practitioner.credential,
    value: site.practitioner.licenseConfirmRequired
      ? site.practitioner.credential
      : `License #${site.practitioner.licenseNumber}`,
    icon: 'lucide:shield-check',
  },
  { label: 'Practicing', value: '15+ years', icon: 'lucide:calendar-check' },
  { label: 'Telehealth', value: site.telehealth.coverageArea, icon: 'lucide:map-pin' },
  { label: 'Insurance', value: 'Out-of-network, superbills provided', icon: 'lucide:file-check' },
];
---

<div class="relative z-20 -mt-10 mx-auto w-full max-w-7xl px-4 sm:px-6 lg:-mt-12 lg:px-8">
  <div class="mx-auto grid grid-cols-2 divide-y divide-border rounded-2xl border border-border/80 bg-surface/95 p-6 shadow-xl shadow-ink/5 backdrop-blur-md lg:grid-cols-4 lg:divide-y-0 lg:divide-x lg:p-8">
    {
      stats.map((stat) => (
        <div class="flex items-center gap-3 px-2 py-4 text-left first:pt-0 lg:px-6 lg:py-0 lg:first:pl-0">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-sage/15 text-sage-deep">
            <Icon name={stat.icon} width={20} height={20} aria-hidden="true" />
          </span>
          <div>
            <p class="font-sans text-xs font-semibold uppercase tracking-wide text-sage-deep">{stat.label}</p>
            <p class="mt-0.5 font-serif text-sm text-ink sm:text-base">{stat.value}</p>
          </div>
        </div>
      ))
    }
  </div>
</div>
