---
// Reusable "areas served" card grid, extracted from the near-identical
// inline blocks that used to live in index.astro ("Areas We Serve") and
// [city]/index.astro ("Nearby areas"). Cards over pills per the interior
// design system upgrade — same info, more scannable at a glance.
import { site } from '../../data/site';

interface CityLink {
  name: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  cities: CityLink[];
  viewAllHref?: string;
  viewAllLabel?: string;
}

const { eyebrow, heading, cities, viewAllHref, viewAllLabel = 'See all areas we serve' } = Astro.props;
---

<section class="bg-background">
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="mx-auto max-w-2xl text-center">
      {eyebrow && <p class="eyebrow-label">{eyebrow}</p>}
      <h2 class="mt-4 font-serif text-3xl text-ink sm:text-4xl">{heading}</h2>
    </div>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        cities.map((c) => (
          <li>
            <a
              href={c.href}
              class="group flex h-full flex-col justify-between rounded-2xl border border-border bg-surface p-6 shadow-sm transition-all duration-150 hover:border-sage hover:shadow-md"
            >
              <div>
                <p class="font-serif text-lg text-ink">{c.name}</p>
                <p class="mt-1 font-sans text-sm text-muted-foreground">
                  Serving {c.name} &middot; Telehealth available across {site.telehealth.coverageArea}
                </p>
              </div>
              <span class="mt-4 inline-flex items-center gap-1.5 font-sans text-sm font-medium text-sage-deep">
                Learn more
                <span class="transition-transform duration-150 group-hover:translate-x-1" aria-hidden="true">
                  &rarr;
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    {
      viewAllHref && (
        <p class="mt-8 text-center">
          <a href={viewAllHref} class="font-sans text-sm font-medium text-sage-deep hover:text-primary">
            {viewAllLabel} &rarr;
          </a>
        </p>
      )
    }
  </div>
</section>
