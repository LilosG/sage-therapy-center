---
import Accordion from '../ui/Accordion.astro';
import SchemaOrg from '../seo/SchemaOrg.astro';

interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  items: FaqItem[];
  // Section-rhythm control (Wave 6, item 7) — lets callers alternate
  // backgrounds against whatever section sits above this one.
  background?: 'background' | 'secondary' | 'surface';
}

const { eyebrow, heading, items, background = 'background' } = Astro.props;
const bgClass = { background: 'bg-background', secondary: 'bg-secondary', surface: 'bg-surface' }[background];
---

<section class={bgClass}>
  <div class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <div class="text-center">
      {eyebrow && <p class="eyebrow-label">{eyebrow}</p>}
      <h2 class="mt-4 font-serif text-3xl text-ink sm:text-4xl">{heading}</h2>
    </div>
    <div class="mt-10">
      <Accordion items={items} />
    </div>
  </div>
</section>
<SchemaOrg type="faqPage" faqItems={items} />
