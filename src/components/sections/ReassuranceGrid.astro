---
import { Icon } from 'astro-icon/components';
import Card from '../ui/Card.astro';
import IconCircle from '../ui/IconCircle.astro';

interface ReassuranceItem {
  title: string;
  body: string;
  // Lucide icon name (e.g. "lucide:wind"), chosen per card's subject —
  // see astro-icon usage in ServiceGrid.astro for the same pattern.
  icon: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  items: ReassuranceItem[];
  // Money pages (service/city-service) use a 3-column "who this is for"
  // layout; city hubs keep the original 4-column stat-style grid.
  columns?: 3 | 4;
}

const { eyebrow, heading, items, columns = 4 } = Astro.props;
const gridClass = columns === 3 ? 'sm:grid-cols-2 lg:grid-cols-3' : 'sm:grid-cols-2 lg:grid-cols-4';
---

<section class="bg-background">
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="mx-auto max-w-2xl text-center">
      {eyebrow && <p class="eyebrow-label">{eyebrow}</p>}
      <h2 class="mt-4 font-serif text-3xl text-ink sm:text-4xl">{heading}</h2>
    </div>
    <div class={`mt-10 grid gap-6 ${gridClass}`}>
      {
        items.map((item) => (
          <Card>
            <IconCircle>
              <Icon name={item.icon} width={22} height={22} />
            </IconCircle>
            <p class="mt-4 font-serif text-lg text-ink">{item.title}</p>
            <p class="mt-2 font-sans text-sm text-muted-foreground">{item.body}</p>
          </Card>
        ))
      }
    </div>
  </div>
</section>
