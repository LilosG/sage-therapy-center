---
import { Icon } from 'astro-icon/components';

interface ReassuranceItem {
  title: string;
  body: string;
  icon: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  items: ReassuranceItem[];
  columns?: 3 | 4;
}

const { eyebrow, heading, items, columns = 4 } = Astro.props;
const gridClass = columns === 3 ? 'md:grid-cols-3' : 'sm:grid-cols-2 lg:grid-cols-4';
---

<section class="bg-background">
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20 lg:py-24">
    <div class="max-w-2xl">
      {eyebrow && <p class="eyebrow-label">{eyebrow}</p>}
      <h2 class="mt-3 font-serif text-3xl leading-tight text-ink sm:text-4xl">{heading}</h2>
      <div class="mt-5 h-px w-20 bg-sage/60" aria-hidden="true" />
    </div>

    <div class={`mt-10 grid gap-4 sm:gap-5 ${gridClass}`}>
      {
        items.map((item, index) => (
          <article class="group relative overflow-hidden rounded-2xl border border-border bg-surface p-6 shadow-[0_16px_34px_-28px_rgba(42,40,51,0.45)] sm:p-7">
            <div class="absolute right-0 top-0 h-24 w-24 rounded-bl-[4rem] bg-lavender-soft/75 transition-transform duration-300 group-hover:scale-110" aria-hidden="true" />
            <div class="relative">
              <div class="flex items-start justify-between gap-4">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-sage/12 text-sage-deep ring-1 ring-sage/15" aria-hidden="true">
                  <Icon name={item.icon} width={19} height={19} />
                </div>
                <span class="font-serif text-sm text-lavender">{String(index + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="mt-7 font-serif text-xl leading-snug text-ink">{item.title}</h3>
              <p class="mt-3 font-sans text-sm leading-6 text-muted-foreground">{item.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
