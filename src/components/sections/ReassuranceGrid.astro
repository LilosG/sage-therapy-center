---
import Card from '../ui/Card.astro';
import IconCircle from '../ui/IconCircle.astro';

interface ReassuranceItem {
  title: string;
  body: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  items: ReassuranceItem[];
}

const { eyebrow, heading, items } = Astro.props;
---

<section class="bg-background">
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="mx-auto max-w-2xl text-center">
      {eyebrow && <p class="eyebrow-label">{eyebrow}</p>}
      <h2 class="mt-4 font-serif text-3xl text-ink sm:text-4xl">{heading}</h2>
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((item) => (
          <Card>
            <IconCircle>
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <circle cx="10" cy="10" r="6" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </IconCircle>
            <p class="mt-4 font-serif text-lg text-ink">{item.title}</p>
            <p class="mt-2 font-sans text-sm text-muted-foreground">{item.body}</p>
          </Card>
        ))
      }
    </div>
  </div>
</section>
