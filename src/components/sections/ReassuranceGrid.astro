---
import { Icon } from 'astro-icon/components';

interface ReassuranceItem {
  title: string;
  body: string;
  icon: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  items: ReassuranceItem[];
  columns?: 3 | 4;
}

const { eyebrow, heading, items, columns = 4 } = Astro.props;
const gridClass = columns === 3 ? 'md:grid-cols-3' : 'sm:grid-cols-2 lg:grid-cols-4';
---

<section class="bg-background">
  <div class="mx-auto max-w-6xl px-6 py-14 sm:py-18">
    <div class="max-w-2xl">
      {eyebrow && <p class="eyebrow-label">{eyebrow}</p>}
      <h2 class="mt-3 font-serif text-3xl leading-tight text-ink sm:text-4xl">{heading}</h2>
    </div>

    <div class={`mt-9 grid gap-0 border-y border-border ${gridClass}`}>
      {
        items.map((item) => (
          <article class="border-b border-border py-7 last:border-b-0 sm:px-6 md:border-b-0 md:border-r md:last:border-r-0 md:first:pl-0 md:last:pr-0">
            <div class="flex h-9 w-9 items-center justify-center rounded-full bg-lavender-soft text-sage-deep" aria-hidden="true">
              <Icon name={item.icon} width={17} height={17} />
            </div>
            <h3 class="mt-4 font-serif text-lg leading-snug text-ink">{item.title}</h3>
            <p class="mt-2 font-sans text-sm leading-6 text-muted-foreground">{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
