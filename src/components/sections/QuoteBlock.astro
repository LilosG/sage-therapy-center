---
interface Props {
  quote: string;
  attribution: string;
}

const { quote, attribution } = Astro.props;
---

<section class="mx-auto max-w-4xl px-6 py-16 sm:py-20">
  <blockquote class="quote-block">
    <p>&ldquo;{quote}&rdquo;</p>
    <footer class="mt-6 font-sans text-base not-italic text-primary-foreground/80">&mdash; {attribution}</footer>
  </blockquote>
</section>
