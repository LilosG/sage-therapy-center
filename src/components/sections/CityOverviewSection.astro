---
import { Icon } from 'astro-icon/components';
import { site } from '../../data/site';

interface Props {
  cityName: string;
  hasOffice: boolean;
}

const { cityName, hasOffice } = Astro.props;
const fullAddress = `${site.address.street}, ${site.address.city}, ${site.address.region} ${site.address.postalCode}`;
const heading = hasOffice
  ? `Therapy in ${cityName} with Kristin Moorehead-Malley, LMFT`
  : `Therapy for ${cityName} clients from S.A.G.E.'s Carlsbad practice`;
---

<section class="bg-background">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 sm:py-20 lg:grid-cols-[1.08fr_0.62fr] lg:items-start lg:gap-20 lg:py-24">
    <div>
      <p class="eyebrow-label">Therapy in {cityName}</p>
      <h2 class="mt-4 max-w-2xl font-serif text-3xl leading-tight text-ink sm:text-4xl">{heading}</h2>
      <div class="mt-6 max-w-2xl font-sans text-base leading-7 text-foreground [&_p+p]:mt-4">
        <slot />
      </div>
    </div>

    <aside class="border-y border-border py-2 lg:border-y-0 lg:border-l lg:py-0 lg:pl-10">
      <p class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-sage-deep">At a glance</p>
      <dl class="mt-3 divide-y divide-border">
        <div class="flex gap-4 py-5">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-sage/15 text-sage-deep" aria-hidden="true">
            <Icon name="lucide:map-pin" width={17} height={17} />
          </span>
          <div>
            <dt class="font-sans text-sm font-semibold text-ink">{hasOffice ? 'Carlsbad office' : 'Practice base'}</dt>
            <dd class="mt-1 font-sans text-sm leading-6 text-muted-foreground">{fullAddress}</dd>
          </div>
        </div>
        <div class="flex gap-4 py-5">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-lavender-soft text-sage-deep" aria-hidden="true">
            <Icon name="lucide:monitor" width={17} height={17} />
          </span>
          <div>
            <dt class="font-sans text-sm font-semibold text-ink">Flexible session options</dt>
            <dd class="mt-1 font-sans text-sm leading-6 text-muted-foreground">In-person in Carlsbad and telehealth across {site.telehealth.coverageArea}.</dd>
          </div>
        </div>
        <div class="flex gap-4 py-5">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-sage/15 text-sage-deep" aria-hidden="true">
            <Icon name="lucide:sparkles" width={17} height={17} />
          </span>
          <div>
            <dt class="font-sans text-sm font-semibold text-ink">Individualized approach</dt>
            <dd class="mt-1 font-sans text-sm leading-6 text-muted-foreground">Therapy can draw from multiple approaches based on the person, relationship, and goals.</dd>
          </div>
        </div>
      </dl>
    </aside>
  </div>
</section>
