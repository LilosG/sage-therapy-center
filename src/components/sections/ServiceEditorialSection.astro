---
import { Icon } from 'astro-icon/components';
import { site } from '../../data/site';

interface RelatedLink {
  title: string;
  href: string;
}

interface Props {
  related?: RelatedLink[];
  cityName?: string;
  hasOffice?: boolean;
  detailsEyebrow?: string;
}

const {
  related = [],
  cityName = site.address.city,
  hasOffice = cityName === site.address.city,
  detailsEyebrow = 'Practical Details',
} = Astro.props;

const locationTitle = hasOffice ? `${cityName} office` : `Serving ${cityName}`;
const locationBody = hasOffice
  ? `${site.address.street}, ${site.address.city}, ${site.address.region}`
  : `In-person sessions are based at the ${site.address.city} office, with telehealth available to ${cityName} clients.`;
---

<section class="bg-background">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 sm:py-20 lg:grid-cols-[1fr_0.38fr] lg:gap-16 lg:py-24">
    <div class="min-w-0">
      <slot />
    </div>

    <aside class="lg:pt-2">
      <div class="rounded-3xl border border-border bg-secondary p-6 sm:p-7 lg:sticky lg:top-28">
        <p class="eyebrow-label">{detailsEyebrow}</p>
        <div class="mt-5 space-y-5">
          <div class="flex gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-surface text-sage-deep" aria-hidden="true">
              <Icon name="lucide:map-pin" width={17} height={17} />
            </span>
            <div>
              <p class="font-sans text-sm font-semibold text-ink">{locationTitle}</p>
              <p class="mt-1 font-sans text-sm leading-6 text-muted-foreground">{locationBody}</p>
            </div>
          </div>
          <div class="flex gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-surface text-sage-deep" aria-hidden="true">
              <Icon name="lucide:monitor" width={17} height={17} />
            </span>
            <div>
              <p class="font-sans text-sm font-semibold text-ink">Telehealth</p>
              <p class="mt-1 font-sans text-sm leading-6 text-muted-foreground">Available across {site.telehealth.coverageArea}.</p>
            </div>
          </div>
        </div>

        {
          related.length > 0 && (
            <div class="mt-7 border-t border-border pt-6">
              <p class="font-sans text-xs font-semibold uppercase tracking-[0.16em] text-sage-deep">
                {hasOffice ? 'Related Support' : `More support for ${cityName}`}
              </p>
              <ul class="mt-3 space-y-2">
                {related.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="group flex items-center justify-between gap-3 rounded-xl bg-surface px-4 py-3 font-sans text-sm font-medium text-foreground transition-colors hover:text-sage-deep"
                    >
                      <span>{item.title}</span>
                      <span class="text-sage-deep transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </aside>
  </div>
</section>
