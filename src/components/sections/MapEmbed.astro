---
import { site } from '../../data/site';

interface Props {
  class?: string;
  height?: number;
}

const { class: className = '', height = 400 } = Astro.props;
const fullAddress = `${site.address.street}, ${site.address.city}, ${site.address.region} ${site.address.postalCode}`;
const src = `https://www.google.com/maps?q=${encodeURIComponent(fullAddress)}&output=embed`;
const classes = ['overflow-hidden rounded-2xl border border-border shadow-lg', className].filter(Boolean).join(' ');
---

<div class={classes}>
  <iframe
    src={src}
    width="100%"
    height={height}
    style="border:0; display:block;"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    title={`Map showing ${site.name} at ${fullAddress}`}
  />
</div>
