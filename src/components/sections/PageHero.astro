---
import { Image } from 'astro:assets';
import Breadcrumbs from './Breadcrumbs.astro';
import Button from '../ui/Button.astro';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  breadcrumbItems: BreadcrumbItem[];
  ctaLabel?: string;
  ctaHref?: string;
  phoneDisplay?: string;
  phoneHref?: string;
  trustBadges?: string[];
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
}

const {
  eyebrow,
  title,
  description,
  breadcrumbItems,
  ctaLabel,
  ctaHref,
  phoneDisplay,
  phoneHref,
  trustBadges,
  image,
  imageAlt = 'Quiet Southern California landscape supporting the therapy page',
  imagePosition = 'center',
} = Astro.props;
---

<section class="relative overflow-hidden bg-lavender-soft">
  <div class="pointer-events-none absolute -left-32 bottom-[-14rem] h-[30rem] w-[30rem] rounded-full bg-sage/10 blur-3xl" aria-hidden="true" />
  <div class="pointer-events-none absolute -right-24 top-[-10rem] h-[32rem] w-[32rem] rounded-full bg-surface/60 blur-3xl" aria-hidden="true" />

  <div class="relative mx-auto max-w-6xl px-6">
    <Breadcrumbs items={breadcrumbItems} variant="muted" />

    <div class:list={[
      'grid items-center gap-10 pb-14 pt-5 sm:pb-16 lg:min-h-[31rem] lg:gap-16 lg:pb-16 lg:pt-8',
      image ? 'lg:grid-cols-[1.02fr_0.98fr]' : 'mx-auto max-w-3xl text-center',
    ]}>
      <div class:list={[image ? 'text-center lg:text-left' : 'text-center']}>
        {
          eyebrow && (
            <span class="inline-flex items-center gap-2 rounded-full border border-surface/90 bg-surface/75 px-4 py-1.5 font-sans text-xs font-semibold uppercase tracking-widest text-foreground shadow-sm backdrop-blur-md">
              <span class="h-1.5 w-1.5 rounded-full bg-sage-deep" aria-hidden="true" />
              {eyebrow}
            </span>
          )
        }

        <h1 class="mt-5 font-serif text-4xl leading-[1.08] tracking-tight text-ink sm:text-5xl lg:text-[3.5rem]">{title}</h1>
        {description && <p class:list={['mt-5 max-w-2xl font-sans text-lg leading-8 text-foreground', !image && 'mx-auto']}>{description}</p>}

        {
          (ctaHref || phoneHref) && (
            <div class:list={['mt-8 flex flex-wrap gap-3', image ? 'justify-center lg:justify-start' : 'justify-center']}>
              {ctaHref && ctaLabel && (
                <Button href={ctaHref} class="shadow-lg shadow-sage-deep/20 hover:shadow-xl hover:shadow-sage-deep/30">
                  {ctaLabel}
                </Button>
              )}
              {phoneHref && phoneDisplay && (
                <Button href={phoneHref} variant="secondary" class="border-border bg-surface/75 text-ink backdrop-blur-md hover:bg-surface">
                  Call {phoneDisplay}
                </Button>
              )}
            </div>
          )
        }

        {
          trustBadges && trustBadges.length > 0 && (
            <ul class:list={['mt-6 flex flex-wrap gap-2', image ? 'justify-center lg:justify-start' : 'justify-center']}>
              {trustBadges.map((badge) => (
                <li class="rounded-full border border-border bg-surface/70 px-4 py-1.5 font-sans text-xs font-semibold uppercase tracking-wide text-foreground">
                  {badge}
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        image && (
          <figure class="relative mx-auto w-full max-w-xl overflow-hidden rounded-[2rem] border border-surface/70 bg-secondary shadow-[0_30px_75px_-48px_rgba(42,40,51,0.6)] lg:max-w-none">
            <Image
              src={image}
              alt={imageAlt}
              widths={[480, 720, 960, 1200]}
              sizes="(min-width: 1024px) 48vw, calc(100vw - 3rem)"
              class="aspect-[4/3] w-full object-cover"
              style={`object-position: ${imagePosition};`}
              priority
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-primary/15 via-transparent to-surface/5" aria-hidden="true" />
          </figure>
        )
      }
    </div>
  </div>
</section>
