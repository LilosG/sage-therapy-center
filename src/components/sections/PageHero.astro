---
import { Image } from 'astro:assets';
import Breadcrumbs from './Breadcrumbs.astro';
import Button from '../ui/Button.astro';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  breadcrumbItems: BreadcrumbItem[];
  ctaLabel?: string;
  ctaHref?: string;
  phoneDisplay?: string;
  phoneHref?: string;
  trustBadges?: string[];
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
}

const {
  eyebrow,
  title,
  description,
  breadcrumbItems,
  ctaLabel,
  ctaHref,
  phoneDisplay,
  phoneHref,
  trustBadges,
  image,
  imagePosition = 'center',
} = Astro.props;
---

<section class="relative isolate overflow-hidden bg-primary">
  {
    image ? (
      <Image
        src={image}
        alt=""
        widths={[768, 1200, 1600]}
        sizes="100vw"
        class="absolute inset-0 h-full w-full object-cover"
        style={`object-position: ${imagePosition};`}
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <div class="absolute inset-0 bg-gradient-to-br from-lavender via-primary to-sage-deep" aria-hidden="true" />
    )
  }

  <div class="absolute inset-0 bg-gradient-to-r from-primary/82 via-primary/50 to-primary/8" aria-hidden="true" />
  <div class="absolute inset-0 bg-gradient-to-t from-primary/25 via-transparent to-primary/8" aria-hidden="true" />

  <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbItems} variant="light" contained={false} />

    <div class="flex items-center pb-14 pt-4 sm:pb-16 lg:min-h-[34rem] lg:pb-16 lg:pt-6">
      <div class="max-w-xl">
        {
          eyebrow && (
            <span class="inline-flex items-center gap-2 rounded-full border border-surface/70 bg-surface/90 px-4 py-1.5 font-sans text-xs font-semibold uppercase tracking-label text-sage-deep shadow-sm backdrop-blur-sm">
              <span class="h-1.5 w-1.5 rounded-full bg-sage-deep" aria-hidden="true" />
              {eyebrow}
            </span>
          )
        }

        <h1 class="mt-5 font-serif text-4xl leading-tight tracking-tight text-surface drop-shadow-[0_2px_12px_rgba(42,40,51,0.18)] sm:text-5xl lg:text-[3.25rem]">
          {title}
        </h1>

        {description && (
          <p class="mt-5 max-w-lg font-sans text-base leading-7 text-surface/90 sm:text-lg">
            {description}
          </p>
        )}

        {
          (ctaHref || phoneHref) && (
            <div class="mt-8 flex flex-wrap gap-3">
              {ctaHref && ctaLabel && (
                <Button href={ctaHref} class="shadow-lg shadow-sage-deep/20 hover:shadow-xl hover:shadow-sage-deep/30">
                  {ctaLabel}
                </Button>
              )}
              {phoneHref && phoneDisplay && (
                <Button
                  href={phoneHref}
                  variant="secondary"
                  class="border-surface/80 bg-primary/25 text-surface backdrop-blur-sm hover:bg-surface/10"
                >
                  Call {phoneDisplay}
                </Button>
              )}
            </div>
          )
        }

        {
          trustBadges && trustBadges.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-2">
              {trustBadges.map((badge) => (
                <li class="rounded-full border border-surface/40 bg-surface/15 px-4 py-1.5 font-sans text-xs font-semibold uppercase tracking-wide text-surface/85">
                  {badge}
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </div>
</section>
