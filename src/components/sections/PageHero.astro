---
// Interior-page hero. Light sage/lavender tint (not the dark-scrim
// gradient this used to run) with dark ink text, per the interior design
// system overhaul — matches the approved sage/lavender/warm-white/slate
// palette without introducing a new dark background. Integrates
// breadcrumbs into the tinted band rather than leaving them as a
// separate plain element above the heading.
import Breadcrumbs from './Breadcrumbs.astro';
import Button from '../ui/Button.astro';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  breadcrumbItems: BreadcrumbItem[];
  ctaLabel?: string;
  ctaHref?: string;
  phoneDisplay?: string;
  phoneHref?: string;
  // Short practice facts (e.g. "LMFT", "Telehealth statewide") shown as
  // small pills beneath the CTAs. Optional — most combo pages skip these
  // in favor of the shell's own TrustStrip immediately below.
  trustBadges?: string[];
}

const { eyebrow, title, description, breadcrumbItems, ctaLabel, ctaHref, phoneDisplay, phoneHref, trustBadges } =
  Astro.props;
---

<section class="relative overflow-hidden bg-lavender-soft">
  <!-- Radial light accent for visual depth, built from existing theme
       tokens only — a soft white highlight off-center behind the
       heading. -->
  <div
    class="pointer-events-none absolute -top-24 right-[-10%] h-[28rem] w-[28rem] rounded-full bg-surface/60 blur-3xl"
    aria-hidden="true"
  />
  <div class="relative">
    <Breadcrumbs items={breadcrumbItems} variant="muted" />
    <div class="mx-auto max-w-3xl px-6 pb-16 pt-2 text-center sm:pb-24">
      {
        eyebrow && (
          <span class="inline-flex items-center gap-2 rounded-full border border-surface/80 bg-surface/70 px-4 py-1.5 font-sans text-xs font-semibold uppercase tracking-widest text-foreground backdrop-blur-md">
            <span class="h-1.5 w-1.5 rounded-full bg-sage-deep" aria-hidden="true" />
            {eyebrow}
          </span>
        )
      }
      <h1 class="mt-5 font-serif text-4xl leading-tight tracking-tight text-ink lg:text-5xl">{title}</h1>
      {description && <p class="mx-auto mt-4 max-w-2xl font-sans text-lg text-foreground">{description}</p>}
      {
        (ctaHref || phoneHref) && (
          <div class="mt-8 flex flex-wrap justify-center gap-4">
            {ctaHref && ctaLabel && (
              <Button href={ctaHref} class="shadow-lg shadow-sage-deep/30 hover:shadow-xl hover:shadow-sage-deep/40">
                {ctaLabel}
              </Button>
            )}
            {phoneHref && phoneDisplay && (
              <Button
                href={phoneHref}
                variant="secondary"
                class="border-border bg-surface/70 text-ink backdrop-blur-md hover:bg-surface"
              >
                Call {phoneDisplay}
              </Button>
            )}
          </div>
        )
      }
      {
        trustBadges && trustBadges.length > 0 && (
          <ul class="mt-6 flex flex-wrap justify-center gap-2">
            {trustBadges.map((badge) => (
              <li class="rounded-full border border-border bg-surface/70 px-4 py-1.5 font-sans text-xs font-semibold uppercase tracking-wide text-foreground">
                {badge}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>
