---
import { getImage } from 'astro:assets';
import Breadcrumbs from './Breadcrumbs.astro';
import Button from '../ui/Button.astro';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  breadcrumbItems: BreadcrumbItem[];
  ctaLabel?: string;
  ctaHref?: string;
  phoneDisplay?: string;
  phoneHref?: string;
  trustBadges?: string[];
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
}

const {
  eyebrow,
  title,
  description,
  breadcrumbItems,
  ctaLabel,
  ctaHref,
  phoneDisplay,
  phoneHref,
  trustBadges,
  image,
  imagePosition = 'center',
} = Astro.props;

const optimizedBg = image
  ? await getImage({ src: image, format: 'webp', width: 1600, quality: 80 })
  : null;
---

<section
  class:list={[
    'relative overflow-hidden bg-primary',
    !image && 'bg-gradient-to-br from-primary via-primary to-sage-deep',
  ]}
  style={optimizedBg ? `background-image: url('${optimizedBg.src}'); background-size: cover; background-position: ${imagePosition};` : undefined}
>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-primary/88 via-primary/65 to-primary/20" aria-hidden="true" />

  <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbItems} variant="light" contained={false} />

    <div class="flex items-center pb-14 pt-4 sm:pb-16 lg:min-h-[34rem] lg:pb-16 lg:pt-6">
      <div class="max-w-2xl">
        {
          eyebrow && (
            <span class="inline-flex items-center gap-2 rounded-full border border-primary-foreground/20 bg-primary-foreground/10 px-4 py-1.5 font-sans text-xs font-semibold uppercase tracking-label text-primary-foreground/80 backdrop-blur-sm">
              <span class="h-1.5 w-1.5 rounded-full bg-sage" aria-hidden="true" />
              {eyebrow}
            </span>
          )
        }

        <h1 class="mt-5 font-serif text-4xl leading-tight tracking-tight text-primary-foreground sm:text-5xl lg:text-[3.25rem]">
          {title}
        </h1>

        {description && (
          <p class="mt-5 max-w-xl font-sans text-lg leading-8 text-primary-foreground/75">
            {description}
          </p>
        )}

        {
          (ctaHref || phoneHref) && (
            <div class="mt-8 flex flex-wrap gap-3">
              {ctaHref && ctaLabel && (
                <Button href={ctaHref} class="shadow-lg shadow-sage-deep/20 hover:shadow-xl hover:shadow-sage-deep/30">
                  {ctaLabel}
                </Button>
              )}
              {phoneHref && phoneDisplay && (
                <Button
                  href={phoneHref}
                  variant="secondary"
                  class="border-primary-foreground/20 bg-primary-foreground/10 text-primary-foreground backdrop-blur-sm hover:bg-primary-foreground/20"
                >
                  Call {phoneDisplay}
                </Button>
              )}
            </div>
          )
        }

        {
          trustBadges && trustBadges.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-2">
              {trustBadges.map((badge) => (
                <li class="rounded-full border border-primary-foreground/20 bg-primary-foreground/10 px-4 py-1.5 font-sans text-xs font-semibold uppercase tracking-wide text-primary-foreground/80">
                  {badge}
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </div>
</section>
