---
import { Icon } from 'astro-icon/components';
import Button from '../ui/Button.astro';
import { telehealthOption } from '../../data/sessionOptions';
---

<section class="bg-background">
  <div class="mx-auto max-w-6xl px-6 py-12 sm:py-14 lg:py-16">
    <div class="relative isolate overflow-hidden rounded-[2rem] bg-primary px-7 py-8 text-primary-foreground shadow-[0_30px_70px_-50px_rgba(42,40,51,0.75)] sm:px-9 sm:py-10 lg:grid lg:grid-cols-[0.82fr_1.18fr] lg:items-center lg:gap-14 lg:px-12 lg:py-11">
      <div class="pointer-events-none absolute -right-16 -top-20 h-72 w-72 rounded-full border border-sage/20" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-32 left-1/3 h-72 w-72 rounded-full bg-lavender/10 blur-3xl" aria-hidden="true"></div>

      <div class="relative">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-sage text-primary">
          <Icon name="lucide:monitor" width={22} height={22} aria-hidden="true" />
        </div>
        <p class="mt-5 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-sage">{telehealthOption.eyebrow}</p>
        <h2 class="mt-3 font-serif text-3xl leading-tight sm:text-4xl">Online therapy across California</h2>
      </div>

      <div class="relative mt-7 border-t border-primary-foreground/15 pt-7 lg:mt-0 lg:border-l lg:border-t-0 lg:pl-12 lg:pt-0">
        <p class="max-w-2xl font-sans text-base leading-8 text-primary-foreground/80">
          {telehealthOption.description} Individual, couples, family, teen, EMDR, anxiety, trauma-focused, and other therapy options can be discussed as telehealth services for clients located in California.
        </p>

        <div class="mt-6 flex flex-wrap gap-2">
          <span class="rounded-full border border-primary-foreground/15 bg-primary-foreground/8 px-4 py-2 font-sans text-xs font-semibold text-primary-foreground/90">{telehealthOption.coverageLabel}</span>
          <span class="rounded-full border border-primary-foreground/15 bg-primary-foreground/8 px-4 py-2 font-sans text-xs font-semibold text-primary-foreground/90">Same therapist, flexible format</span>
        </div>

        <Button
          href={telehealthOption.href}
          variant="secondary"
          class="mt-7 border-primary-foreground/20 bg-primary-foreground/10 text-primary-foreground hover:bg-primary-foreground/15"
        >
          Explore Telehealth Therapy
        </Button>
      </div>
    </div>
  </div>
</section>
