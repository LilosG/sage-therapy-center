---
// Wraps page body markdown (service/city/city-service `<Content />`) in
// richer prose styling than a bare `.prose` block: serif H2s with an
// accent underline, sage checkmarks on bullet lists, and blockquotes
// rendered as "key takeaway" callout boxes. Content authoring doesn't
// have a distinct callout markdown convention beyond blockquote syntax
// (`>`), so a `>` paragraph is what authors use to trigger this
// treatment.
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const classes = [
  'prose prose-lg max-w-none font-sans text-foreground',
  'prose-headings:font-serif prose-headings:text-ink',
  'prose-h2:mb-4 prose-h2:mt-8 prose-h2:border-b prose-h2:border-sage/20 prose-h2:pb-2 prose-h2:text-2xl lg:prose-h2:text-3xl',
  'prose-h3:mt-8 prose-h3:text-xl',
  'prose-p:leading-relaxed',
  'prose-a:text-sage-deep prose-a:font-medium prose-a:no-underline hover:prose-a:underline',
  'prose-strong:text-ink',
  'prose-ul:my-6 prose-ul:space-y-2 prose-ul:pl-0 prose-li:list-none prose-li:pl-8 prose-li:relative',
  "prose-li:before:absolute prose-li:before:left-0 prose-li:before:top-0.5 prose-li:before:content-['✓'] prose-li:before:text-sage-deep prose-li:before:font-semibold",
  'prose-blockquote:not-italic prose-blockquote:border-l-4 prose-blockquote:border-sage prose-blockquote:bg-background prose-blockquote:text-foreground prose-blockquote:rounded-r-2xl prose-blockquote:px-6 prose-blockquote:py-6 prose-blockquote:my-6 prose-blockquote:shadow-sm prose-blockquote:font-sans prose-blockquote:text-base',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<div class={classes}>
  <slot />
</div>
