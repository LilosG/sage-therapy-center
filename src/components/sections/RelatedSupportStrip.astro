---
interface RelatedLink {
  title: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  links: RelatedLink[];
}

const {
  eyebrow = 'Related Support',
  heading = 'Other ways S.A.G.E. may be able to help',
  links,
} = Astro.props;
---

<section class="border-y border-border bg-secondary">
  <div class="mx-auto grid max-w-6xl gap-7 px-6 py-10 sm:py-12 lg:grid-cols-[0.72fr_1.28fr] lg:items-center lg:gap-14">
    <div>
      <p class="eyebrow-label">{eyebrow}</p>
      <h2 class="mt-3 max-w-lg font-serif text-2xl leading-tight text-ink sm:text-3xl">{heading}</h2>
    </div>

    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="group flex min-h-14 items-center justify-between gap-4 rounded-2xl border border-border bg-surface px-5 py-4 font-sans text-sm font-semibold text-foreground transition hover:border-sage/60 hover:text-sage-deep"
          >
            <span>{link.title}</span>
            <span class="text-sage-deep transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
