---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { site } from '../../data/site';
import { sortCoreServices } from '../../data/serviceOrder';
import { ABOUT_URL, BLOG_URL, CONTACT_URL, FAQ_URL, SCHEDULE_URL, SERVICES_URL, TELEHEALTH_URL } from '../../data/nav';
import { cityUrl, serviceUrl } from '../../lib/routes';

const cities = (await getCollection('cities')).sort((a, b) =>
  a.data.name === 'Carlsbad' ? -1 : b.data.name === 'Carlsbad' ? 1 : a.data.name.localeCompare(b.data.name)
);
const coreServices = sortCoreServices((await getCollection('services')).filter((s) => s.data.category === 'core'));
---

<footer class="border-t border-border bg-secondary">
  <div class="mx-auto max-w-6xl px-6 pb-8 pt-14 sm:pt-16">
    <div class="grid gap-10 border-b border-border pb-12 lg:grid-cols-[1.35fr_0.75fr_0.9fr_0.72fr] lg:gap-12">
      <div class="max-w-sm">
        <p class="font-serif text-2xl leading-tight text-primary">{site.name}</p>
        <p class="mt-3 font-sans text-sm leading-6 text-muted-foreground">
          Individualized therapy with {site.practitioner.name}, {site.practitioner.credential}, based in Carlsbad with telehealth available across {site.telehealth.coverageArea}.
        </p>

        <div class="mt-6 space-y-4 border-t border-border pt-5">
          <div class="flex gap-3">
            <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-surface text-sage-deep" aria-hidden="true">
              <Icon name="lucide:map-pin" width={15} height={15} />
            </span>
            <address class="not-italic font-sans text-sm leading-6 text-foreground">
              {site.address.street}<br />
              {site.address.city}, {site.address.region} {site.address.postalCode}
            </address>
          </div>
          <div class="flex gap-3">
            <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-surface text-sage-deep" aria-hidden="true">
              <Icon name="lucide:phone" width={15} height={15} />
            </span>
            <div class="font-sans text-sm leading-6">
              <a href={`tel:${site.phone.tel}`} class="font-semibold text-primary hover:text-sage-deep">{site.phone.display}</a><br />
              <a href={`mailto:${site.email}`} class="break-all text-muted-foreground hover:text-sage-deep">{site.email}</a>
            </div>
          </div>
        </div>

        <div class="mt-5 flex items-center gap-3 pt-1">
          <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex h-8 w-8 items-center justify-center rounded-full bg-surface text-muted-foreground transition-colors hover:text-sage-deep">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
          <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="flex h-8 w-8 items-center justify-center rounded-full bg-surface text-muted-foreground transition-colors hover:text-sage-deep">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="flex h-8 w-8 items-center justify-center rounded-full bg-surface text-muted-foreground transition-colors hover:text-sage-deep">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
        </div>
      </div>

      <div>
        <p class="font-sans text-xs font-semibold uppercase tracking-label text-sage-deep">Practice</p>
        <ul class="mt-4 space-y-3">
          <li><a href={ABOUT_URL} class="font-sans text-sm text-foreground hover:text-sage-deep">About Kristin</a></li>
          <li><a href={FAQ_URL} class="font-sans text-sm text-foreground hover:text-sage-deep">FAQ</a></li>
          <li><a href={CONTACT_URL} class="font-sans text-sm text-foreground hover:text-sage-deep">Contact</a></li>
          <li><a href={BLOG_URL} class="font-sans text-sm text-foreground hover:text-sage-deep">Blog</a></li>
          <li><a href={SCHEDULE_URL} class="font-sans text-sm font-semibold text-sage-deep hover:text-primary">Schedule a Session</a></li>
        </ul>
      </div>

      <div>
        <p class="font-sans text-xs font-semibold uppercase tracking-label text-sage-deep">Therapy Services</p>
        <ul class="mt-4 space-y-3">
          <li>
            <a href={TELEHEALTH_URL} class="inline-flex items-center gap-2 font-sans text-sm font-semibold text-sage-deep hover:text-primary">
              <Icon name="lucide:monitor" width={15} height={15} aria-hidden="true" />
              Telehealth Therapy
            </a>
          </li>
          {coreServices.slice(0, 6).map((s) => (
            <li>
              <a href={serviceUrl(s.data.slug)} class="font-sans text-sm text-foreground hover:text-sage-deep">{s.data.title}</a>
            </li>
          ))}
          <li><a href={SERVICES_URL} class="font-sans text-sm font-semibold text-sage-deep hover:text-primary">View all services →</a></li>
        </ul>
      </div>

      <div>
        <p class="font-sans text-xs font-semibold uppercase tracking-label text-sage-deep">Areas We Serve</p>
        <ul class="mt-4 space-y-3">
          {cities.slice(0, 8).map((c) => (
            <li>
              <a href={cityUrl(c.data.slug)} class="font-sans text-sm text-foreground hover:text-sage-deep">{c.data.name}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-2 pt-7 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between">
      <p class="font-sans text-xs text-muted-foreground">
        {site.practitioner.name}, {site.practitioner.credential} · CA License {site.practitioner.licenseNumber}
      </p>
      <p class="font-sans text-xs text-muted-foreground">
        © {new Date().getFullYear()} {site.name}. All rights reserved.
      </p>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <a href="/privacy-policy/" class="font-sans text-xs text-muted-foreground hover:text-foreground">Privacy Policy</a>
        <a href="/terms-of-service/" class="font-sans text-xs text-muted-foreground hover:text-foreground">Terms of Service</a>
        <a href="https://lilosgrowth.com" target="_blank" rel="noopener noreferrer" class="font-sans text-xs text-muted-foreground hover:text-foreground">Website by Lilos Growth</a>
      </div>
    </div>

    <div class="mt-5 flex flex-col gap-3 border-t border-border pt-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-sans text-xs text-muted-foreground">
        {site.practitioner.name}, {site.practitioner.credential} · CA License {site.practitioner.licenseNumber}
      </p>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <a href="/privacy-policy/" class="font-sans text-xs text-muted-foreground hover:text-foreground">Privacy Policy</a>
        <a href="/terms-of-service/" class="font-sans text-xs text-muted-foreground hover:text-foreground">Terms of Service</a>
        <a href="https://lilosgrowth.com" target="_blank" rel="noopener noreferrer" class="font-sans text-xs text-muted-foreground hover:text-foreground">Website by Lilos Growth</a>
      </div>
    </div>
  </div>
</footer>
