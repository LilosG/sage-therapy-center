---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { site } from '../../data/site';
import { ABOUT_URL, CONTACT_URL, FAQ_URL, SCHEDULE_URL, SERVICES_URL, TELEHEALTH_URL } from '../../data/nav';
import { cityUrl, serviceUrl } from '../../lib/routes';

const cities = await getCollection('cities');
const coreServices = (await getCollection('services')).filter((s) => s.data.category === 'core');
---

<footer class="border-t border-border bg-secondary">
  <div class="mx-auto max-w-6xl px-6 pb-8 pt-14 sm:pt-16">
    <div class="grid gap-10 border-b border-border pb-12 lg:grid-cols-[1.35fr_0.75fr_0.9fr_0.72fr] lg:gap-12">
      <div class="max-w-sm">
        <p class="font-serif text-2xl leading-tight text-primary">{site.name}</p>
        <p class="mt-3 font-sans text-sm leading-6 text-muted-foreground">
          Individualized therapy with {site.practitioner.name}, {site.practitioner.credential}, based in Carlsbad with telehealth available across {site.telehealth.coverageArea}.
        </p>

        <div class="mt-6 space-y-4 border-t border-border pt-5">
          <div class="flex gap-3">
            <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-surface text-sage-deep" aria-hidden="true">
              <Icon name="lucide:map-pin" width={15} height={15} />
            </span>
            <address class="not-italic font-sans text-sm leading-6 text-foreground">
              {site.address.street}<br />
              {site.address.city}, {site.address.region} {site.address.postalCode}
            </address>
          </div>
          <div class="flex gap-3">
            <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-surface text-sage-deep" aria-hidden="true">
              <Icon name="lucide:phone" width={15} height={15} />
            </span>
            <div class="font-sans text-sm leading-6">
              <a href={`tel:${site.phone.tel}`} class="font-semibold text-primary hover:text-sage-deep">{site.phone.display}</a><br />
              <a href={`mailto:${site.email}`} class="break-all text-muted-foreground hover:text-sage-deep">{site.email}</a>
            </div>
          </div>
        </div>
      </div>

      <div>
        <p class="font-sans text-xs font-semibold uppercase tracking-[0.16em] text-sage-deep">Practice</p>
        <ul class="mt-4 space-y-3">
          <li><a href={ABOUT_URL} class="font-sans text-sm text-foreground hover:text-sage-deep">About Kristin</a></li>
          <li><a href={FAQ_URL} class="font-sans text-sm text-foreground hover:text-sage-deep">FAQ</a></li>
          <li><a href={CONTACT_URL} class="font-sans text-sm text-foreground hover:text-sage-deep">Contact</a></li>
          <li><a href={SCHEDULE_URL} class="font-sans text-sm font-semibold text-sage-deep hover:text-primary">Schedule a Session</a></li>
        </ul>
      </div>

      <div>
        <p class="font-sans text-xs font-semibold uppercase tracking-[0.16em] text-sage-deep">Therapy Services</p>
        <ul class="mt-4 space-y-3">
          <li>
            <a href={TELEHEALTH_URL} class="inline-flex items-center gap-2 font-sans text-sm font-semibold text-sage-deep hover:text-primary">
              <Icon name="lucide:monitor" width={15} height={15} aria-hidden="true" />
              Telehealth Therapy
            </a>
          </li>
          {coreServices.slice(0, 6).map((s) => (
            <li>
              <a href={serviceUrl(s.data.slug)} class="font-sans text-sm text-foreground hover:text-sage-deep">{s.data.title}</a>
            </li>
          ))}
          <li><a href={SERVICES_URL} class="font-sans text-sm font-semibold text-sage-deep hover:text-primary">View all services →</a></li>
        </ul>
      </div>

      <div>
        <p class="font-sans text-xs font-semibold uppercase tracking-[0.16em] text-sage-deep">Areas We Serve</p>
        <ul class="mt-4 space-y-3">
          {cities.slice(0, 8).map((c) => (
            <li>
              <a href={cityUrl(c.data.slug)} class="font-sans text-sm text-foreground hover:text-sage-deep">{c.data.name}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-5 pt-7 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-sans text-xs leading-5 text-muted-foreground">
        © {new Date().getFullYear()} {site.name}. All rights reserved.
      </p>
      <div class="flex items-center gap-5">
        <a href={site.social.facebook} class="font-sans text-xs font-semibold text-primary hover:text-sage-deep">Facebook</a>
        <a href={site.social.instagram} class="font-sans text-xs font-semibold text-primary hover:text-sage-deep">Instagram</a>
      </div>
    </div>
  </div>
</footer>
