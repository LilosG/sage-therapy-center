---
import { Icon } from 'astro-icon/components';
import { site } from '../../data/site';
import { headerNav, AREAS_WE_SERVE_URL, HOME_URL, SCHEDULE_URL } from '../../data/nav';
import Button from '../ui/Button.astro';

const currentPath = Astro.url.pathname;
const hasCityRouteContext = typeof Astro.params.city === 'string';

function isNavActive(href: string) {
  if (href === HOME_URL) return currentPath === HOME_URL;
  if (href === AREAS_WE_SERVE_URL && hasCityRouteContext) return true;
  return currentPath === href || currentPath.startsWith(href);
}

function isCurrentPage(href: string) {
  return currentPath === href;
}
---

<header class="sticky top-0 z-40 border-b border-border/80 bg-surface/95 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-3.5 lg:px-8">
    <a href={HOME_URL} class="shrink-0 font-serif text-xl font-medium tracking-tight text-primary" aria-label={`${site.name} home`}>
      {site.name}
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-6 lg:flex">
      {
        headerNav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'font-sans text-sm transition-colors',
              isNavActive(item.href) ? 'font-medium text-sage-deep' : 'text-foreground hover:text-sage-deep',
            ]}
            aria-current={isCurrentPage(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <a href={`tel:${site.phone.tel}`} class="font-sans text-sm font-medium text-primary hover:text-sage-deep">
        {site.phone.display}
      </a>
      <Button href={SCHEDULE_URL}>Schedule a Session</Button>
    </div>

    <details class="group relative lg:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-border text-primary transition hover:border-sage/60 hover:text-sage-deep marker:content-none"
        aria-label="Open menu"
      >
        <Icon name="lucide:menu" width={19} height={19} class="group-open:hidden" aria-hidden="true" />
        <Icon name="lucide:x" width={19} height={19} class="hidden group-open:block" aria-hidden="true" />
      </summary>
      <div class="absolute right-0 z-20 mt-3 w-[min(20rem,calc(100vw-3rem))] overflow-hidden rounded-3xl border border-border bg-surface shadow-[0_24px_70px_-35px_rgba(42,40,51,0.55)]">
        <nav aria-label="Mobile primary" class="p-3">
          <ul class="divide-y divide-border/70">
            {
              headerNav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      'flex min-h-12 items-center justify-between rounded-xl px-3 font-sans text-sm transition hover:bg-lavender-soft/50',
                      isNavActive(item.href) ? 'font-semibold text-sage-deep' : 'text-foreground',
                    ]}
                    aria-current={isCurrentPage(item.href) ? 'page' : undefined}
                  >
                    <span>{item.label}</span>
                    <span class="text-sage-deep" aria-hidden="true">→</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="border-t border-border bg-secondary/60 p-4">
          <Button href={SCHEDULE_URL} class="w-full">Schedule a Session</Button>
          <a href={`tel:${site.phone.tel}`} class="mt-3 flex items-center justify-center gap-2 font-sans text-sm font-semibold text-primary">
            <Icon name="lucide:phone" width={15} height={15} aria-hidden="true" />
            {site.phone.display}
          </a>
        </div>
      </div>
    </details>
  </div>
</header>
