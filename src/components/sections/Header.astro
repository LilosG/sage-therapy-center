---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { site } from '../../data/site';
import { sortCoreServices } from '../../data/serviceOrder';
import {
  headerNav,
  HOME_URL,
  SERVICES_URL,
  TELEHEALTH_URL,
  AREAS_WE_SERVE_URL,
  SCHEDULE_URL,
} from '../../data/nav';
import { telehealthOption } from '../../data/sessionOptions';
import { cityUrl, serviceUrl } from '../../lib/routes';
import Button from '../ui/Button.astro';

const currentPath = Astro.url.pathname;
const services = await getCollection('services');
const cities = await getCollection('cities');

const cityOrder = ['carlsbad', 'encinitas', 'oceanside', 'san-marcos', 'vista', 'del-mar', 'solana-beach', 'rancho-santa-fe'];

const coreServices = sortCoreServices(services.filter((service) => service.data.category === 'core'));
const orderedCities = [...cities].sort((a, b) => cityOrder.indexOf(a.data.slug) - cityOrder.indexOf(b.data.slug));
const officeCity = orderedCities.find((city) => city.data.hasOffice);
const serviceAreaCities = orderedCities.filter((city) => !city.data.hasOffice);

const isServicesActive = currentPath.startsWith('/services/') || currentPath === TELEHEALTH_URL;
const isAreasActive = orderedCities.some((city) => currentPath.startsWith(cityUrl(city.data.slug)));
const simpleNavItems = headerNav.filter((item) => item.href !== HOME_URL);
---

<header class="sticky top-0 z-40 border-b border-border/80 bg-surface/95 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-3.5 lg:px-8">
    <a href={HOME_URL} class="shrink-0 font-serif text-xl font-medium tracking-tight text-primary" aria-label={`${site.name} home`}>
      {site.name}
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-6 lg:flex">
      <a
        href={HOME_URL}
        class:list={[
          'font-sans text-sm transition-colors',
          currentPath === HOME_URL ? 'font-medium text-sage-deep' : 'text-foreground hover:text-sage-deep',
        ]}
        aria-current={currentPath === HOME_URL ? 'page' : undefined}
      >
        Home
      </a>

      <div class="group relative">
        <a
          href={SERVICES_URL}
          class:list={[
            'inline-flex items-center gap-1.5 py-2 font-sans text-sm transition-colors',
            isServicesActive ? 'font-medium text-sage-deep' : 'text-foreground hover:text-sage-deep',
          ]}
          aria-current={currentPath === SERVICES_URL ? 'page' : undefined}
        >
          Services
          <Icon name="lucide:chevron-down" width={14} height={14} class="transition-transform duration-200 group-hover:rotate-180" aria-hidden="true" />
        </a>

        <div class="invisible absolute left-1/2 top-full z-50 w-[43rem] -translate-x-1/2 translate-y-2 pt-3 opacity-0 transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
          <div class="overflow-hidden rounded-3xl border border-border bg-surface shadow-ink-lg">
            <div class="grid gap-0 lg:grid-cols-[0.82fr_1.18fr]">
              <a href={telehealthOption.href} class="group/telehealth bg-primary p-6 text-primary-foreground transition-colors hover:bg-sage-deep">
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-sage text-primary" aria-hidden="true">
                  <Icon name="lucide:monitor" width={19} height={19} />
                </span>
                <p class="mt-5 font-sans text-[0.68rem] font-semibold uppercase tracking-label-inverted text-sage">Featured session option</p>
                <p class="mt-2 font-serif text-2xl leading-tight">{telehealthOption.title}</p>
                <p class="mt-3 font-sans text-sm leading-6 text-primary-foreground/70">{telehealthOption.navDescription}</p>
                <span class="mt-5 inline-flex items-center gap-2 font-sans text-sm font-semibold text-primary-foreground">
                  Explore telehealth <span class="transition-transform group-hover/telehealth:translate-x-1" aria-hidden="true">→</span>
                </span>
              </a>

              <div class="p-6">
                <div class="flex items-center justify-between gap-4">
                  <p class="font-sans text-xs font-semibold uppercase tracking-label text-sage-deep">Therapy services</p>
                  <a href={SERVICES_URL} class="font-sans text-xs font-semibold text-muted-foreground hover:text-sage-deep">View all →</a>
                </div>
                <ul class="mt-4 grid grid-cols-2 gap-x-5 gap-y-1">
                  {coreServices.map((service) => (
                    <li>
                      <a
                        href={serviceUrl(service.data.slug)}
                        class="block rounded-xl px-3 py-2.5 font-sans text-sm leading-snug text-foreground transition hover:bg-lavender-soft/55 hover:text-sage-deep"
                      >
                        {service.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="group relative">
        <a
          href={AREAS_WE_SERVE_URL}
          class:list={[
            'inline-flex items-center gap-1.5 py-2 font-sans text-sm transition-colors',
            isAreasActive || currentPath === AREAS_WE_SERVE_URL
              ? 'font-medium text-sage-deep'
              : 'text-foreground hover:text-sage-deep',
          ]}
          aria-current={currentPath === AREAS_WE_SERVE_URL ? 'page' : undefined}
        >
          Areas We Serve
          <Icon name="lucide:chevron-down" width={14} height={14} class="transition-transform duration-200 group-hover:rotate-180" aria-hidden="true" />
        </a>

        <div class="invisible absolute left-1/2 top-full z-50 w-[38rem] -translate-x-1/2 translate-y-2 pt-3 opacity-0 transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
          <div class="rounded-3xl border border-border bg-surface p-6 shadow-ink-lg">
            <div class="flex items-center justify-between gap-4">
              <p class="font-sans text-xs font-semibold uppercase tracking-label text-sage-deep">North County San Diego</p>
              <a href={AREAS_WE_SERVE_URL} class="font-sans text-xs font-semibold text-muted-foreground hover:text-sage-deep">View all areas →</a>
            </div>

            <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1">
              {orderedCities.map((city) => (
                <li>
                  <a
                    href={cityUrl(city.data.slug)}
                    class="flex items-center justify-between rounded-xl px-3 py-2.5 font-sans text-sm text-foreground transition hover:bg-secondary hover:text-sage-deep"
                  >
                    <span>{city.data.name}</span>
                    <span class="text-muted-foreground" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      {simpleNavItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'font-sans text-sm transition-colors',
            currentPath === item.href ? 'font-medium text-sage-deep' : 'text-foreground hover:text-sage-deep',
          ]}
          aria-current={currentPath === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <a href={`tel:${site.phone.tel}`} class="font-sans text-sm font-medium text-primary hover:text-sage-deep">
        {site.phone.display}
      </a>
      <Button href={SCHEDULE_URL}>Schedule a Session</Button>
    </div>

    <details class="group relative lg:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-border text-primary transition hover:border-sage/60 hover:text-sage-deep marker:content-none"
        aria-label="Open menu"
      >
        <Icon name="lucide:menu" width={19} height={19} class="group-open:hidden" aria-hidden="true" />
        <Icon name="lucide:x" width={19} height={19} class="hidden group-open:block" aria-hidden="true" />
      </summary>
      <div class="absolute right-0 z-20 mt-3 max-h-[calc(100vh-6rem)] w-[min(22rem,calc(100vw-2rem))] overflow-y-auto rounded-3xl border border-border bg-surface shadow-ink-lg">
        <nav aria-label="Mobile primary" class="p-3">
          <a
            href={HOME_URL}
            class:list={[
              'flex min-h-12 items-center justify-between rounded-xl px-3 font-sans text-sm transition hover:bg-lavender-soft/50',
              currentPath === HOME_URL ? 'font-semibold text-sage-deep' : 'text-foreground',
            ]}
          >
            <span>Home</span><span class="text-sage-deep" aria-hidden="true">→</span>
          </a>

          <details class="border-t border-border/70 py-1">
            <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between rounded-xl px-3 font-sans text-sm font-semibold text-foreground hover:bg-lavender-soft/50 marker:content-none">
              <span>Services</span>
              <Icon name="lucide:chevron-down" width={16} height={16} aria-hidden="true" />
            </summary>
            <div class="pb-2 pl-2 pr-1">
              <a href={SERVICES_URL} class="block rounded-xl px-3 py-2.5 font-sans text-sm font-semibold text-sage-deep hover:bg-secondary">All therapy services</a>
              <a href={TELEHEALTH_URL} class="mt-1 flex items-center gap-3 rounded-xl bg-primary px-3 py-3 text-primary-foreground">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-sage text-primary" aria-hidden="true">
                  <Icon name="lucide:monitor" width={16} height={16} />
                </span>
                <span>
                  <span class="block font-sans text-sm font-semibold">Telehealth Therapy</span>
                  <span class="mt-0.5 block font-sans text-xs text-primary-foreground/70">Statewide in California</span>
                </span>
              </a>
              <div class="mt-2 grid grid-cols-1">
                {coreServices.map((service) => (
                  <a href={serviceUrl(service.data.slug)} class="rounded-xl px-3 py-2 font-sans text-sm text-foreground hover:bg-secondary hover:text-sage-deep">
                    {service.data.title}
                  </a>
                ))}
              </div>
            </div>
          </details>

          <details class="border-t border-border/70 py-1">
            <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between rounded-xl px-3 font-sans text-sm font-semibold text-foreground hover:bg-lavender-soft/50 marker:content-none">
              <span>Areas We Serve</span>
              <Icon name="lucide:chevron-down" width={16} height={16} aria-hidden="true" />
            </summary>
            <div class="pb-2 pl-2 pr-1">
              <a href={AREAS_WE_SERVE_URL} class="block rounded-xl px-3 py-2.5 font-sans text-sm font-semibold text-sage-deep hover:bg-secondary">All service areas</a>
              {orderedCities.map((city) => (
                <a
                  href={cityUrl(city.data.slug)}
                  class="mt-0.5 flex items-center justify-between rounded-xl px-3 py-2.5 font-sans text-sm text-foreground hover:bg-secondary hover:text-sage-deep"
                >
                  <span>{city.data.name}</span>
                  <span class="text-muted-foreground" aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          </details>

          {simpleNavItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'flex min-h-12 items-center justify-between border-t border-border/70 rounded-xl px-3 font-sans text-sm transition hover:bg-lavender-soft/50',
                currentPath === item.href ? 'font-semibold text-sage-deep' : 'text-foreground',
              ]}
              aria-current={currentPath === item.href ? 'page' : undefined}
            >
              <span>{item.label}</span>
              <span class="text-sage-deep" aria-hidden="true">→</span>
            </a>
          ))}
        </nav>

        <div class="border-t border-border bg-secondary/60 p-4">
          <Button href={SCHEDULE_URL} class="w-full">Schedule a Session</Button>
          <a href={`tel:${site.phone.tel}`} class="mt-3 flex items-center justify-center gap-2 font-sans text-sm font-semibold text-primary">
            <Icon name="lucide:phone" width={15} height={15} aria-hidden="true" />
            {site.phone.display}
          </a>
        </div>
      </div>
    </details>
  </div>
</header>
