---
interface DecisionItem {
  q: string;
  a: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  items: DecisionItem[];
}

const {
  eyebrow = 'Before You Get Started',
  heading = 'A few practical things to know',
  items,
} = Astro.props;
---

<section class="bg-background">
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20 lg:py-24">
    <div class="grid gap-10 lg:grid-cols-[0.58fr_1.42fr] lg:gap-16">
      <div class="max-w-md">
        <p class="eyebrow-label">{eyebrow}</p>
        <h2 class="mt-4 font-serif text-3xl leading-tight text-ink sm:text-4xl">{heading}</h2>
      </div>

      <dl class="grid gap-x-10 sm:grid-cols-2">
        {
          items.map((item) => (
            <div class="border-t border-border py-6 first:pt-0 sm:first:pt-6">
              <dt class="font-serif text-lg leading-snug text-ink">{item.q}</dt>
              <dd class="mt-3 font-sans text-sm leading-6 text-muted-foreground">{item.a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
