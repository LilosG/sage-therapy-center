---
// Renders filled/outline stars via a raw inline <path> (no astro-icon).
// Lucide's "star" icon hardcodes fill="none" as a presentation attribute
// on the source <path>; astro-icon renders it through a sprite <use>
// reference, and that attribute takes precedence over any CSS fill class
// applied from outside — so a filled rating star isn't achievable through
// that icon set. This path has no fill attribute of its own, so the
// class below controls it directly.
interface Props {
  rating: number;
  size?: number;
  class?: string;
}

const { rating, size = 20, class: className = '' } = Astro.props;
const filled = Math.round(rating);
---

<div class={`flex ${className}`} aria-hidden="true">
  {
    Array.from({ length: 5 }).map((_, i) => (
      <svg
        width={size}
        height={size}
        viewBox="0 0 24 24"
        class={i < filled ? 'fill-sage-deep' : 'fill-none stroke-border stroke-[1.5]'}
      >
        <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.12 2.12 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.12 2.12 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.12 2.12 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.12 2.12 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.12 2.12 0 0 0 1.597-1.16z" />
      </svg>
    ))
  }
</div>
